{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "test-seed-users",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"test",
				"Lms.Application.Tests/Lms.Application.Tests.csproj",
				"--filter",
				"EnsureSeedUsersAsync_BackfillsAdditionalSeededUsers_WhenDatabaseAlreadyHasUsers",
				"--nologo",
				"-v",
				"minimal"
			],
			"isBackground": false
		},
		{
			"label": "test-seed-enrollments",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"test",
				"Lms.Application.Tests/Lms.Application.Tests.csproj",
				"--filter",
				"SeedEnrollmentsAsync_BackfillsMissingLearnerEnrollments_WithoutDuplicatingExistingRows",
				"--nologo",
				"-v",
				"minimal"
			],
			"isBackground": false
		},
		{
			"label": "run-lms-web-src-5001",
			"type": "shell",
			"command": "$conn = Get-NetTCPConnection -LocalPort 5001 -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1; if ($conn) { Stop-Process -Id $conn.OwningProcess -Force }; $env:ASPNETCORE_URLS='http://localhost:5001'; & 'C:\\Program Files\\dotnet\\dotnet.exe' run --project .\\Lms.Web\\Lms.Web.csproj --no-launch-profile",
			"isBackground": true
		},
		{
			"label": "kill-running-lms-web",
			"type": "shell",
			"command": "taskkill /IM Lms.Web.exe /F",
			"isBackground": false
		},
		{
			"label": "test-application-suite",
			"type": "shell",
			"command": "dotnet test .\\Lms.Application.Tests\\Lms.Application.Tests.csproj",
			"isBackground": false
		},
		{
			"label": "test-ui-suite",
