@baseUrl = http://localhost:5000
@antiforgeryToken = REPLACE_FROM_FORM
@challengeId = REPLACE_FROM_EMAIL
@resetToken = REPLACE_FROM_EMAIL

### Load the form and retain its antiforgery cookie.
GET {{baseUrl}}/forgot-password

### Send a link to the synthetic inbox; enable configured real email delivery first.
POST {{baseUrl}}/auth/password/forgot
Content-Type: application/x-www-form-urlencoded

email=a44ba12a-467f-48c6-b1c0-0f286a773867%40sandbox.zazamail.link&__RequestVerificationToken={{antiforgeryToken}}

### Missing antiforgery token must fail.
POST {{baseUrl}}/auth/password/forgot
Content-Type: application/x-www-form-urlencoded

email=nobody%40example.invalid

### Load the emailed link for a fresh antiforgery token; GET does not consume it.
GET {{baseUrl}}/reset-password?id={{challengeId}}&token={{resetToken}}

### Reset, then replay to verify rejection. Retain the antiforgery cookie.
POST {{baseUrl}}/auth/password/reset
Content-Type: application/x-www-form-urlencoded

id={{challengeId}}&token={{resetToken}}&password=abcdefgh&confirmPassword=abcdefgh&__RequestVerificationToken={{antiforgeryToken}}
