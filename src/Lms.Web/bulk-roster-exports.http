@baseUrl = http://localhost:5000
@adminCookie = replace-with-authenticated-admin-cookie

### Rhode Island original unrestricted broker registry records
GET {{baseUrl}}/admin/rhode%20island-bulk/exports/real-estate-brokers.json
Cookie: {{adminCookie}}

### Rhode Island original unrestricted salesperson registry records
GET {{baseUrl}}/admin/rhode%20island-bulk/exports/real-estate-salespersons.json
Cookie: {{adminCookie}}

### Rhode Island original corporation records and published details
GET {{baseUrl}}/admin/rhode%20island-bulk/exports/real-estate-corporations.json
Cookie: {{adminCookie}}

### Rhode Island acquisition manifest
GET {{baseUrl}}/admin/rhode%20island-bulk/exports/manifest.json
Cookie: {{adminCookie}}

