@using Lms.Application.Services
@using Lms.Domain.Entities

<section class="card" id="admin-assessment-editor">
    <h2>Assessment Editor</h2>

    @if (!string.IsNullOrWhiteSpace(AssessmentError))
    {
        <p class="auth-error">@AssessmentError</p>
    }

    @if (!string.IsNullOrWhiteSpace(AssessmentMessage))
    {
        <p class="auth-help">@AssessmentMessage</p>
    }

    <div class="form-field">
        <label>Active course</label>
        <select value="@AssessmentCourseIdText" @onchange="OnAssessmentCourseChanged">
            <option value="">Select course</option>
            @foreach (var course in Courses.OrderBy(course => course.Title))
            {
                <option value="@course.Id">@course.Title</option>
            }
        </select>
        @if (!string.IsNullOrWhiteSpace(AssessmentCourseIdText))
        {
            <p class="muted-text"><strong>@(ActiveCourseTitle ?? "Current course")</strong></p>
        }
    </div>
    <div class="course-actions">
        <button type="button" @onclick="OnLoadAssessmentEditor" disabled="@string.IsNullOrWhiteSpace(AssessmentCourseIdText)">Load Assessment</button>
    </div>

    @if (AssessmentEditor is not null)
    {
        <div class="form-field">
            <label>Assessment Title</label>
            <InputText @bind-Value="AssessmentEditor.Title" />
        </div>
        <div class="form-field">
            <label>Pass Percent</label>
            <InputNumber @bind-Value="AssessmentEditor.PassPercent" />
        </div>
        <div class="form-row">
            <div class="form-field">
                <label>Maximum Retakes Per Learner</label>
                <InputNumber @bind-Value="AssessmentEditor.MaxRetakesPerLearner" />
                <p class="muted-text">Leave blank for the provider default: one Prelicensing retake, unlimited Postlicensing retakes, and one retake for other course types. Enter a positive number to override the default.</p>
            </div>
            <div class="form-field">
                <label>Retake Cooldown Minutes</label>
                <InputNumber @bind-Value="AssessmentEditor.RetakeCooldownMinutes" />
            </div>
        </div>

        <h3>Questions</h3>
        @for (var index = 0; index < AssessmentEditor.Questions.Count; index++)
        {
            var question = AssessmentEditor.Questions[index];
            <article class="course-item">
                <div class="form-field">
                    <label>Question @(index + 1)</label>
                    <InputTextArea @bind-Value="question.Prompt" />
                </div>
                <div class="form-field">
                    <label>Option A</label>
                    <InputText @bind-Value="question.OptionA" />
                </div>
                <div class="form-field">
                    <label>Option B</label>
                    <InputText @bind-Value="question.OptionB" />
                </div>
                <div class="form-field">
                    <label>Option C</label>
                    <InputText @bind-Value="question.OptionC" />
                </div>
                <div class="form-field">
                    <label>Option D</label>
                    <InputText @bind-Value="question.OptionD" />
                </div>
                <div class="form-field">
                    <label>Feedback Text (optional remediation tip)</label>
                    <InputTextArea @bind-Value="question.FeedbackText" />
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label>Correct Option</label>
                        <InputSelect @bind-Value="question.CorrectOption">
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                            <option value="D">D</option>
                        </InputSelect>
                    </div>
                    <div class="form-field">
                        <label>&nbsp;</label>
                        <button type="button" @onclick="() => OnRemoveAssessmentQuestion.InvokeAsync(index)">Remove Question</button>
                    </div>
                </div>
            </article>
        }

        <div class="course-actions">
            <button type="button" @onclick="OnAddAssessmentQuestion">Add Question</button>
            <button type="button" @onclick="OnSaveAssessmentEditor">Save Assessment</button>
        </div>

        @if (OnRegisterProctoringSession.HasDelegate)
        {
            <h3>Proctored Exam Session</h3>
            <p class="muted-text"><strong>Proctor company:</strong> @ProctorCompanyName</p>
            <div class="form-row">
                <div class="form-field">
                    <label>Learner</label>
                    <select value="@RetakeLearnerIdText" @onchange="OnRetakeLearnerChanged">
                        <option value="">Select learner</option>
                        @foreach (var learner in Users.Where(user => user.Role == "Learner"))
                        {
                            <option value="@learner.Id">@learner.DisplayName (@learner.Email)</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label>Session Validity (Minutes)</label>
                    <InputNumber Value="ProctoringValidForMinutes" ValueChanged="ProctoringValidForMinutesChanged" ValueExpression="() => ProctoringValidForMinutes" />
                </div>
            </div>
            <p class="muted-text">Opening the session confirms that staff verified the learner's identity and established closed-book examination conditions.</p>
            <button type="button" @onclick="OnRegisterProctoringSession">@(ActiveProctoringSession is null ? "Verify Identity and Open Session" : "Verify Identity and Replace Session")</button>
            @if (ActiveProctoringSession is not null)
            {
                <p class="auth-help">Active session: @ActiveProctoringSession.ProctorName, expires @ActiveProctoringSession.ExpiresAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm").</p>
                <div class="form-field">
                    <label>Security Incident Notes</label>
                    <InputTextArea Value="ProctoringIncidentNotes" ValueChanged="ProctoringIncidentNotesChanged" ValueExpression="() => ProctoringIncidentNotes" />
                </div>
                <div class="course-actions">
                    <button type="button" @onclick="OnExpireProctoringSession">Expire Session</button>
                    <button type="button" @onclick="OnReportProctoringIncident" disabled="@string.IsNullOrWhiteSpace(ProctoringIncidentNotes)">Report Incident</button>
                </div>
            }
        }

        <h3>Grant Retake Attempts</h3>
        <div class="form-row">
            <div class="form-field">
                <label>Learner</label>
                <select value="@RetakeLearnerIdText" @onchange="OnRetakeLearnerChanged">
                    <option value="">Select learner</option>
                    @foreach (var learner in Users.Where(user => user.Role == "Learner"))
                    {
                        <option value="@learner.Id">@learner.DisplayName (@learner.Email)</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>Additional Attempts</label>
                <InputNumber Value="RetakeGrantAttempts" ValueChanged="RetakeGrantAttemptsChanged" ValueExpression="() => RetakeGrantAttempts" />
            </div>
        </div>
        <div class="form-field checkbox-field">
            <label>
                <InputCheckbox Value="ResetCooldownTimerOnRetakeGrant" ValueChanged="ResetCooldownTimerOnRetakeGrantChanged" ValueExpression="() => ResetCooldownTimerOnRetakeGrant" />
                Reset cooldown timer immediately
            </label>
        </div>
        <button type="button" @onclick="OnGrantRetake">Grant Retake</button>

        <h3>Existing Retake Grants</h3>
        @if (RetakeGrants.Count == 0)
        {
            <p class="muted-text">No retake grants configured for this course.</p>
        }
        else
        {
            <table class="simple-table">
                <thead>
                    <tr>
                        <th>Learner</th>
                        <th>Attempts</th>
                        <th>Last Updated</th>
                        <th>Updated By</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grant in RetakeGrants)
                    {
                        <tr>
                            <td>@grant.LearnerDisplay</td>
                            <td>
                                <input
                                    type="number"
                                    min="1"
                                    value="@GetRetakeGrantDraft(grant.LearnerUserId, grant.GrantedAttempts)"
                                    @oninput="@(args => SetRetakeGrantDraft(grant.LearnerUserId, args.Value?.ToString()))" />
                            </td>
                            <td>@grant.GrantedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@grant.GrantedByAdminDisplay</td>
                            <td>
                                <div class="action-stack">
                                    <button type="button" @onclick="() => OnUpdateRetakeGrant.InvokeAsync(grant)">Save</button>
                                    <button type="button" @onclick="() => OnRevokeRetakeGrant.InvokeAsync(grant)">Revoke</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</section>

@code {
    [Parameter]
    public string? AssessmentError { get; set; }

    [Parameter]
    public string? AssessmentMessage { get; set; }

    [Parameter]
    public IReadOnlyList<Course> Courses { get; set; } = [];

    [Parameter]
    public IReadOnlyList<UserAccount> Users { get; set; } = [];

    [Parameter]
    public string AssessmentCourseIdText { get; set; } = string.Empty;

    [Parameter]
    public string? ActiveCourseTitle { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnAssessmentCourseChanged { get; set; }

    [Parameter]
    public EventCallback OnLoadAssessmentEditor { get; set; }

    [Parameter]
    public AssessmentEditorModel? AssessmentEditor { get; set; }

    [Parameter]
    public EventCallback OnAddAssessmentQuestion { get; set; }

    [Parameter]
    public EventCallback<int> OnRemoveAssessmentQuestion { get; set; }

    [Parameter]
    public EventCallback OnSaveAssessmentEditor { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnRetakeLearnerChanged { get; set; }

    [Parameter]
    public string RetakeLearnerIdText { get; set; } = string.Empty;

    [Parameter]
    public int RetakeGrantAttempts { get; set; }

    [Parameter]
    public EventCallback<int> RetakeGrantAttemptsChanged { get; set; }

    [Parameter]
    public bool ResetCooldownTimerOnRetakeGrant { get; set; }

    [Parameter]
    public EventCallback<bool> ResetCooldownTimerOnRetakeGrantChanged { get; set; }

    [Parameter]
    public EventCallback OnGrantRetake { get; set; }

    [Parameter]
    public string ProctorCompanyName { get; set; } = ProctoringDefaults.CompanyName;

    [Parameter]
    public int ProctoringValidForMinutes { get; set; } = 120;

    [Parameter]
    public EventCallback<int> ProctoringValidForMinutesChanged { get; set; }

    [Parameter]
    public ExamProctoringSessionView? ActiveProctoringSession { get; set; }

    [Parameter]
    public EventCallback OnRegisterProctoringSession { get; set; }

    [Parameter]
    public string ProctoringIncidentNotes { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ProctoringIncidentNotesChanged { get; set; }

    [Parameter]
    public EventCallback OnExpireProctoringSession { get; set; }

    [Parameter]
    public EventCallback OnReportProctoringIncident { get; set; }

    [Parameter]
    public IReadOnlyList<RetakeGrantView> RetakeGrants { get; set; } = [];

    [Parameter]
    public Func<Guid, int, int> GetRetakeGrantDraft { get; set; } = (_, fallback) => fallback;

    [Parameter]
    public Action<Guid, string?> SetRetakeGrantDraft { get; set; } = (_, _) => { };

    [Parameter]
    public EventCallback<RetakeGrantView> OnUpdateRetakeGrant { get; set; }

    [Parameter]
    public EventCallback<RetakeGrantView> OnRevokeRetakeGrant { get; set; }
}
