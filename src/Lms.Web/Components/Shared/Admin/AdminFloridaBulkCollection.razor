    private static string VirginiaFilePurpose(string name)
    {
        var list = VirginiaDporBulkImportService.List(name);
        return list.Kind switch
        {
            VirginiaDporListKind.Individual => $"{list.LicenseStatus} {list.LicenseType.ToLowerInvariant()}s",
            VirginiaDporListKind.BranchOffice => "Branch offices as firm locations",
            VirginiaDporListKind.SettlementAgent => "Settlement agents (coming later); may be empty",
            _ => $"Current {list.LicenseType.ToLowerInvariant()} licenses"
        };
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        if (_polling is not null) await _polling;
        _stop.Dispose();
    }
