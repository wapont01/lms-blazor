@implements IAsyncDisposable
@using Lms.Application.Services
@using Lms.Web.Services
@inject FloridaBulkCollectionService FloridaCollection
@inject FloridaBulkCollectionOptions FloridaOptions
@inject TexasBulkCollectionService TexasCollection
@inject TexasBulkCollectionOptions TexasOptions
@inject CaliforniaBulkCollectionService CaliforniaCollection
@inject CaliforniaBulkCollectionOptions CaliforniaOptions
@inject ColoradoDoraBulkCollectionService ColoradoDoraCollection
@inject ColoradoDoraBulkCollectionOptions ColoradoDoraOptions
@inject NevadaBulkCollectionService NevadaCollection
@inject NevadaBulkCollectionOptions NevadaOptions
@inject NewYorkBulkCollectionService NewYorkCollection
@inject NewYorkBulkCollectionOptions NewYorkOptions
@inject ArizonaBulkCollectionService ArizonaCollection
@inject ArizonaBulkCollectionOptions ArizonaOptions
@inject ConnecticutBulkCollectionService ConnecticutCollection
@inject ConnecticutBulkCollectionOptions ConnecticutOptions
@inject OregonBulkCollectionService OregonCollection
@inject OregonBulkCollectionOptions OregonOptions
@inject DelawareBulkCollectionService DelawareCollection
@inject DelawareBulkCollectionOptions DelawareOptions
@inject IllinoisBulkCollectionService IllinoisCollection
@inject IllinoisBulkCollectionOptions IllinoisOptions
@inject VirginiaBulkCollectionService VirginiaCollection
@inject VirginiaBulkCollectionOptions VirginiaOptions
@inject MichiganBulkCollectionService MichiganCollection
@inject MichiganBulkCollectionOptions MichiganOptions
@inject WestVirginiaBulkCollectionService WestVirginiaCollection
@inject WestVirginiaBulkCollectionOptions WestVirginiaOptions
@inject MaineBulkCollectionService MaineCollection
@inject MaineBulkCollectionOptions MaineOptions
@inject VermontBulkCollectionService VermontCollection
@inject VermontBulkCollectionOptions VermontOptions
@inject ILogger<AdminFloridaBulkCollection> Logger

<section class="card bulk-collection" aria-label="@($"{State} bulk collection")">
    <div class="bulk-actions">
        <h2>@State bulk collection</h2>
        <button type="button" class="secondary-btn" @onclick="ToggleCollectionAsync"
                disabled="@(!_interactive || _starting || _stopping || _status?.State == "Stopping")">
            @(_starting ? "Starting..." : _stopping || _status?.State == "Stopping" ? "Cancelling..." : IsRunning ? "Cancel collection" : State == "Nevada" ? "Collect data" : "Collect now")
        </button>
    </div>
    <p class="muted-text">Official statewide @(State == "Florida" ? "DBPR files" : State == "California" ? "DRE license and broker-associate files" : State == "Colorado" ? "DORA real-estate dataset" : State == "Nevada" ? "NRED active-license workbooks" : State == "New York" ? "NY DOS active real-estate licensee dataset" : State == "Arizona" ? "ADRE individual and entity license lists" : State == "Connecticut" ? "DCP real estate salesperson, broker and broker-association datasets" : State == "Oregon" ? "OREA active business and active and inactive individual rosters" : State == "Delaware" ? "DPR real estate and appraiser professional licensing dataset" : State == "Illinois" ? "IDFPR real estate and appraisal professional licensing dataset" : State == "Virginia" ? "DPOR Real Estate Board regulant lists" : State == "Michigan" ? "LARA current real-estate license and employer reports" : State == "West Virginia" ? "WVREC active licensee workbooks" : State == "Maine" ? "ALMS active individual and company exports" : State == "Vermont" ? "OPR real-estate profession exports in all statuses" : "TREC roster"). A validated collection automatically becomes the current roster. Failed or stopped runs leave the current roster unchanged.</p>
    @if (State == "Nevada")
    {
        <p class="muted-text">Collects the 12 supported active lists directly from NRED on the application server, not through this browser. NRED updates these lists monthly. Reserve Study Specialists is a separate historical workbook and is not included. Acquisition timestamps are recorded; no source publication date is inferred.</p>
    }
    @if (State == "California")
    {
        <p class="muted-text">This roster uses DRE's licensee ZIP and broker-associate workbook. The separate MLO workbook links DRE licenses to NMLS endorsements; it is not loaded as another license role. New licensees are a recent subset of the daily list. The examinee list is separate and excluded. License roles and relationships are not unique people.</p>
    }
    <nav class="sources commission-sources" aria-label="Commission download websites">
        @if (State == "Florida")
        {
        <a href="https://www2.myfloridalicense.com/real-estate-commission/public-records/" target="_blank" rel="noopener noreferrer">Real Estate Commission - bulk downloads</a>
        <a href="https://www2.myfloridalicense.com/real-estate-appraisal-board/public-records/" target="_blank" rel="noopener noreferrer">Real Estate Appraisal Board - bulk downloads</a>
        }
        else if (State == "Texas")
        {
            <a href="https://www.trec.texas.gov/public/high-value-data-sets" target="_blank" rel="noopener noreferrer">Texas Real Estate Commission - bulk downloads</a>
            <a href="https://data.texas.gov/Permits-and-Licensing/Broker-and-Sales-Agent-License-Holder-Information/s7ft-44qi" target="_blank" rel="noopener noreferrer">Official Texas statewide dataset</a>
        }
        else if (State == "California")
        {
            <a href="https://dre.ca.gov/Licensees/ExamineeLicenseeListDataFiles.html" target="_blank" rel="noopener noreferrer">California Department of Real Estate - bulk downloads</a>
            <a href="https://dre.ca.gov/files/pdf/forms/re776.pdf" target="_blank" rel="noopener noreferrer">DRE source field definitions</a>
        }
        else if (State == "Colorado")
        {
            <a href="https://data.colorado.gov/Regulations/Licensed-Real-Estate-Professionals-in-Colorado/4zse-6bnw/about_data" target="_blank" rel="noopener noreferrer">Colorado DORA licensed real-estate professionals dataset</a>
        }
        else if (State == "Nevada")
        {
            <a href="@NevadaNredBulkImportService.SourceUrl" target="_blank" rel="noopener noreferrer">Nevada NRED active licensee lists</a>
        }
        else if (State == "New York")
        {
            <a href="@NewYorkDosBulkImportService.SourcePage" target="_blank" rel="noopener noreferrer">New York DOS active real estate salespersons and brokers dataset</a>
        }
        else if (State == "Arizona")
        {
            <a href="@ArizonaAdreBulkImportService.SourcePage" target="_blank" rel="noopener noreferrer">Arizona ADRE public database lists</a>
        }
        else if (State == "Connecticut")
        {
            <a href="@ConnecticutDcpBulkImportService.SourcePage" target="_blank" rel="noopener noreferrer">Connecticut DCP real estate salesperson licenses</a>
            <a href="https://data.ct.gov/Business/Real-Estate-Broker-Licenses/fwpc-pgqj" target="_blank" rel="noopener noreferrer">Connecticut DCP real estate broker licenses</a>
            <a href="https://data.ct.gov/Business/Real-Estate-Salespersons-with-Associated-Broker/6tja-6vdt" target="_blank" rel="noopener noreferrer">Connecticut DCP salespersons with associated broker</a>
        }
        else if (State == "Oregon")
        {
            <a href="@OregonOreaBulkImportService.SourcePage" target="_blank" rel="noopener noreferrer">Oregon Real Estate Agency roster lists</a>
        }
        else if (State == "Delaware")
        {
            <a href="@DelawareDprBulkImportService.SourcePage" target="_blank" rel="noopener noreferrer">Delaware DPR professional and occupational licensing dataset</a>
        }
        else if (State == "Illinois")
        {
            <a href="@IllinoisIdfprBulkImportService.SourcePage" target="_blank" rel="noopener noreferrer">Illinois IDFPR professional licensing dataset</a>
        }
        else if (State == "Virginia")
        {
            <a href="@VirginiaDporBulkImportService.SourcePage" target="_blank" rel="noopener noreferrer">Virginia DPOR regulant lists</a>
        }
        else if (State == "Michigan")
        {
            <a href="@MichiganLaraBulkImportService.SourcePage" target="_blank" rel="noopener noreferrer">Michigan LARA license and employer reports</a>
        }
        else if (State == "Maine")
        {
            <a href="@MaineAlmsBulkImportService.SourcePage" target="_blank" rel="noopener noreferrer">Maine ALMS real estate license search and exports</a>
        }
        else if (State == "Vermont")
        {
            <a href="@VermontOprBulkImportService.SourcePage" target="_blank" rel="noopener noreferrer">Vermont OPR profession roster downloads</a>
        }
        else if (State == "West Virginia")
        {
            <a href="@WestVirginiaRecBulkImportService.SourcePage" target="_blank" rel="noopener noreferrer">West Virginia REC active licensee rosters</a>
        }
    </nav>
    @if (_error is not null)
    {
        <p class="auth-error" role="alert">@_error</p>
    }
    @if (_status is { } status)
    {
        <dl class="bulk-status">
            <div><dt>Collection</dt><dd>@status.State</dd></div>
            <div><dt>Last completion</dt><dd>@Utc(status.CompletedAtUtc)</dd></div>
            <div><dt>Next automatic run</dt><dd>@(Options.WeeklyEnabled ? Utc(status.NextRunAtUtc) : "Disabled")</dd></div>
            @if (status.StartedAtUtc is not null)
            {
                <div><dt>@(IsRunning ? "Elapsed time" : "Run duration")</dt><dd>@(Duration(status, IsRunning) ?? "Not recorded")</dd></div>
            }
        </dl>
        @if (IsRunning)
        {
            <div class="run-progress">
                <label for="bulk-phase-progress">@status.State · @status.StagedRecords.ToString("N0") records staged in the current transaction</label>
                <progress id="bulk-phase-progress" aria-label="Bulk collection phase progress"></progress>
                <p class="muted-text">Updates every 5 seconds. Download bars show completion percentage when available. Validation reports checked rows; staging is not complete until the transaction commits. Remaining time is not yet known.</p>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(status.Error))
        {
            <p class="auth-error" role="alert">@status.Error</p>
        }
        @if (status.Files.Count > 0)
        {
            <div class="table-wrap">
                <table aria-label="@($"{State} bulk files")">
                    <thead><tr><th>File</th><th>Use</th><th>Status / progress</th><th>Rows</th></tr></thead>
                    <tbody>
                        @foreach (var file in status.Files)
                        {
                            <tr>
                                <th scope="row">@file.Name</th><td>@(State == "Texas" ? "Individuals and broker companies; all published statuses" : State == "California" ? file.Name == "CurrList.zip" ? "Published license roles, statuses and restrictions" : "Responsible-broker affiliations and dates" : State == "Colorado" ? "All published DORA records and statuses" : State == "Nevada" ? file.Name == "NRED-ACTIVE-HOA.xlsx" ? "Source evidence only" : "Numbered professional licenses" : State == "New York" ? "Active salespersons, brokers and offices" : State == "Arizona" ? file.Name == ArizonaAdreBulkImportService.IndividualsFile ? "Salespersons and brokers; all statuses; employing entity" : "Firms and branch offices; designated broker" : State == "Connecticut" ? file.Name == ConnecticutDcpBulkImportService.SalespersonsFile ? "Salespersons; all statuses" : file.Name == ConnecticutDcpBulkImportService.BrokersFile ? "Individual and company brokers; all statuses" : "Active salesperson to broker or team links" : State == "Oregon" ? file.Name == OregonOreaBulkImportService.BusinessesFile ? "Registered business names and escrow companies; branch offices as locations" : file.Name == OregonOreaBulkImportService.ActiveIndividualsFile ? "Active brokers, principal brokers and property managers; business associations and key managers" : "Inactive brokers, principal brokers and property managers" : State == "Delaware" ? "Salespersons, brokers, offices and appraisers; all statuses; branch offices as locations" : State == "Illinois" ? "Real estate and appraisal licenses, firms, schools and additional offices (all statuses; course approvals excluded)" : State == "Virginia" ? VirginiaFilePurpose(file.Name) : FilePurpose(file.Name))</td>
                                <td class="file-progress">
                                    @file.State
                                    @if (file.State.StartsWith("Validating", StringComparison.Ordinal) && file.ExpectedRows is > 0)
                                    {
                                        <progress aria-label="@($"{file.Name} validation progress")" max="@file.ExpectedRows" value="@file.Rows"></progress>
                                        <small>@file.Rows.ToString("N0") / @file.ExpectedRows.Value.ToString("N0") rows checked</small>
                                    }
                                    else if (file.ExpectedBytes is > 0)
                                    {
                                        <progress aria-label="@($"{file.Name} download progress")" max="@file.ExpectedBytes" value="@file.Bytes"></progress>
                                        <small>@((100d * file.Bytes / file.ExpectedBytes.Value).ToString("F1"))% complete</small>
                                    }
                                    else if (IsRunning && file.State != "Waiting")
                                    {
                                        <progress aria-label="@($"{file.Name} progress")"></progress>
                                    }
                                </td>
                                <td>@file.Rows.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (status.SnapshotId is { } snapshotId)
        {
            <p role="status">Last collected roster: @snapshotId. <a href="@($"/admin/regulatory-directory?state={State}")">Roster history and recovery</a></p>
            <nav class="sources" aria-label="@($"{State} bulk archive downloads")">
                @foreach (var file in status.Files)
                {
                    <a href="@($"/admin/{State.ToLowerInvariant()}-bulk/exports/{Uri.EscapeDataString(file.Name)}")">@file.Name</a>
                }
                <a href="@($"/admin/{State.ToLowerInvariant()}-bulk/exports/manifest.json")">Archive manifest</a>
            </nav>
        }
    }
    else
    {
        <p class="muted-text">Loading bulk collection status...</p>
    }
    <details>
        <summary>Sources and coverage</summary>
        @if (State == "Florida")
        {
        <p>Broker/sales, instructor, firm and appraisal licenses are staged together. Schools, additional locations and continuing-education records are archived separately; CE rows are completion events, not licensees. Regional downloads are not summed into statewide totals.</p>
        <p>Bulk excludes Null &amp; Void licenses and is not a historical all-status roster. Addresses are mailing addresses. Acquisition time is not a verified DBPR publication date. Automatic collection runs only while the LMS is running; missed runs are checked on startup.</p>
        }
        else if (State == "Texas")
        {
            <p>Texas imports Broker Individual and Sales Agent credentials as people and Broker Company credentials as firms, preserving all published statuses and license suffixes. Missing names are explicitly marked not published. Only actual company/individual matches become affiliations; individual sponsors are not invented as firms. Instructor, appraisal and school rosters are outside this dataset. Missing records never imply revocation. Source acquisition is not a verified publication date; refresh runs only while the host is running.</p>
        }
        else if (State == "California")
        {
            <p>DRE publishes the current license ZIP and broker-associate XLS daily; LMS refreshes on the collection schedule. Eight-digit licenses, multiple-record indicators, broker/salesperson/officer/corporation roles, NBA statuses, restrictions and ethics/agency scope are preserved. Relationships require source-backed broker or corporation records. Broker-associate-only credentials have no inferred status; conflicting expiration or relationship dates stop import. Mailing addresses are not stored in the directory; original files remain Admin-only. Missing licenses do not imply revocation.</p>
        }
        else if (State == "Colorado")
        {
            <p>DORA provides the complete 4zse-6bnw dataset, including real-estate credentials and other DORA program types. Every source row is archived in the database; the admin-selected license types control which Colorado records appear in the roster UI. All published statuses are retained, and rows without a license number remain in the source-record archive.</p>
        }
        else if (State == "Nevada")
        {
            <p>All 12 supported workbooks must pass schema, row count and hash checks before automatic activation. Identical files reuse the existing snapshot without creating another comparison version. HOA rows are retained as source evidence; numbered licenses are deduplicated within each professional type. Company names are not inferred as licensed firms or affiliations. A license absent from a later active-only list is not classified as revoked.</p>
        }
        else if (State == "New York")
        {
            <p>NY DOS publishes dataset yg7h-zjbf daily on data.ny.gov. It lists active licenses only (salespersons, associate and individual brokers, corporate, LLC, partnership and trade-name brokers, and principal and branch offices); there is no status column, so every record is Active and a license missing from a later collection is not classified as revoked. Every source row is archived; licensees listed at more than one business address appear once per license type. The business name is kept as the employing company, not as an inferred affiliation. The expiration date is stored; offices have none.</p>
        }
                    else if (State == "Arizona")
                    {
                        <p>ADRE generates the individuals and entities lists on demand from its live license database. Both files must pass schema, row count and hash checks before automatic activation. Only the Real Estate category is imported (cemetery and campground licenses stay in the source files), with every published status, including terminated and expired. Entities become firms and branch offices; each person is linked to the employing entity on the list, and the entity's designated broker is marked broker in charge. Where ADRE lists one license number twice, the most recently modified row is kept. Mailing addresses are not stored in the directory; the original files remain Admin-only.</p>
                    }
                                else if (State == "Connecticut")
                                {
                                    <p>CT DCP updates the salesperson, broker and salesperson-with-associated-broker datasets daily on data.ct.gov. All three must pass schema, row count and hash checks, and each must be unchanged while it is paged, before automatic activation. Salesperson and broker credentials keep every published status; application rows without a credential number stay in the source files only. Company brokers become firms. Individual brokers are licensees, and those with associated salespersons also become firms with themselves as broker in charge. Real estate teams (RTM credentials) appear only in the association dataset, so they become firms without a published status. The association dataset lists actively licensed salespersons only, so a salesperson without a broker there is not classified as unaffiliated. Only city, state and ZIP are published.</p>
                                }
                                else if (State == "Oregon")
                                {
                                    <p>OREA generates its free rosters on request from the Generate List(s) page; the collector selects each roster, reads its id from the Download List(s) page and downloads the CSV. All three files must pass schema, row count and hash checks before automatic activation. OREA splits each header label across a value column and an empty spacer column, so values are read by position and any value in a spacer column stops the import. Registered business names (RBN) and registered branch offices (RBO) become firms; escrow agents (EA) stay in the source file only. The active individual roster lists a licensee once per business association, so each license appears once and is linked to every associated business with its association date; the key manager is marked broker in charge. Where a license appears on both rosters, the active row is kept. OREA publishes no business status or first-license date, so every firm is Active.</p>
                                }
                                else if (State == "Delaware")
                                {
                                    <p>DE DPR publishes one statewide professional licensing dataset (pjnv-eaih) daily on data.delaware.gov. Only the Real Estate and Real Estate Appraisers professions are requested, in every published status; the export must match the published row count and stay unchanged while it is paged. Main office permits become real estate firms and appraisal management companies become appraisal firms. Branch office permits are extra locations of a main office, linked by name (exact, normalized, then a closely matching name flagged for review; otherwise left unlinked) because DPR does not publish the owning permit. Everything else is a licensee; appraiser credentials are imported but not yet offered. DPR publishes no employing broker, so no affiliations are created. Where a license number appears twice, the latest term is kept. Only city, state and ZIP are published.</p>
                                }
                                else if (State == "Illinois")
                                {
                                    <p>IL IDFPR publishes the Professional Licensing dataset (pzzh-kp68) daily on data.illinois.gov. Only REAL ESTATE and APPRAISAL rows are requested, in every published status; course approvals are excluded. The export must match the published row count and stay unchanged while it is paged. Brokerage businesses become real estate firms, appraisal management companies become appraisal firms, and schools and education providers become education firms. Branch and virtual offices become additional locations linked to firms by business name (exact, normalized, then a closely matching name flagged for review; otherwise left unlinked). Other credentials become licensees; appraisal and instructor credentials are imported but not yet offered. Rows without license numbers stay in the source file only. Disciplinary actions can repeat a license number; the latest expiration, then effective or issue date, then first row is kept. No broker affiliations are published. Only city, state and ZIP are published.</p>
                                }
                                else if (State == "Virginia")
                                {
                                    <p>DPOR replaces its regulant lists every 5 business days, usually on Mondays. All 13 Real Estate Board lists must pass schema, row count and hash checks before automatic activation; the settlement agent list may be empty. License numbers combine board, occupation and certificate (for example 0225250860). Active and inactive salespersons, associate brokers, principal brokers and sole proprietors become licensees; their status comes from the list they appear on. Current firms, business entities and sole proprietorships become real estate firms, settlement agents become settlement firms, and branch offices become firm locations linked by business name (exact, normalized, then a closely matching name flagged for review; otherwise left unlinked). Expired licenses and broker affiliations are not published. Business names that contain a literal tab are rejoined.</p>
                                }
        else if (State == "Michigan")
        {
            <p>MiPLUS generates both Excel reports on demand. The license report covers current real-estate credentials, including any suspended or late-renewal statuses it publishes, not historical expired licenses. Broker companies and individual brokers become firms; individual brokers also remain searchable licensees. Branch offices become additional locations. The active-employer report links people and branches only by published broker license numbers present in the license report; unmatched relationships remain in the archive. No relationships are guessed from names. Both reports must pass schema, row count and hash checks before activation. Report acquisition times may differ because each report queries the live database separately.</p>
        }
        else if (State == "West Virginia")
        {
            <p>WVREC publishes separate active salesperson, associate-broker and broker Excel rosters. All files must pass schema, row count and hash checks before activation. Only published active licenses are covered, not a historical all-status roster. Companies use published CompanyNumber identifiers, not verified firm license numbers; company status and license dates remain unknown. Branch locations use CompanyNumber and BranchNumber together because branch numbers repeat across companies. Affiliations use published company IDs only; broker-in-charge status and relationship dates are not inferred. The original workbooks remain Admin-only. Missing licenses never imply revocation.</p>
        }
        else if (State == "Maine")
        {
            <p>ALMS generates separate individual and company CSV exports from unrestricted Real Estate Commission active-license searches. Both files must pass schema, row count and hash checks before activation. Published alias rows remain in the original archives and are not counted as additional licenses. Branch ownership and employment relationships are not guessed from names or addresses. License issue dates are not published in these exports. Missing licenses never imply revocation; the original files remain Admin-only.</p>
        }
        else if (State == "Vermont")
        {
            <p>OPR generates Excel exports through its public guest profession-roster workflow. All nine real-estate license types are requested with every portal status filter: Active, Inactive per Request, Expired and Disciplined. This is not comprehensive discipline history or a guarantee of every historical status. All files must pass schema, row count and hash checks before activation; a published header-only category is valid. Where a credential has multiple terms, the latest published effective term is kept. Firms and branches retain their published identities, including missing historical names, without inferred ownership or broker-in-charge relationships. The original files remain Admin-only.</p>
        }
        <p>Stop collection cancels only the current run. An uncommitted import is rolled back and the last completed archive is retained. You can collect again manually; automatic collection waits at least one refresh interval after an administrator stops a run.</p>
    </details>
</section>

@code {
    [Parameter] public string State { get; set; } = "Florida";
    private BulkCollectionService Collection => State switch
    {
        "California" => CaliforniaCollection,
        "Texas" => TexasCollection,
        "Colorado" => ColoradoDoraCollection,
        "Nevada" => NevadaCollection,
        "New York" => NewYorkCollection,
        "Arizona" => ArizonaCollection,
        "Connecticut" => ConnecticutCollection,
        "Oregon" => OregonCollection,
        "Delaware" => DelawareCollection,
        "Illinois" => IllinoisCollection,
        "Virginia" => VirginiaCollection,
        "Michigan" => MichiganCollection,
        "West Virginia" => WestVirginiaCollection,
        "Maine" => MaineCollection,
        "Vermont" => VermontCollection,
        _ => FloridaCollection
    };
    private FloridaBulkCollectionOptions Options => State switch
    {
        "California" => CaliforniaOptions,
        "Texas" => TexasOptions,
        "Colorado" => ColoradoDoraOptions,
        "Nevada" => NevadaOptions,
        "New York" => NewYorkOptions,
        "Arizona" => ArizonaOptions,
        "Connecticut" => ConnecticutOptions,
        "Oregon" => OregonOptions,
        "Delaware" => DelawareOptions,
        "Illinois" => IllinoisOptions,
        "Virginia" => VirginiaOptions,
        "Michigan" => MichiganOptions,
        "West Virginia" => WestVirginiaOptions,
        "Maine" => MaineOptions,
        "Vermont" => VermontOptions,
        _ => FloridaOptions
    };
    [Parameter] public EventCallback<Guid> SnapshotCompleted { get; set; }
    private readonly CancellationTokenSource _stop = new();
    private FloridaBulkCollectionStatus? _status;
    private string? _error;
    private Task? _polling;
    private bool _interactive;
    private bool _starting;
    private bool _stopping;
    private Guid? _observedSnapshotId;
    private DateTime? _observedCompletedAtUtc;
    private bool _loaded;
    private bool IsRunning => _status?.State is "Downloading" or "Validating" or "Importing" or "Running" or "Collecting" or "Stopping";

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _interactive = true;
        _polling = PollAsync();
        StateHasChanged();
    }

    private async Task CollectAsync()
    {
        _starting = true;
        _error = null;
        try
        {
            await Collection.StartAsync(_stop.Token);
            await RefreshAsync();
        }
        catch (Exception exception) when (exception is InvalidOperationException or IOException)
        {
            Logger.LogError(exception, "Could not start Florida bulk collection");
            _error = "Bulk collection could not be started: " + exception.Message;
        }
        finally { _starting = false; }
    }

    private Task ToggleCollectionAsync()
    {
        if (_starting) return Task.CompletedTask;
        return IsRunning ? StopCollectionAsync() : CollectAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            _status = await Collection.GetStatusAsync(_stop.Token);
            _error = null;
            if (_status.SnapshotId is { } id && (_observedSnapshotId != id || _observedCompletedAtUtc != _status.CompletedAtUtc))
            {
                _observedSnapshotId = id;
                _observedCompletedAtUtc = _status.CompletedAtUtc;
                if (_loaded)
                    await SnapshotCompleted.InvokeAsync(id);
            }
            _loaded = true;
        }
        catch (Exception exception) when (exception is IOException or System.Text.Json.JsonException or InvalidOperationException)
        {
            Logger.LogError(exception, "Could not read Florida bulk collection status");
            _error = "Bulk collection status could not be read. " + exception.Message;
        }
    }

    private async Task StopCollectionAsync()
    {
        _stopping = true;
        _error = null;
        try
        {
            await Collection.CancelCollectionAsync(_stop.Token);
            await RefreshAsync();
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception exception) when (exception is InvalidOperationException or IOException)
        {
            Logger.LogError(exception, "Could not stop Florida bulk collection");
            _error = "Bulk collection could not be stopped: " + exception.Message;
        }
        finally { _stopping = false; }
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
                await InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }

    private static string Utc(DateTime? value) => value?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Not yet available";
    // A run interrupted by an application stop has no recorded end, so its duration is unknown.
    private static string? Duration(FloridaBulkCollectionStatus status, bool running)
    {
        var end = running ? DateTime.UtcNow
            : status.FinishedAtUtc ?? (status.State == "Completed" ? status.CompletedAtUtc : null);
        if (end is null) return null;
        var elapsed = end.Value - status.StartedAtUtc!.Value;
        if (elapsed < TimeSpan.Zero) elapsed = TimeSpan.Zero;
        return $"{(int)elapsed.TotalHours:00}:{elapsed.Minutes:00}:{elapsed.Seconds:00}";
    }
