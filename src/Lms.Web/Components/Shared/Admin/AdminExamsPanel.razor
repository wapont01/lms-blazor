@using Lms.Application.Services
@using Lms.Domain.Entities

<section class="card" id="admin-exam-editor">
    <h2>Exam Editor</h2>

    @if (!string.IsNullOrWhiteSpace(ExamError))
    {
        <p class="auth-error">@ExamError</p>
    }

    @if (!string.IsNullOrWhiteSpace(ExamMessage))
    {
        <p class="auth-help">@ExamMessage</p>
    }

    <div class="form-field">
        <label>Active course</label>
        @if (string.IsNullOrWhiteSpace(ExamCourseIdText))
        {
            <p class="muted-text">Select a course above to manage its final exam.</p>
        }
        else
        {
            <p class="muted-text"><strong>@(ActiveCourseTitle ?? "Current course")</strong></p>
        }
    </div>
    <div class="course-actions">
        <button type="button" @onclick="OnLoadExamEditor" disabled="@string.IsNullOrWhiteSpace(ExamCourseIdText)">Load Final Exam</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(ExamCourseIdText))
    {
        <h3>Unit Exams</h3>
        <p class="muted-text">Add or edit the required exam attached to each unit. Unit Exams unlock after that unit's lessons are complete.</p>
        @if (!ActiveCourseUnits.Any())
        {
            <p class="muted-text">Add course units before configuring Unit Exams.</p>
        }
        else
        {
            <ul class="course-list">
                @foreach (var unit in ActiveCourseUnits)
                {
                    var unitExam = UnitExams.FirstOrDefault(exam => exam.Kind == CourseExamKinds.Standard && exam.UnitId == unit.Id);
                    <li>
                        <span>@unit.Title — @(unitExam is null ? "No Unit Exam configured" : $"{unitExam.QuestionCount} questions")</span>
                        @if (unitExam is null)
                        {
                            <button type="button" @onclick="() => OnCreateUnitExam.InvokeAsync(unit.Id)">Add Unit Exam</button>
                        }
                        else
                        {
                            <button type="button" @onclick="() => OnLoadUnitExamEditor.InvokeAsync(unitExam.Id)">Edit Unit Exam</button>
                        }
                    </li>
                }
            </ul>
        }

        <h3>Intermediate and Practice Exams</h3>
        <p class="muted-text">Intermediate Exams follow a unit. The Practice Exam is placed before the Final Exam and starts with a copy of its questions.</p>
        <div class="form-row">
            <div class="form-field">
                <label>Exam Type</label>
                <InputSelect @bind-Value="_newSupplementalKind">
                    <option value="@CourseExamKinds.Intermediate">Intermediate Exam</option>
                    <option value="@CourseExamKinds.Practice">Practice Exam</option>
                </InputSelect>
            </div>
            @if (_newSupplementalKind == CourseExamKinds.Intermediate)
            {
                <div class="form-field">
                    <label>After Unit</label>
                    <InputSelect @bind-Value="_newSupplementalUnitIdText">
                        <option value="">Select a unit</option>
                        @foreach (var unit in ActiveCourseUnits)
                        {
                            <option value="@unit.Id">@unit.Title</option>
                        }
                    </InputSelect>
                </div>
            }
        </div>
        <div class="course-actions">
            <button type="button" @onclick="CreateSupplementalExamAsync" disabled="@(OnCreateSupplementalExam.HasDelegate == false || (_newSupplementalKind == CourseExamKinds.Intermediate && string.IsNullOrWhiteSpace(_newSupplementalUnitIdText)))">Add Exam</button>
        </div>
        @if (SupplementalExams.Count == 0)
        {
            <p class="muted-text">No Intermediate or Practice Exams are configured for this course.</p>
        }
        else
        {
            <ul class="course-list">
                @foreach (var exam in SupplementalExams.OrderBy(exam => exam.OrderIndex))
                {
                    var unitTitle = exam.UnitId.HasValue
                        ? ActiveCourse?.Units.FirstOrDefault(unit => unit.Id == exam.UnitId.Value)?.Title
                        : null;
                    <li>
                        <span>@exam.Title (@(exam.Kind == CourseExamKinds.Practice ? "Practice Exam" : $"after {unitTitle ?? "unit"}"), @exam.QuestionCount questions)</span>
                        <span class="action-stack">
                            <button type="button" @onclick="() => OnLoadSupplementalExamEditor.InvokeAsync(exam.Id)">Edit</button>
                            <button type="button" @onclick="() => OnDeleteSupplementalExam.InvokeAsync(exam.Id)">Delete</button>
                        </span>
                    </li>
                }
            </ul>
        }
    }

    @if (ExamEditor is not null)
    {
        <h3>@(IsEditingSupplementalExam ? "Exam Editor" : "Final Exam Editor")</h3>
        <div class="form-field">
            <label>Exam Title</label>
            <InputText @bind-Value="ExamEditor.Title" />
        </div>
        <div class="form-field">
            <label>Pass Percent</label>
            <InputNumber @bind-Value="ExamEditor.PassPercent" />
        </div>
        <div class="form-row">
            <div class="form-field">
                <label>Student Attempt Policy</label>
                <p class="muted-text">Base limit is fixed at 1 attempt, or 2 if the first attempt fails. Use retake grants below to allow additional attempts.</p>
            </div>
            <div class="form-field">
                <label>Retake Cooldown Minutes</label>
                <InputNumber @bind-Value="ExamEditor.RetakeCooldownMinutes" />
            </div>
        </div>

        <h3>Questions</h3>
        @for (var index = 0; index < ExamEditor.Questions.Count; index++)
        {
            var question = ExamEditor.Questions[index];
            <article class="course-item">
                <div class="form-field">
                    <label>Question @(index + 1)</label>
                    <InputTextArea @bind-Value="question.Prompt" />
                </div>
                <div class="form-field">
                    <label>Option A</label>
                    <InputText @bind-Value="question.OptionA" />
                </div>
                <div class="form-field">
                    <label>Option B</label>
                    <InputText @bind-Value="question.OptionB" />
                </div>
                <div class="form-field">
                    <label>Option C</label>
                    <InputText @bind-Value="question.OptionC" />
                </div>
                <div class="form-field">
                    <label>Option D</label>
                    <InputText @bind-Value="question.OptionD" />
                </div>
                <div class="form-field">
                    <label>Feedback Text (optional remediation tip)</label>
                    <InputTextArea @bind-Value="question.FeedbackText" />
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label>Correct Option</label>
                        <InputSelect @bind-Value="question.CorrectOption">
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                            <option value="D">D</option>
                        </InputSelect>
                    </div>
                    <div class="form-field">
                        <label>&nbsp;</label>
                        <button type="button" @onclick="() => OnRemoveExamQuestion.InvokeAsync(index)">Remove Question</button>
                    </div>
                </div>
            </article>
        }

        <div class="course-actions">
            <button type="button" @onclick="OnAddExamQuestion">Add Question</button>
            <button type="button" @onclick="@(IsEditingSupplementalExam ? OnSaveSupplementalExam : OnSaveExamEditor)">Save Exam</button>
        </div>

        @if (!IsEditingSupplementalExam)
        {
        <h3>Grant Retake Attempts</h3>
        <div class="form-row">
            <div class="form-field">
                <label>Student</label>
                <select value="@RetakeLearnerIdText" @onchange="OnRetakeLearnerChanged">
                    <option value="">Select student</option>
                    @foreach (var learner in Users.Where(user => user.Role == "Learner"))
                    {
                        <option value="@learner.Id">@learner.DisplayName (@learner.Email)</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>Additional Attempts</label>
                <InputNumber Value="RetakeGrantAttempts" ValueChanged="RetakeGrantAttemptsChanged" ValueExpression="() => RetakeGrantAttempts" />
            </div>
        </div>
        <div class="form-field checkbox-field">
            <label>
                <InputCheckbox Value="ResetCooldownTimerOnRetakeGrant" ValueChanged="ResetCooldownTimerOnRetakeGrantChanged" ValueExpression="() => ResetCooldownTimerOnRetakeGrant" />
                Reset cooldown timer immediately
            </label>
        </div>
        <button type="button" @onclick="OnGrantRetake">Grant Retake</button>

        <h3>Existing Retake Grants</h3>
        @if (RetakeGrants.Count == 0)
        {
            <p class="muted-text">No retake grants configured for this course.</p>
        }
        else
        {
            <table class="simple-table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Attempts</th>
                        <th>Last Updated</th>
                        <th>Updated By</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grant in RetakeGrants)
                    {
                        <tr>
                            <td>@grant.LearnerDisplay</td>
                            <td>
                                <input
                                    type="number"
                                    min="1"
                                    value="@GetRetakeGrantDraft(grant.LearnerUserId, grant.GrantedAttempts)"
                                    @oninput="@(args => SetRetakeGrantDraft(grant.LearnerUserId, args.Value?.ToString()))" />
                            </td>
                            <td>@grant.GrantedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@grant.GrantedByAdminDisplay</td>
                            <td>
                                <div class="action-stack">
                                    <button type="button" @onclick="() => OnUpdateRetakeGrant.InvokeAsync(grant)">Save</button>
                                    <button type="button" @onclick="() => OnRevokeRetakeGrant.InvokeAsync(grant)">Revoke</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        }
    }
</section>

@code {
    private string _newSupplementalKind = CourseExamKinds.Intermediate;
    private string _newSupplementalUnitIdText = string.Empty;
    private Course? ActiveCourse => Guid.TryParse(ExamCourseIdText, out var courseId)
        ? Courses.FirstOrDefault(course => course.Id == courseId)
        : null;
    private IEnumerable<Unit> ActiveCourseUnits => ActiveCourse?.Units.OrderBy(unit => unit.OrderIndex) ?? Enumerable.Empty<Unit>();

    private Task CreateSupplementalExamAsync()
    {
        var unitId = Guid.TryParse(_newSupplementalUnitIdText, out var parsedUnitId) ? parsedUnitId : (Guid?)null;
        return OnCreateSupplementalExam.InvokeAsync(new SupplementalExamCreateRequest(_newSupplementalKind, unitId));
    }

    [Parameter]
    public string? ExamError { get; set; }

    [Parameter]
    public string? ExamMessage { get; set; }

    [Parameter]
    public IReadOnlyList<Course> Courses { get; set; } = [];

    [Parameter]
    public IReadOnlyList<UserAccount> Users { get; set; } = [];

    [Parameter]
    public string ExamCourseIdText { get; set; } = string.Empty;

    [Parameter]
    public string? ActiveCourseTitle { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnExamCourseChanged { get; set; }

    [Parameter]
    public EventCallback OnLoadExamEditor { get; set; }

    [Parameter]
    public ExamEditorModel? ExamEditor { get; set; }

    [Parameter]
    public IReadOnlyList<SupplementalExamInfo> SupplementalExams { get; set; } = [];

    [Parameter]
    public IReadOnlyList<CourseExamMenuInfo> UnitExams { get; set; } = [];

    [Parameter]
    public bool IsEditingSupplementalExam { get; set; }

    [Parameter]
    public EventCallback<SupplementalExamCreateRequest> OnCreateSupplementalExam { get; set; }

    [Parameter]
    public EventCallback<Guid> OnCreateUnitExam { get; set; }

    [Parameter]
    public EventCallback<Guid> OnLoadUnitExamEditor { get; set; }

    [Parameter]
    public EventCallback<Guid> OnLoadSupplementalExamEditor { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDeleteSupplementalExam { get; set; }

    [Parameter]
    public EventCallback OnSaveSupplementalExam { get; set; }

    [Parameter]
    public EventCallback OnAddExamQuestion { get; set; }

    [Parameter]
    public EventCallback<int> OnRemoveExamQuestion { get; set; }

    [Parameter]
    public EventCallback OnSaveExamEditor { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnRetakeLearnerChanged { get; set; }

    [Parameter]
    public string RetakeLearnerIdText { get; set; } = string.Empty;

    [Parameter]
    public int RetakeGrantAttempts { get; set; }

    [Parameter]
    public EventCallback<int> RetakeGrantAttemptsChanged { get; set; }

    [Parameter]
    public bool ResetCooldownTimerOnRetakeGrant { get; set; }

    [Parameter]
    public EventCallback<bool> ResetCooldownTimerOnRetakeGrantChanged { get; set; }

    [Parameter]
    public EventCallback OnGrantRetake { get; set; }

    [Parameter]
    public IReadOnlyList<RetakeGrantView> RetakeGrants { get; set; } = [];

    [Parameter]
    public Func<Guid, int, int> GetRetakeGrantDraft { get; set; } = (_, fallback) => fallback;

    [Parameter]
    public Action<Guid, string?> SetRetakeGrantDraft { get; set; } = (_, _) => { };

    [Parameter]
    public EventCallback<RetakeGrantView> OnUpdateRetakeGrant { get; set; }

    [Parameter]
    public EventCallback<RetakeGrantView> OnRevokeRetakeGrant { get; set; }
}
