@using Lms.Domain.Entities

<section class="card" id="admin-user-management">
    <h2>User Management</h2>

    @if (!string.IsNullOrWhiteSpace(UserError))
    {
        <p class="auth-error">@UserError</p>
    }

    <EditForm Model="NewUser" OnValidSubmit="OnCreateUser">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-field">
            <label>Email</label>
            <InputText @bind-Value="NewUser.Email" />
        </div>
        <div class="form-field">
            <label>Display Name</label>
            <InputText @bind-Value="NewUser.DisplayName" />
        </div>
        <div class="form-field">
            <label>Password</label>
            <InputText @bind-Value="NewUser.Password" type="password" />
        </div>
        <div class="form-field">
            <label>Role</label>
            <InputSelect @bind-Value="NewUser.Role">
                @foreach (var role in Roles)
                {
                    <option value="@role">@role</option>
                }
            </InputSelect>
        </div>
        <button type="submit">Create user</button>
    </EditForm>

    @if (Users.Count == 0)
    {
        <p class="muted-text">No users found.</p>
    }
    else
    {
        <table class="simple-table">
            <thead>
                <tr>
                    <th>Display</th>
                    <th>Role</th>
                    <th>State</th>
                    <th>Florida equivalent</th>
                    <th>Email</th>
                    <th>Password Expires</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Users)
                {
                    <tr>
                        <td>@user.DisplayName</td>
                        <td>
                            <select value="@user.Role" @onchange="@(args => ChangeRoleAsync(user.Id, args.Value?.ToString() ?? user.Role))">
                                @foreach (var role in Roles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                        </td>
                        <td>@(user.State ?? "-")</td>
                        <td>@GetLicenseCategory(user)</td>
                        <td>@user.Email</td>
                        <td>@(user.PasswordExpiresAt?.ToString("u") ?? "Not set")</td>
                        <td>@(user.IsActive ? "Active" : "Inactive")</td>
                        <td>
                            <div class="action-stack">
                                <button type="button" @onclick="() => OnToggleUser.InvokeAsync(user.Id)">
                                    @(user.IsActive ? "Disable" : "Enable")
                                </button>
                                <input
                                    type="password"
                                    placeholder="New password"
                                    value="@GetResetPassword(user.Id)"
                                    @oninput="@(args => SetResetPassword(user.Id, args.Value?.ToString() ?? string.Empty))" />
                                <button type="button" @onclick="() => OnResetPassword.InvokeAsync(user.Id)">Reset Password</button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="7">
                            <details>
                                <summary>License compliance</summary>
                                <div class="form-grid">
                                    @{ var education = LicenseEducationRules.CalculateForState(user.State, user.InitialLicensureDate, user.PostlicensingCompletedAt, user.ContinuingEducationDueDate, user.LicenseRenewalDueDate, DateTime.UtcNow); }
                                    <div class="form-field">
                                        <label>Education phase</label>
                                        <strong>@education.Phase@(education.IsPostlicensingOverdue ? " (overdue)" : string.Empty)</strong>
                                        @if (education.ElapsedDays.HasValue)
                                        {
                                            <small class="muted-text">@education.ElapsedDays days elapsed</small>
                                        }
                                    </div>
                                    <div class="form-field"><label>Expected post-license date</label><span>@(education.ExpectedPostlicensingDate?.ToString("yyyy-MM-dd") ?? "Not set")</span></div>
                                    <div class="form-field"><label>Expected CE date</label><span>@(education.ExpectedContinuingEducationDate?.ToString("yyyy-MM-dd") ?? "Set CE or renewal due date")</span></div>
                                    <div class="form-field">
                                        <label>License status</label>
                                        <select value="@user.LicenseStatus" @onchange="args => SetLicenseStatus(user, args.Value?.ToString())">
                                            <option value="">Not set</option>
                                            <option value="Provisional Broker (PB)">Provisional Broker (PB)</option>
                                            <option value="Broker (B)">Broker (B)</option>
                                            <option value="BIC Eligible">Broker-in-Charge (BIC) Eligible</option>
                                            <option value="Designated BIC">Designated Broker-in-Charge (BIC)</option>
                                        </select>
                                    </div>
                                    <div class="form-field"><label>Initial licensure</label><InputDate @bind-Value="user.InitialLicensureDate" /></div>
                                    <div class="form-field"><label>Postlicensing completed</label><InputDate @bind-Value="user.PostlicensingCompletedAt" /></div>
                                    <div class="form-field"><label>Brokerage experience started</label><InputDate @bind-Value="user.BrokerageExperienceStartDate" /></div>
                                    <div class="form-field"><label>BIC course completed</label><InputDate @bind-Value="user.BicCourseCompletedAt" /></div>
                                    <div class="form-field"><label>BIC eligible date</label><InputDate @bind-Value="user.BicEligibleAt" /></div>
                                    <div class="form-field"><label>BIC designation date</label><InputDate @bind-Value="user.BicDesignationAt" /></div>
                                    <div class="form-field"><label>Continuing education due</label><InputDate @bind-Value="user.ContinuingEducationDueDate" /></div>
                                    <div class="form-field"><label>License renewal due</label><InputDate @bind-Value="user.LicenseRenewalDueDate" /></div>
                                    <div class="form-field">
                                        <label>Renewal date source</label>
                                        <select @bind="user.LicenseRenewalDueDateSource">
                                            <option value="Unknown">Unknown</option>
                                            <option value="Derived">Derived (soft reminder)</option>
                                            <option value="Authoritative">Authoritative (hard reminder)</option>
                                        </select>
                                    </div>
                                    <div class="form-field"><label>BIC Update Course due</label><InputDate @bind-Value="user.BicUpdateCourseDueDate" /></div>
                                </div>
                                <button type="button" @onclick="() => OnSaveLicenseCompliance.InvokeAsync(user)">Save license compliance</button>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    [Parameter]
    public string? UserError { get; set; }

    [Parameter, EditorRequired]
    public AdminCreateUserModel NewUser { get; set; } = new();

    [Parameter]
    public EventCallback OnCreateUser { get; set; }

    [Parameter]
    public IReadOnlyList<UserAccount> Users { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> Roles { get; set; } = [];

    [Parameter]
    public Func<Guid, string> GetResetPassword { get; set; } = _ => string.Empty;

    [Parameter]
    public Action<Guid, string> SetResetPassword { get; set; } = (_, _) => { };

    [Parameter]
    public EventCallback<Guid> OnToggleUser { get; set; }

    [Parameter]
    public EventCallback<Guid> OnResetPassword { get; set; }

    [Parameter]
    public Func<Guid, string, Task> ChangeRole { get; set; } = (_, _) => Task.CompletedTask;

    [Parameter]
    public EventCallback<UserAccount> OnSaveLicenseCompliance { get; set; }

    private Task ChangeRoleAsync(Guid userId, string role)
    {
        return ChangeRole(userId, role);
    }

    private static void SetLicenseStatus(UserAccount user, string? status)
    {
        user.LicenseStatus = string.IsNullOrWhiteSpace(status) ? null : status;
        user.IsBicEligible = status is "BIC Eligible" or "Designated BIC";
    }

    private static string GetLicenseCategory(UserAccount user)
    {
        var category = DistanceLearningProfileCatalog.ToDisplayLicenseCategory(user.State, user.LicenseType);
        return string.IsNullOrWhiteSpace(category) ? "-" : category;
    }
}
