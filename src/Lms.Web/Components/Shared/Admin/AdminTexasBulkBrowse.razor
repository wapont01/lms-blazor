@implements IAsyncDisposable
@using Lms.Web.Services
@inject TexasBulkBrowseService Browser
@inject ILogger<AdminTexasBulkBrowse> Logger

<section class="card bulk-browse" aria-label="Texas bulk license browser">
    <h2>Browse bulk licenses</h2>
    <fieldset disabled="@(_loading || !_interactive)">
        <legend class="muted-text">Filters apply to the full completed Texas archive, including non-active licenses.</legend>
        <label>License type
            <select aria-label="Texas bulk license type" @bind="_type">
                <option value="">All license types</option>
                <option>Broker Individual</option><option>Sales Agent</option><option>Broker Company</option>
            </select>
        </label>
        <label>County <input aria-label="Texas bulk county" @bind="_county" maxlength="50" /></label>
        <label>Name or license <input aria-label="Texas bulk name or license" @bind="_name" maxlength="100" /></label>
        <label>Published status <input aria-label="Texas bulk published status" @bind="_status" maxlength="40" /></label>
    </fieldset>
    <button type="button" class="secondary-btn" @onclick="SearchAsync" disabled="@(_loading || !_interactive)">@(_loading ? "Searching..." : "Search Texas bulk licenses")</button>
    @if (_error is not null) { <p role="alert" class="auth-error">@_error</p> }
    @if (_searched && !_loading && _result is null && _error is null)
    { <p>No completed Texas collection is available. Collect or import an archive first.</p> }
    @if (_result is { } result)
    {
        <p role="status">@result.Total.ToString("N0") matching licenses - snapshot @result.SnapshotId</p>
        <div class="table-wrap">
            <table aria-label="Filtered Texas bulk licenses">
                <thead><tr><th>Name</th><th>License</th><th>Type</th><th>Published status</th><th>Expires</th><th>County</th><th>Related license</th><th>Relationship started</th><th>Designated supervisor</th></tr></thead>
                <tbody>
                    @foreach (var row in result.Records)
                    {
                        <tr><td>@row.Name</td><th scope="row">@row.Number</th><td>@row.Type</td><td>@row.Status</td><td>@row.ExpirationDate</td><td>@row.County</td><td>@row.RelatedName @row.RelatedNumber</td><td>@row.RelatedDate</td><td>@(row.Supervisor ? "Yes" : "No")</td></tr>
                    }
                    @if (result.Records.Count == 0) { <tr><td colspan="9">No licenses match these filters.</td></tr> }
                </tbody>
            </table>
        </div>
        <nav aria-label="Texas bulk pages">
            <button type="button" class="secondary-btn" @onclick="PreviousAsync" disabled="@(_loading || result.Page == 0)">Previous Texas bulk records</button>
            <span>Page @(result.Page + 1) of @Math.Max(1, (result.Total + TexasBulkBrowseService.PageSize - 1) / TexasBulkBrowseService.PageSize)</span>
            <button type="button" class="secondary-btn" @onclick="NextAsync" disabled="@(_loading || ((long)result.Page + 1) * TexasBulkBrowseService.PageSize >= result.Total)">Next Texas bulk records</button>
        </nav>
    }
    <p class="muted-text">County matches exactly; name, license and status use contains matching, ignoring case. Source license numbers retain suffixes and leading zeros. This is the last collected archive, not a restored version.</p>
</section>

@code {
    private readonly CancellationTokenSource _stop = new();
    private string _type = "", _county = "", _name = "", _status = "";
    private bool _loading, _interactive, _searched;
    private string? _error;
    private TexasBulkBrowseResult? _result;
    private TexasBulkBrowseQuery? _applied;
    private Task? _search;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { _interactive = true; StateHasChanged(); }
    }
    private Task SearchAsync() => _search = LoadAsync(new(_type, _county, _name, _status));
    private Task PreviousAsync() => _search = LoadAsync(_applied! with { Page = Math.Max(0, _result!.Page - 1) });
    private Task NextAsync() => _search = LoadAsync(_applied! with { Page = _result!.Page + 1 });
    private async Task LoadAsync(TexasBulkBrowseQuery query)
    {
        if (_loading) return;
        _loading = true; _searched = true; _error = null; _result = null; _applied = query;
        try { _result = await Browser.GetAsync(query, _stop.Token); }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception exception) when (exception is IOException or InvalidOperationException or ArgumentException)
        {
            Logger.LogError(exception, "Texas archive search failed");
            _error = "Texas archive could not be searched. Try again or inspect collection status.";
        }
        finally { _loading = false; }
    }
    public async ValueTask DisposeAsync()
    {
        _stop.Cancel();
        if (_search is not null) await _search;
        _stop.Dispose();
    }
}
