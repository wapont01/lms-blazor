@implements IAsyncDisposable
@using Lms.Web.Services
@inject CaliforniaBulkBrowseService Browser
@inject ILogger<AdminCaliforniaBulkBrowse> Logger

<section class="card bulk-browse" aria-label="California bulk license browser">
    <h2>Browse bulk licenses</h2>
    <fieldset disabled="@(_loading || !_interactive)">
        <legend class="muted-text">Browse the last collected DRE licensee roster's roles and relationships; totals are not unique-person counts. Examinee lists are excluded.</legend>
        <label>License role
            <select aria-label="California bulk license role" @bind="_type">
                <option value="">All roles</option>
                <option>Broker</option><option>Salesperson</option><option>Officer</option><option>Corporation</option>
            </select>
        </label>
        <label>Name or license <input aria-label="California bulk name or license" @bind="_name" maxlength="100" /></label>
        <label>Published status <input aria-label="California bulk published status" @bind="_status" maxlength="40" /></label>
    </fieldset>
    <button type="button" class="secondary-btn" @onclick="SearchAsync" disabled="@(_loading || !_interactive)">@(_loading ? "Searching..." : "Search California bulk licenses")</button>
    @if (_error is not null) { <p role="alert" class="auth-error">@_error</p> }
    @if (_searched && !_loading && _result is null && _error is null)
    { <p>No completed California bulk collection is available.</p> }
    @if (_result is { } result)
    {
        <p role="status">@result.Total.ToString("N0") matching role records - snapshot @result.SnapshotId</p>
        <div class="table-wrap">
            <table aria-label="Filtered California bulk licenses">
                <thead><tr><th>Name</th><th>License</th><th>Role</th><th>DRE status</th><th>Effective date</th><th>Expiration date</th><th>Original license date</th><th>Related license</th><th>Broker-associate relationships</th><th>Licensee record marker</th><th>Restriction flag</th><th>Next-renewal CE scope</th></tr></thead>
                <tbody>
                    @foreach (var row in result.Records)
                    {
                        <tr><td>@row.Name</td><th scope="row">@row.LicenseNumber</th><td>@row.LicenseType @if (row.LicenseLevel == "Broker Associate") { <span>(associate)</span> }</td><td>@row.LicenseStatus</td><td>@(row.LicenseIssuedDate?.ToString("yyyy-MM-dd") ?? "Not reported")</td><td>@(row.LicenseRenewalDate?.ToString("yyyy-MM-dd") ?? "Not reported")</td><td>@(row.OriginalLicenseDate?.ToString("yyyy-MM-dd") ?? "Not reported")</td><td>@row.RelatedLicenseType @row.RelatedLicenseNumber @row.RelatedLicenseName</td>
                            <td>@if (row.LicenseType == "Broker")
                                { @foreach (var relation in result.AssociateRelationships.Where(r => r.AssociateNumber == row.LicenseNumber))
                                    { <div>@relation.ResponsibleType @relation.ResponsibleNumber @relation.ResponsibleName (since @relation.StartedAt?.ToString("yyyy-MM-dd"))</div> } }
                            </td>
                            <td>@(row.IsAdditionalLicenseRecord switch { true => "Earlier record exists (Y)", false => "First/only record (N)", null => "Not published in primary list" })</td><td>@(row.IsRestricted ? "Flagged (Y)" : "No Y flag")</td><td>@(row.EthicsAndAgencyOnly ? "Ethics, Agency, Trust Fund & Fair Housing only (Y)" : "No Y flag")</td></tr>
                    }
                    @if (result.Records.Count == 0) { <tr><td colspan="12">No licenses match these filters.</td></tr> }
                </tbody>
            </table>
        </div>
        <nav aria-label="California bulk pages">
            <button type="button" class="secondary-btn" @onclick="PreviousAsync" disabled="@(_loading || result.Page == 1)">Previous California bulk records</button>
            <span>Page @result.Page of @Math.Max(1, (result.Total + CaliforniaBulkBrowseService.PageSize - 1) / CaliforniaBulkBrowseService.PageSize)</span>
            <button type="button" class="secondary-btn" @onclick="NextAsync" disabled="@(_loading || (long)result.Page * CaliforniaBulkBrowseService.PageSize >= result.Total)">Next California bulk records</button>
        </nav>
    }
    <p class="muted-text">Name/license and status use contains matching, ignoring case. Multiple roles under one eight-digit license stay separate. Broker-associate-only source rows have no inferred status or licensee record marker. This is the last collected version, not a restored version.</p>
    <details>
        <summary>DRE field meanings (RE 776)</summary>
        <p><strong>Status:</strong> Licensed means a salesperson is affiliated with a responsible broker, a broker or corporation has a business address on file, or an officer is affiliated with a corporation. Licensed NBA means a salesperson has no broker affiliation, or a broker or corporation has no business address on file.</p>
        <p><strong>Related license:</strong> For Licensed records, a salesperson points to a responsible broker, an officer to an affiliated corporation, and a corporation to its designated officer. Related fields may be blank.</p>
        <p><strong>Licensee record marker:</strong> N marks the first or only record for that licensee; Y means at least one earlier record for that licensee was already written in the file.</p>
        <p><strong>Flags:</strong> Restricted Y means the license is restricted. Ethics_and_Agency_Ind Y means the next renewal requires only Ethics, Agency, Trust Fund, and Fair Housing continuing education.</p>
        <p><strong>Broker-associate relationships:</strong> The separate file contains current affiliations only, and a broker-associate may have more than one responsible broker.</p>
    </details>
</section>

@code {
    private readonly CancellationTokenSource _stop = new();
    private string _type = "", _name = "", _status = "";
    private bool _loading, _interactive, _searched;
    private string? _error;
    private CaliforniaBulkBrowseResult? _result;
    private CaliforniaBulkBrowseQuery? _applied;
    private Task? _search;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { _interactive = true; StateHasChanged(); }
    }
    private Task SearchAsync() => _search = LoadAsync(new(_type, _name, _status));
    private Task PreviousAsync() => _search = LoadAsync(_applied! with { Page = _result!.Page - 1 });
    private Task NextAsync() => _search = LoadAsync(_applied! with { Page = _result!.Page + 1 });
    private async Task LoadAsync(CaliforniaBulkBrowseQuery query)
    {
        if (_loading) return;
        _loading = true; _searched = true; _error = null; _result = null; _applied = query;
        try { _result = await Browser.GetAsync(query, _stop.Token); }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception exception) when (exception is System.Data.Common.DbException or InvalidOperationException or ArgumentException or IOException or InvalidDataException)
        {
            Logger.LogError(exception, "California roster search failed");
            _error = "California roster could not be searched. Try again or inspect collection status.";
        }
        finally { _loading = false; }
    }
    public async ValueTask DisposeAsync()
    {
        _stop.Cancel();
        if (_search is not null) await _search;
        _stop.Dispose();
    }
}
