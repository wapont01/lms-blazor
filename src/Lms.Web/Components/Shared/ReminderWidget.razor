@using Lms.Application.Services
@using Lms.Domain.Entities
@using System.Security.Claims
@attribute [Authorize(Roles = "Learner")]
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="reminder-widget card">
	<div class="widget-header">
		<h3>Course Reminders</h3>
		@if (_unreadReminderCount > 0)
		{
			<span class="reminder-badge">@_unreadReminderCount</span>
		}
	</div>

	<div class="widget-content">
		@if (_isLoading)
		{
			<p class="muted-text">Loading reminders...</p>
		}
		else if (_reminders.Count == 0)
		{
			<p class="muted-text">No reminders at this time.</p>
		}
		else
		{
			<ul class="reminder-list">
				@foreach (var reminder in _reminders)
				{
					<li class="reminder-item @GetReminderClass(reminder)">
						<div class="reminder-content">
							<div class="reminder-title">@reminder.Title</div>
							<div class="reminder-message">@reminder.Message</div>
							<div class="reminder-meta">
								<span class="reminder-time">@GetRelativeTime(reminder.CreatedAt)</span>
								@if (reminder.ReadAt == null)
								{
									<span class="reminder-unread-indicator">●</span>
								}
							</div>
						</div>
						<button class="reminder-action-btn" @onclick="() => MarkAsReadAsync(reminder.Id)" disabled="@(reminder.ReadAt.HasValue)">
							@(reminder.ReadAt.HasValue ? "Read" : "Mark read")
						</button>
					</li>
				}
			</ul>

			@if (_showMarkAllRead)
			{
				<div class="widget-footer">
					<button class="secondary-btn" @onclick="MarkAllAsReadAsync">Mark all as read</button>
				</div>
			}
		}
	</div>

	<div class="widget-footer-link">
		<a href="/notifications">View all notifications →</a>
	</div>
</div>

@code {
	private List<SystemNotification> _reminders = new();
	private Guid _userId;
	private bool _isLoading = true;
	private int _unreadReminderCount = 0;
	private bool _showMarkAllRead = false;

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;

		var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
		if (Guid.TryParse(idClaim, out var parsedId))
		{
			_userId = parsedId;
			await LoadRemindersAsync();
		}

		_isLoading = false;
	}

	private async Task LoadRemindersAsync()
	{
		// Load unread reminders only, limited to 5
		_reminders = await NotificationService.GetForUserAsync(_userId, unreadOnly: true, take: 5);
		_unreadReminderCount = _reminders.Count;
		_showMarkAllRead = _reminders.Count > 1;
	}

	private async Task MarkAsReadAsync(Guid reminderId)
	{
		await NotificationService.MarkAsReadAsync(_userId, reminderId);
		await LoadRemindersAsync();
	}

	private async Task MarkAllAsReadAsync()
	{
		var unreadReminders = _reminders.Where(r => r.ReadAt == null).ToList();
		foreach (var reminder in unreadReminders)
		{
			await NotificationService.MarkAsReadAsync(_userId, reminder.Id);
		}
		await LoadRemindersAsync();
	}

	private string GetReminderClass(SystemNotification reminder)
	{
		return reminder.Category switch
		{
			"due-date" => "reminder-due-date",
			"course-reminder" => "reminder-course",
			"assessment" => "reminder-assessment",
			_ => "reminder-default"
		};
	}

	private string GetRelativeTime(DateTime createdAt)
	{
		var now = DateTime.UtcNow;
		var diff = now - createdAt;

		if (diff.TotalMinutes < 1)
			return "Just now";
		if (diff.TotalMinutes < 60)
			return $"{(int)diff.TotalMinutes}m ago";
		if (diff.TotalHours < 24)
			return $"{(int)diff.TotalHours}h ago";
		if (diff.TotalDays < 7)
			return $"{(int)diff.TotalDays}d ago";

		return createdAt.ToString("MMM d");
	}
}

<style>
	.reminder-widget {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 400px;
	}

	.widget-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.widget-header h3 {
		margin: 0;
		font-size: 1.1rem;
	}

	.reminder-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
		background-color: #ff4444;
		color: white;
		border-radius: 50%;
		font-size: 0.75rem;
		font-weight: bold;
	}

	.widget-content {
		min-height: 100px;
	}

	.reminder-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.reminder-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.75rem;
		border-left: 4px solid #cccccc;
		background-color: #f9f9f9;
		border-radius: 4px;
		transition: all 0.2s;
	}

	.reminder-item.reminder-due-date {
		border-left-color: #ff6b6b;
	}

	.reminder-item.reminder-course {
		border-left-color: #4a90e2;
	}

	.reminder-item.reminder-assessment {
		border-left-color: #f5a623;
	}

	.reminder-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.reminder-title {
		font-weight: 600;
		font-size: 0.95rem;
		color: #333;
	}

	.reminder-message {
		font-size: 0.85rem;
		color: #666;
		line-height: 1.3;
	}

	.reminder-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		color: #999;
	}

	.reminder-unread-indicator {
		color: #ff4444;
		font-size: 1rem;
		line-height: 1;
	}

	.reminder-action-btn {
		padding: 0.35rem 0.75rem;
		font-size: 0.8rem;
		white-space: nowrap;
		border: 1px solid #ddd;
		background: white;
		border-radius: 4px;
		cursor: pointer;
		transition: all 0.2s;
	}

	.reminder-action-btn:hover:not(:disabled) {
		background: #f0f0f0;
		border-color: #999;
	}

	.reminder-action-btn:disabled {
		opacity: 0.6;
		cursor: default;
	}

	.widget-footer {
		display: flex;
		justify-content: center;
		padding-top: 0.5rem;
		border-top: 1px solid #eee;
	}

	.widget-footer-link {
		text-align: center;
		padding-top: 0.5rem;
		border-top: 1px solid #eee;
	}

	.widget-footer-link a {
		color: #4a90e2;
		text-decoration: none;
		font-size: 0.9rem;
		transition: color 0.2s;
	}

	.widget-footer-link a:hover {
		color: #2e5c8a;
		text-decoration: underline;
	}

	.muted-text {
		color: #999;
		font-size: 0.9rem;
		margin: 0;
	}
</style>
