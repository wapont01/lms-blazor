@page "/account"
@attribute [Authorize]
@using System.Security.Claims
@using Lms.Application.Services
@inject IUserAccountService UserAccountService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment Environment
@inject EmailJourneyOptions EmailJourney
@inject IRosterRegistrationService Roster
@inject ILogger<Account> Logger

<PageTitle>Account</PageTitle>

<div class="account-page">
<header class="account-heading">
    <h1>Account</h1>
    <p>Manage your license profile, security and email preferences.</p>
</header>

<section class="account-identity" aria-label="Account details">
    <div>
        <strong>@_displayName</strong>
        <span>@_email</span>
    </div>
    <span class="email-status @(_emailVerified ? "is-verified" : "")">Email @(_emailVerified ? "verified" : "not verified")</span>
</section>

@if (_showLicenseRecords)
{
    <section class="card license-profile" aria-label="License Profile">
        <header class="license-profile-header">
            <h2>License Profile</h2>
            @if (_licenseRequests.Count > 0)
            {
                <a href="/roster-registration">Add another license</a>
            }
        </header>
        <p>Keep all your professional licenses on this account. Confirming a current, active instructor license enables instructor tools without changing your existing access.</p>
        @if (_licenseError is not null)
        {
            <p class="auth-error" role="alert">@_licenseError</p>
            <button type="button" class="secondary-button" @onclick="LoadLicenseProfilesAsync">Retry</button>
        }
        else if (_licenseRequests.Count == 0)
        {
            <div class="license-empty">
                <div>
                    <span class="review-status">Not added</span>
                    <h3>Add your professional license</h3>
                    <p>Find your record, review the details and confirm to save it here.</p>
                </div>
                <a class="account-primary-link" href="/roster-registration">Find my license record</a>
            </div>
            <ol class="license-steps" aria-label="Adding your license">
                <li><strong>Find</strong><span>Search by state and license number.</span></li>
                <li><strong>Confirm</strong><span>Review your details. Verified email is required.</span></li>
                <li><strong>Save</strong><span>Your confirmed record appears in your license profile.</span></li>
            </ol>
        }
        @foreach (var request in _licenseRequests)
        {
            var record = request.Selection;
            <article class="license-record" aria-label="@($"{record.State} license {record.LicenseNumber}")">
                <div class="association-state @(request.Status == "Confirmed" ? "is-approved" : request.Status == "Rejected" ? "is-rejected" : "is-pending")">
                    <span class="review-status">@(request.Status == "Confirmed" ? "Confirmed by licensee" : request.Status == "Pending" ? "Email verification required" : request.Status == "Approved" ? "Previously approved" : "Association Rejected")</span>
                    <p>@(request.Status == "Confirmed" ? "You confirmed this license record. Commission information is shown below."
                        : request.Status == "Pending" ? "Your selection is saved. Verify your email to finish confirming it."
                        : request.Status == "Approved" ? "This association was approved under the previous review policy."
                        : "There is an issue with this association. See the note below.")</p>
                    <span class="saved-date">Saved @request.SubmittedAtUtc.ToString("MMM d, yyyy")</span>
                </div>
                <LicenseRecordView Record="record" />
                @if (!string.IsNullOrWhiteSpace(request.ReviewNote))
                {
                    <p class="review-note"><strong>Review note:</strong> @request.ReviewNote</p>
                }
            </article>
        }
    </section>
}

<div class="dashboard-grid">
    @if (_isInstructor)
    {
        <section class="card auth-card">
            <h2>Instructor Profile</h2>

            @if (!string.IsNullOrWhiteSpace(_profileMessage))
            {
                <p class="auth-help">@_profileMessage</p>
            }

            @if (!string.IsNullOrWhiteSpace(_profileError))
            {
                <p class="auth-error">@_profileError</p>
            }

            <EditForm Model="_profileModel" OnValidSubmit="SaveInstructorProfileAsync" FormName="instructor-profile-form">
                <AntiforgeryToken />
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-field">
                    <label for="instructor-profile-license">License number</label>
                    <InputText id="instructor-profile-license" @bind-Value="_profileModel.LicenseNumber" />
                </div>
                <div class="form-field">
                    <label for="instructor-profile-email">Email</label>
                    <InputText id="instructor-profile-email" type="email" @bind-Value="_profileModel.Email" />
                </div>
                <div class="form-field">
                    <label for="instructor-profile-phone">Phone</label>
                    <InputText id="instructor-profile-phone" type="tel" @bind-Value="_profileModel.PhoneNumber" />
                </div>
                <div class="form-field">
                    <label for="instructor-profile-address">Permanent address</label>
                    <InputTextArea id="instructor-profile-address" rows="3" @bind-Value="_profileModel.PermanentAddress" />
                </div>

                <button type="submit">Save Profile</button>
            </EditForm>
        </section>
    }

    <section class="card auth-card">
        <h2>Change Password</h2>
        <p class="settings-description">Keep your sign-in secure with a unique password.</p>

        @if (_forceChangeRequired)
        {
            <p class="auth-error">Your password was reset by an administrator. You must set a new password to continue.</p>
        }

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="auth-help">@_message</p>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="auth-error">@_error</p>
        }

        <EditForm Model="_model" OnValidSubmit="ChangePasswordAsync" FormName="change-password-form">
            <AntiforgeryToken />
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-field">
                <label for="account-current-password">Current Password</label>
                <InputText id="account-current-password" @bind-Value="_model.CurrentPassword" type="password" autocomplete="current-password" />
            </div>
            <div class="form-field">
                <label for="account-new-password">New Password</label>
                <InputText id="account-new-password" @bind-Value="_model.NewPassword" type="password" autocomplete="new-password" />
            </div>
            <div class="form-field">
                <label for="account-confirm-password">Confirm New Password</label>
                <InputText id="account-confirm-password" @bind-Value="_model.ConfirmNewPassword" type="password" autocomplete="new-password" />
            </div>

            <button type="submit">Update Password</button>
        </EditForm>
    </section>

    <section class="card auth-card">
        <h2>Email Preferences</h2>
        <p class="settings-description">Choose which course updates you receive.</p>

        @if (!string.IsNullOrWhiteSpace(_marketingMessage))
        {
            <p class="auth-help">@_marketingMessage</p>
        }

        <EditForm Model="_marketingModel" OnValidSubmit="UpdateMarketingPreferenceAsync" FormName="marketing-pref-form">
            <AntiforgeryToken />
            <div class="form-field">
                <label class="marketing-choice">
                    <InputCheckbox @bind-Value="_marketingModel.OptIn" style="width:auto;" />
                    Send me course recommendations and license-deadline alerts by email
                </label>
                <small>Transactional messages about your purchases and account are always sent.</small>
            </div>
            <button type="submit">Save Preference</button>
        </EditForm>
    </section>
</div>
</div>

@code {
    private string _displayName = "";
    private string _email = "";
    private bool _emailVerified;
    private Guid? _userId;
    private string? _message;
    private string? _error;
    private string? _profileMessage;
    private string? _profileError;
    private string? _marketingMessage;
    private bool _isInstructor;
    private bool _showLicenseRecords;
    private List<RosterRequestRow> _licenseRequests = [];
    private string? _licenseError;
    private bool _forceChangeRequired;
    private InstructorProfileModel _profileModel { get; set; } = new();
    private MarketingPreferenceModel _marketingModel = new();
    [SupplyParameterFromForm(FormName = "change-password-form")]
    private ChangePasswordModel _model { get; set; } = new();

    [SupplyParameterFromForm(FormName = "marketing-pref-form")]
    private MarketingPreferenceModel? MarketingForm { get; set; }

    [SupplyParameterFromQuery]
    public string? ForceChange { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _showLicenseRecords = (authState.User.IsInRole("Learner") || authState.User.IsInRole("Broker") || authState.User.IsInRole("Instructor"))
            && Environment.IsDevelopment() && EmailJourney.Enabled;
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (Guid.TryParse(userIdClaim, out var parsedUserId))
        {
            _userId = parsedUserId;
            var account = await UserAccountService.GetByIdAsync(parsedUserId);
            _displayName = account?.DisplayName ?? "";
            _email = account?.Email ?? "";
            _emailVerified = account?.EmailVerifiedAtUtc is not null;
            if (_showLicenseRecords) await LoadLicenseProfilesAsync();
            // Added instructor licenses must not overwrite a broker's primary license.
            _isInstructor = account?.Role == "Instructor";
            if (MarketingForm is not null)
            {
                _marketingModel = MarketingForm;
            }
            else
            {
                _marketingModel.OptIn = account?.MarketingEmailOptOutAtUtc is null;
            }

            if (_isInstructor)
            {
                var user = await UserAccountService.GetByIdAsync(parsedUserId);
                if (user is not null)
                {
                    _profileModel = new InstructorProfileModel
                    {
                        Email = user.Email,
                        LicenseNumber = user.LicenseNumber,
                        PhoneNumber = user.PhoneNumber,
                        PermanentAddress = user.PermanentAddress
                    };
                }
            }
        }

        _forceChangeRequired = string.Equals(ForceChange, "1", StringComparison.Ordinal);
    }

    private async Task LoadLicenseProfilesAsync()
    {
        if (!_userId.HasValue) return;
        _licenseError = null;
        try
        {
            _licenseRequests = await Roster.GetMineAsync(_userId.Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Account license profiles could not be loaded.");
            _licenseError = "Your license details could not be loaded. Please try again.";
        }
    }

    private async Task UpdateMarketingPreferenceAsync()
    {
        _marketingMessage = null;
        if (!_userId.HasValue)
        {
            return;
        }

        await UserAccountService.SetMarketingEmailPreferenceAsync(_userId.Value, _marketingModel.OptIn);
        _marketingMessage = _marketingModel.OptIn
            ? "You will receive course recommendations and deadline alerts."
            : "You are opted out of marketing email.";
    }

    private async Task SaveInstructorProfileAsync()
    {
        _profileMessage = null;
        _profileError = null;
        if (!_userId.HasValue)
        {
            _profileError = "Unable to identify your account.";
            return;
        }

        try
        {
            var updated = await UserAccountService.UpdateInstructorProfileAsync(
                _userId.Value,
                _profileModel.Email,
                _profileModel.LicenseNumber,
                _profileModel.PhoneNumber,
                _profileModel.PermanentAddress);
            _profileModel.Email = updated.Email;
            _profileModel.LicenseNumber = updated.LicenseNumber;
            _profileModel.PhoneNumber = updated.PhoneNumber;
            _profileModel.PermanentAddress = updated.PermanentAddress;
            _profileMessage = "Instructor profile updated successfully.";
        }
        catch (InvalidOperationException exception)
        {
            _profileError = exception.Message;
        }
    }

    private async Task ChangePasswordAsync()
    {
        _message = null;
        _error = null;

        if (!_userId.HasValue)
        {
            _error = "Unable to identify your account.";
            return;
        }

        if (!string.Equals(_model.NewPassword, _model.ConfirmNewPassword, StringComparison.Ordinal))
        {
            _error = "New password and confirmation do not match.";
            return;
        }

        try
        {
            await UserAccountService.ChangePasswordAsync(_userId.Value, _model.CurrentPassword, _model.NewPassword);
            _model = new ChangePasswordModel();
            _message = "Password updated successfully.";
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
    }

    private sealed class ChangePasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string CurrentPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MinLength(8)]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }

    private sealed class MarketingPreferenceModel
    {
        public bool OptIn { get; set; } = true;
    }

    private sealed class InstructorProfileModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(40)]
        public string? LicenseNumber { get; set; }

        [System.ComponentModel.DataAnnotations.StringLength(40)]
        public string? PhoneNumber { get; set; }

        [System.ComponentModel.DataAnnotations.StringLength(500)]
        public string? PermanentAddress { get; set; }
    }
}
