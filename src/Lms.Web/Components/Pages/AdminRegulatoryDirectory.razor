@page "/admin/regulatory-directory"
@attribute [Authorize(Roles = "Admin")]
@using System.Security.Claims
@using System.Text.Json
@using Lms.Application.Services
@using Lms.Domain.Entities
@using Lms.Web.Services
@inject IRegulatoryDirectoryService RegulatoryDirectoryService
@inject ColoradoDoraDisplaySelectionStore ColoradoDoraSelectionStore
@inject IUserAccountService UserAccountService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<AdminRegulatoryDirectory> Logger
@implements IDisposable

<PageTitle>Regulatory Directory</PageTitle>

<div class="page-header-row">
    <div>
        <h1>Regulatory Directory</h1>
        <p class="muted-text">Licensing snapshots · updates automatically</p>
            <a class="secondary-btn" href="/admin/regulatory-statistics">State collection statistics</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <p class="@(_hasError ? "auth-error" : "auth-help")">@_message</p>
}

<Lms.Web.Components.Shared.Admin.AdminRosterRequestsPanel />

<section class="card">
    <select aria-label="Bulk roster state" @bind="_bulkState">
        <option>Florida</option><option>Texas</option><option>California</option><option>Colorado</option><option>Nevada</option><option>New York</option><option>Arizona</option><option>Connecticut</option><option>Oregon</option><option>Delaware</option><option>Virginia</option><option>Illinois</option><option>Michigan</option><option>West Virginia</option><option>Maine</option><option>Vermont</option><option>Montana</option>
    </select>
</section>
@if (_bulkState == "Montana")
{
    <Lms.Web.Components.Shared.Admin.AdminMontanaCollection SnapshotCompleted="OnBulkSnapshotCompletedAsync" />
}
else
{
    <Lms.Web.Components.Shared.Admin.AdminFloridaBulkCollection @key="_bulkState" State="@_bulkState" SnapshotCompleted="OnBulkSnapshotCompletedAsync" />
}
<Lms.Web.Components.Shared.Admin.AdminFloridaRosterHistory @key="@($"{_bulkState}-{_rosterHistoryVersion}")" State="@_bulkState" RosterRestored="OnRosterRestoredAsync" />
@if (_bulkState == "Nevada")
{
    <Lms.Web.Components.Shared.Admin.AdminNevadaBulkBrowse @key="_rosterHistoryVersion" />
}

<section class="card">
    <details>
        <summary>Colorado DORA types shown in LMS (@_selectedColoradoTypes.Count of @ColoradoDoraLicenseTypes.DefaultEnabled.Count real-estate types enabled)</summary>
        <p class="muted-text">The full DORA source is retained in the database. Real-estate license types can be enabled for the roster directory and registration search. Other professions are listed as future options but are unavailable in the public roster for now; company records cannot be linked to individual accounts.</p>
        <div class="form-field">
            @foreach (var option in ColoradoDoraLicenseTypes.All)
            {
                <label>
                    <input type="checkbox" checked="@_selectedColoradoTypes.Contains(option.Name)"
                           @onchange="args => SetColoradoTypeEnabled(option.Name, args.Value)"
                           disabled="@(_isWorking || !option.IsRealEstate)" />
                    @option.Name (@option.Prefix)@(!option.IsRealEstate ? " — not enabled yet" : string.Empty)
                </label>
            }
        </div>
        <button type="button" class="secondary-btn" @onclick="SaveColoradoTypesAsync" disabled="@_isWorking">Save Colorado types</button>
    </details>
</section>

<section class="card" aria-label="Nevada NRED source types">
    <details>
        <summary>Nevada NRED source coverage</summary>
        <p class="muted-text">The saved September 2026 baseline retains 12 source lists: 36,904 source rows, including 32,959 numbered license records across 11 categories and 3,944 HOA source entries. These are baseline counts, not guaranteed counts for later collections. Select Nevada above for current collection, lookup and history. Admin lookup searches all numbered categories; public registration remains limited to Broker, Broker-Salesperson and Salesperson.</p>
        <p><strong>Admin-only numbered categories:</strong> Appraisal Management Company, Appraiser, Business Broker, Community Association Manager, Energy Auditor, Inspector of Structures, Property Manager, Timeshare Agent.</p>
        <p>HOA entries are retained as source evidence, not individual licenses. The separately linked historical Reserve Study Specialists workbook is not included in this active-list integration.</p>
        <a href="https://red.nv.gov/Content/Administration/Active_Licensee_Lists/" target="_blank" rel="noopener noreferrer">Open Nevada NRED Active Licensee Lists</a>
    </details>
</section>

<section class="card">
    <h2>Other sources: import normalized snapshot</h2>
    <p class="muted-text">Florida, Texas, California, Colorado, Nevada, New York, Arizona, Connecticut, Oregon, Delaware, Virginia, Illinois, Michigan, West Virginia, Maine and Vermont use the official bulk collection above. Montana accepts official CSV uploads after manual CAPTCHA completion. This normalized import remains available for other states and historical sources.</p>
    <div class="form-field">
        <label for="regulatory-snapshot-json">Normalized snapshot JSON</label>
        <textarea id="regulatory-snapshot-json" rows="14" @bind="_snapshotJson" disabled="@_isWorking"></textarea>
    </div>
    <div class="course-actions">
        <button type="button" class="btn-primary" @onclick="ImportAsync" disabled="@(_isWorking || string.IsNullOrWhiteSpace(_snapshotJson))">Import for review</button>
    </div>
</section>

<section class="card" aria-label="Regulatory snapshots">
    <h2>Snapshots</h2>
    <div class="snapshot-filters">
        <select aria-label="Snapshot state" value="@_snapshotState" @onchange="OnSnapshotStateChangedAsync" disabled="@(!_interactive)">
            <option value="">Select state</option>
            @foreach (var state in _snapshotStates)
            {
                <option value="@state">@state</option>
            }
        </select>
        <label>From <input type="date" aria-label="Snapshots retrieved from (UTC)" value="@_snapshotFrom?.ToString("yyyy-MM-dd")" @onchange="OnSnapshotFromChangedAsync" disabled="@string.IsNullOrEmpty(_snapshotState)" /></label>
        <label>To <input type="date" aria-label="Snapshots retrieved to (UTC)" value="@_snapshotTo?.ToString("yyyy-MM-dd")" @onchange="OnSnapshotToChangedAsync" disabled="@string.IsNullOrEmpty(_snapshotState)" /></label>
        @if (_snapshotFrom.HasValue || _snapshotTo.HasValue)
        {
            <button type="button" class="secondary-btn" @onclick="ClearSnapshotDatesAsync">Clear dates</button>
        }
    </div>
    @if (string.IsNullOrEmpty(_snapshotState))
    {
        <p class="muted-text">Select a state to view its snapshots.</p>
    }
    else if (_snapshots.Count == 0)
    {
        <p class="muted-text">No @_snapshotState snapshots match these filters.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Source</th>
                        <th>Retrieved</th>
                        <th>Cost</th>
                        <th>Records</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var snapshot in _snapshots)
                    {
                        <tr>
                            <td>
                                <strong>@snapshot.SourceName</strong>
                                @if (GetSafeExternalUrl(snapshot.SourceUrl) is string sourceUrl)
                                {
                                    <div><a href="@sourceUrl" target="_blank" rel="noopener noreferrer">Open source</a></div>
                                }
                                else
                                {
                                    <div class="muted-text">Source link unavailable</div>
                                }
                            </td>
                            <td>@snapshot.RetrievedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                            <td>@(snapshot.AcquisitionCost.HasValue ? $"${snapshot.AcquisitionCost.Value:F2}" : "Not recorded")</td>
                            <td>@snapshot.FirmCount.ToString("N0") firms, @snapshot.LicenseeCount.ToString("N0") licensees</td>
                            <td><span class="status-pill @GetStatusClass(snapshot.Status)">@(IsBulk(snapshot.ParserVersion) && snapshot.Status == RegulatorySnapshotStatuses.Approved ? "Synchronized" : GetStatusText(snapshot.Status))</span></td>
                            <td>
                                @if (snapshot.Status == RegulatorySnapshotStatuses.PendingReview && !IsBulk(snapshot.ParserVersion))
                                {
                                    <button type="button" class="secondary-btn" @onclick="() => ApproveAsync(snapshot.SnapshotId)" disabled="@_isWorking">Approve</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (!string.IsNullOrEmpty(_snapshotState) && _snapshotTotal > 0)
    {
        <div class="course-actions">
            <button type="button" class="secondary-btn" @onclick="() => GoToSnapshotPageAsync(_snapshotPage - 1)" disabled="@(_snapshotPage <= 1)">Previous snapshots</button>
            <span>Page @_snapshotPage of @_snapshotPageCount · @_snapshotTotal.ToString("N0") snapshot@(_snapshotTotal == 1 ? string.Empty : "s")</span>
            <button type="button" class="secondary-btn" @onclick="() => GoToSnapshotPageAsync(_snapshotPage + 1)" disabled="@(_snapshotPage >= _snapshotPageCount)">Next snapshots</button>
        </div>
    }
</section>

<section class="card">
    <h2>Roster licensees</h2>
    <p class="muted-text">Review captured state records before linking them to local user accounts.</p>
    @if (!_licenseesLoaded)
    {
        <div class="course-actions">
            <button type="button" class="secondary-btn" @onclick="RefreshLicenseesAsync" disabled="@(_isWorking || _isLoadingLicensees)">
                @(_isLoadingLicensees ? "Loading roster licensees..." : "Load roster licensees")
            </button>
        </div>
        <p class="muted-text">Roster licensees are not loaded.</p>
    }
    else if (_licensees.Count == 0)
    {
        <p class="muted-text">No current roster licensee records are available.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>State</th>
                        <th>Licensee</th>
                        <th>License</th>
                        <th>Status</th>
                        <th>Issued</th>
                        <th>Renewal</th>
                        <th>Linked account</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var licensee in _licensees)
                    {
                        <tr>
                            <td>@licensee.State</td>
                            <td>@licensee.Name</td>
                            <td>
                                @licensee.LicenseNumber (@(licensee.SourceLicenseType ?? licensee.LicenseLevel ?? licensee.LicenseType))
                            </td>
                            <td>@licensee.LicenseStatus</td>
                            <td>@(licensee.LicenseIssuedDate?.ToString("yyyy-MM-dd") ?? "Not reported")</td>
                            <td>@(licensee.LicenseRenewalDate?.ToString("yyyy-MM-dd") ?? "Not reported")</td>
                            <td>@GetLinkedUserText(licensee.LinkedUserId)</td>
                            <td>
                                @if (CanLinkToUser(licensee))
                                {
                                    <select value="@GetSelectedUserId(licensee)" @onchange="args => SelectUser(licensee.LicenseeId, args.Value?.ToString())" disabled="@_isWorking">
                                        <option value="">Select account</option>
                                        @foreach (var user in _users)
                                        {
                                            <option value="@user.Id">@user.DisplayName (@user.Email)</option>
                                        }
                                    </select>
                                    <button type="button" class="secondary-btn" @onclick="() => LinkAsync(licensee.LicenseeId)" disabled="@(_isWorking || !HasSelectedUser(licensee.LicenseeId))">Link</button>
                                }
                                else
                                {
                                    <span class="muted-text">Organization record</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card">
    <h2>Campaign targets</h2>
    <p class="muted-text">Current roster firms with qualifying brokers and upcoming licensee renewals. Choose a state to preview its targets and export that state's full list for Excel.</p>
    <div class="form-field">
        <label for="campaign-state-filter">Preview and export state</label>
        <select id="campaign-state-filter" value="@_campaignState" @onchange="OnCampaignStateChangedAsync" disabled="@_isWorking">
            <option value="">All states</option>
            @foreach (var state in _campaignStates)
            {
                <option value="@state">@state</option>
            }
        </select>
    </div>
    <div class="course-actions">
        <button type="button" class="secondary-btn" @onclick="RefreshCampaignTargetsAsync" disabled="@(_isWorking || _isLoadingCampaignTargets)">
            @(_isLoadingCampaignTargets ? "Loading campaign targets..." : "Load campaign targets")
        </button>
        <a class="secondary-btn" href="@CampaignCsvUrl" target="_blank">@CampaignCsvLabel</a>
    </div>
    @if (!_campaignTargetsLoaded)
    {
        <p class="muted-text">Campaign targets are not loaded.</p>
    }
    else if (_campaignTargets.Count == 0)
    {
        <p class="muted-text">No campaign targets are available.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>State</th>
                        <th>Firm</th>
                        <th>License</th>
                        <th>Broker</th>
                        <th>Licensees</th>
                        <th>Next renewal</th>
                        <th>Date source</th>
                        <th>Renewals in 12 months</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var target in _campaignTargets)
                    {
                        <tr>
                            <td>@target.State</td>
                            <td>@target.FirmName@(target.TradeName is null ? string.Empty : $" ({target.TradeName})")</td>
                            <td>@target.FirmLicenseNumber</td>
                            <td>@(target.BrokerName ?? "Not reported")</td>
                            <td>@target.LicenseeCount</td>
                            <td>@(target.NextRenewalDate?.ToString("yyyy-MM-dd") ?? "Not reported")</td>
                            <td>@(target.RenewalDateSource ?? "Unavailable")</td>
                            <td>@target.RenewalsWithinTwelveMonths</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private string _bulkState = "Florida";
    [SupplyParameterFromQuery(Name = "state")] public string? RequestedState { get; set; }
    private static bool IsBulk(string? parser) => parser is FloridaBulkImportService.ParserVersion or TexasBulkImportService.ParserVersion or CaliforniaBulkImportService.ParserVersion or ColoradoDoraBulkImportService.ParserVersion or NevadaNredBulkImportService.ParserVersion or NewYorkDosBulkImportService.ParserVersion or ArizonaAdreBulkImportService.ParserVersion or ConnecticutDcpBulkImportService.ParserVersion or OregonOreaBulkImportService.ParserVersion or DelawareDprBulkImportService.ParserVersion or VirginiaDporBulkImportService.ParserVersion or IllinoisIdfprBulkImportService.ParserVersion or MichiganLaraBulkImportService.ParserVersion or WestVirginiaRecBulkImportService.ParserVersion or MaineAlmsBulkImportService.ParserVersion or VermontOprBulkImportService.ParserVersion or MontanaRreBulkImportService.ParserVersion;
    private int _rosterHistoryVersion;
    private async Task OnRosterRestoredAsync()
    {
        await RefreshSnapshotsAsync();
        if (_licenseesLoaded) await RefreshLicenseesAsync();
        if (_campaignTargetsLoaded) await RefreshCampaignTargetsAsync();
    }
    private readonly JsonSerializerOptions _jsonOptions = new() { PropertyNameCaseInsensitive = true };
    private List<RegulatorySnapshotSummary> _snapshots = new();
    private List<RegulatorySnapshotSummary> _latestSnapshots = new();
    private List<string> _snapshotStates = new();
    private string _snapshotState = string.Empty;
    private DateOnly? _snapshotFrom;
    private DateOnly? _snapshotTo;
    private int _snapshotPage = 1;
    private int _snapshotPageCount = 1;
    private int _snapshotTotal;
    private List<RegulatoryLicenseeSummary> _licensees = new();
    private List<CampaignFirmTarget> _campaignTargets = new();
    private List<string> _campaignStates = new();
    private string _campaignState = string.Empty;
    private List<UserAccount> _users = new();
    private readonly Dictionary<Guid, Guid> _selectedUsers = new();
    private HashSet<string> _selectedColoradoTypes = new(StringComparer.Ordinal);
    private string _snapshotJson = string.Empty;
    private string? _message;
    private bool _hasError;
    private bool _isWorking;
    private bool _licenseesLoaded;
    private bool _isLoadingLicensees;
    private bool _campaignTargetsLoaded;
    private bool _isLoadingCampaignTargets;

    protected override async Task OnInitializedAsync()
    {
        if (RequestedState is "Florida" or "Texas" or "California" or "Colorado" or "Nevada" or "New York" or "Arizona" or "Connecticut" or "Oregon" or "Delaware" or "Virginia" or "Illinois" or "Michigan" or "West Virginia" or "Maine" or "Vermont" or "Montana") _bulkState = RequestedState;
        _selectedColoradoTypes = ColoradoDoraSelectionStore.GetSelected().ToHashSet(StringComparer.Ordinal);
        _users = (await UserAccountService.GetAllAsync()).Where(user => user.IsActive).OrderBy(user => user.DisplayName).ToList();
        await RefreshSnapshotsAsync();
        _campaignStates = await RegulatoryDirectoryService.GetCampaignStateOptionsAsync();
    }

    private string CampaignCsvUrl => string.IsNullOrWhiteSpace(_campaignState)
        ? "/admin/campaign-targets.csv"
        : $"/admin/campaign-targets.csv?state={Uri.EscapeDataString(_campaignState)}";
    private string CampaignCsvLabel => string.IsNullOrWhiteSpace(_campaignState)
        ? "Download all states CSV"
        : $"Download {_campaignState} CSV";

    private async Task OnCampaignStateChangedAsync(ChangeEventArgs args)
    {
        _campaignState = args.Value?.ToString() ?? string.Empty;
        await RefreshCampaignTargetsAsync();
    }

    private async Task RefreshCampaignTargetsAsync()
    {
        _isLoadingCampaignTargets = true;
        try
        {
            _campaignTargets = await RegulatoryDirectoryService.GetCampaignFirmTargetsAsync(
                string.IsNullOrWhiteSpace(_campaignState) ? null : _campaignState);
            _campaignTargetsLoaded = true;
        }
        catch (Exception)
        {
            _hasError = true;
            _message = "Campaign targets could not be loaded. Please try again.";
        }
        finally
        {
            _isLoadingCampaignTargets = false;
        }
    }

    private async Task ImportAsync()
    {
        try
        {
            _isWorking = true;
            var snapshot = JsonSerializer.Deserialize<RegulatorySnapshotImport>(_snapshotJson, _jsonOptions)
                ?? throw new InvalidOperationException("The snapshot JSON is empty or invalid.");
            await RegulatoryDirectoryService.ImportAsync(snapshot);
            _snapshotJson = string.Empty;
            _hasError = false;
            _message = "Snapshot imported and ready for review.";
            _snapshotState = snapshot.State;
            _snapshotPage = 1;
            await RefreshSnapshotsAsync();
        }
        catch (JsonException)
        {
            _hasError = true;
            _message = "The snapshot JSON is invalid.";
        }
        catch (InvalidOperationException exception)
        {
            _hasError = true;
            _message = exception.Message;
        }
        finally
        {
            _isWorking = false;
        }
    }

    private static string? GetSafeExternalUrl(string? sourceUrl)
    {
        return Uri.TryCreate(sourceUrl, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
                ? uri.AbsoluteUri
                : null;
    }

    private async Task ApproveAsync(Guid snapshotId)
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var actorIdValue = authenticationState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(actorIdValue, out var actorId))
        {
            _hasError = true;
            _message = "Your session is out of date. Please sign in again.";
            return;
        }

        _isWorking = true;
        try
        {
            var actorEmail = authenticationState.User.FindFirst(ClaimTypes.Email)?.Value ?? authenticationState.User.Identity?.Name ?? "admin";
            var approved = await RegulatoryDirectoryService.ApproveAsync(snapshotId, actorId, actorEmail);
            _hasError = !approved;
            _message = approved ? "Snapshot approved." : "The snapshot could not be approved.";
            await RefreshSnapshotsAsync();
            if (_licenseesLoaded)
            {
                await RefreshLicenseesAsync();
            }
            if (_campaignTargetsLoaded)
            {
                await RefreshCampaignTargetsAsync();
            }
        }
        finally
        {
            _isWorking = false;
        }
    }

    private async Task RefreshSnapshotsAsync()
    {
        _snapshotStates = await RegulatoryDirectoryService.GetSnapshotStatesAsync();
        ApplySnapshotPage(await LoadSnapshotPageAsync(RegulatoryDirectoryService));
    }

    private async Task<RegulatorySnapshotPage?> LoadSnapshotPageAsync(IRegulatoryDirectoryService directory) =>
        string.IsNullOrEmpty(_snapshotState)
            ? null
            : await directory.GetSnapshotPageAsync(_snapshotState, _snapshotFrom, _snapshotTo, _snapshotPage);

    private void ApplySnapshotPage(RegulatorySnapshotPage? page)
    {
        _snapshots = page?.Items.ToList() ?? new();
        _snapshotTotal = page?.TotalCount ?? 0;
        _snapshotPage = page?.Page ?? 1;
        _snapshotPageCount = page?.PageCount ?? 1;
    }

    private async Task OnSnapshotStateChangedAsync(ChangeEventArgs args)
    {
        _snapshotState = args.Value?.ToString() ?? string.Empty;
        _snapshotPage = 1;
        await RefreshSnapshotsAsync();
    }

    private async Task OnSnapshotFromChangedAsync(ChangeEventArgs args)
    {
        _snapshotFrom = DateOnly.TryParse(args.Value?.ToString(), out var date) ? date : null;
        _snapshotPage = 1;
        await RefreshSnapshotsAsync();
    }

    private async Task OnSnapshotToChangedAsync(ChangeEventArgs args)
    {
        _snapshotTo = DateOnly.TryParse(args.Value?.ToString(), out var date) ? date : null;
        _snapshotPage = 1;
        await RefreshSnapshotsAsync();
    }

    private async Task ClearSnapshotDatesAsync()
    {
        _snapshotFrom = null;
        _snapshotTo = null;
        _snapshotPage = 1;
        await RefreshSnapshotsAsync();
    }

    private async Task GoToSnapshotPageAsync(int page)
    {
        _snapshotPage = page;
        await RefreshSnapshotsAsync();
    }

    private async Task OnBulkSnapshotCompletedAsync(Guid snapshotId)
    {
        _rosterHistoryVersion++;
        await RefreshSnapshotsAsync();
        _hasError = false;
        _message = $"Bulk roster {snapshotId} synchronized automatically.";
        if (_licenseesLoaded) await RefreshLicenseesAsync();
        if (_campaignTargetsLoaded) await RefreshCampaignTargetsAsync();
    }

    private const int AutoRefreshSeconds = 30;
    private readonly CancellationTokenSource _disposed = new();
    // Controls wait for the interactive circuit; a change made during prerender would be lost.
    private bool _interactive;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _interactive = true;
        StateHasChanged();
        _ = AutoRefreshLoopAsync();
    }

    // Polls in its own scope so it never shares the circuit DbContext with child components mid-query.
    private async Task AutoRefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(AutoRefreshSeconds));
        try
        {
            while (await timer.WaitForNextTickAsync(_disposed.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (_isWorking || _isLoadingLicensees || _isLoadingCampaignTargets) return;
                    try
                    {
                        await using var scope = ScopeFactory.CreateAsyncScope();
                        var directory = scope.ServiceProvider.GetRequiredService<IRegulatoryDirectoryService>();
                        var snapshots = await directory.GetRecentSnapshotsAsync();
                        if (snapshots.SequenceEqual(_latestSnapshots)) return;
                        _latestSnapshots = snapshots;
                        _snapshotStates = await directory.GetSnapshotStatesAsync();
                        ApplySnapshotPage(await LoadSnapshotPageAsync(directory));
                        if (_licenseesLoaded) _licensees = await directory.GetApprovedLicenseesAsync();
                        if (_campaignTargetsLoaded)
                        {
                            _campaignTargets = await directory.GetCampaignFirmTargetsAsync(
                                string.IsNullOrWhiteSpace(_campaignState) ? null : _campaignState);
                        }
                        StateHasChanged();
                    }
                    catch (Exception exception) when (exception is not OperationCanceledException)
                    {
                        Logger.LogWarning(exception, "Automatic regulatory directory reload failed");
                    }
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private async Task RefreshLicenseesAsync()
    {
        _isLoadingLicensees = true;
        try
        {
            _licensees = await RegulatoryDirectoryService.GetApprovedLicenseesAsync();
            _licenseesLoaded = true;
        }
        catch (Exception)
        {
            _hasError = true;
            _message = "Roster licensees could not be loaded. Please try again.";
        }
        finally
        {
            _isLoadingLicensees = false;
        }
    }

    private void SelectUser(Guid licenseeId, string? rawUserId)
    {
        if (Guid.TryParse(rawUserId, out var userId))
        {
            _selectedUsers[licenseeId] = userId;
        }
        else
        {
            _selectedUsers.Remove(licenseeId);
        }
    }

    private string GetSelectedUserId(RegulatoryLicenseeSummary licensee)
    {
        return _selectedUsers.TryGetValue(licensee.LicenseeId, out var selectedUserId)
            ? selectedUserId.ToString()
            : licensee.LinkedUserId?.ToString() ?? string.Empty;
    }

    private bool HasSelectedUser(Guid licenseeId) => _selectedUsers.ContainsKey(licenseeId);

    private bool CanLinkToUser(RegulatoryLicenseeSummary licensee)
    {
        if (licensee.State != "Colorado")
            return true;
        var option = ColoradoDoraLicenseTypes.All.FirstOrDefault(item => item.Name == licensee.SourceLicenseType);
        return option?.IsIndividual == true;
    }

    private void SetColoradoTypeEnabled(string typeName, object? rawValue)
    {
        if (ColoradoDoraLicenseTypes.All.FirstOrDefault(option => option.Name == typeName)?.IsRealEstate != true)
            return;
        if (rawValue is not bool enabled) return;
        if (enabled)
            _selectedColoradoTypes.Add(typeName);
        else
            _selectedColoradoTypes.Remove(typeName);
    }

    private async Task SaveColoradoTypesAsync()
    {
        try
        {
            ColoradoDoraSelectionStore.Save(_selectedColoradoTypes);
            _selectedColoradoTypes = ColoradoDoraSelectionStore.GetSelected().ToHashSet(StringComparer.Ordinal);
            if (_licenseesLoaded) await RefreshLicenseesAsync();
            _hasError = false;
            _message = "Colorado DORA display types saved.";
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or InvalidDataException or ArgumentException)
        {
            _hasError = true;
            _message = $"Colorado DORA display types could not be saved: {exception.Message}";
        }
    }

    private string GetLinkedUserText(Guid? userId)
    {
        return userId is Guid id
            ? _users.FirstOrDefault(user => user.Id == id)?.Email ?? "Linked account"
            : "Not linked";
    }

    private async Task LinkAsync(Guid licenseeId)
    {
        if (!_selectedUsers.TryGetValue(licenseeId, out var userId))
        {
            return;
        }

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!Guid.TryParse(authenticationState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var actorId))
        {
            _hasError = true;
            _message = "Your session is out of date. Please sign in again.";
            return;
        }

        _isWorking = true;
        var actorEmail = authenticationState.User.FindFirst(ClaimTypes.Email)?.Value ?? authenticationState.User.Identity?.Name ?? "admin";
        var linked = await RegulatoryDirectoryService.LinkLicenseeToUserAsync(userId, licenseeId, actorId, actorEmail);
        _hasError = !linked;
        _message = linked ? "Licensee linked to the user account." : "The licensee could not be linked.";
        _selectedUsers.Remove(licenseeId);
        await RefreshLicenseesAsync();
        _isWorking = false;
    }

    private static string GetStatusClass(string status) => status switch
    {
        RegulatorySnapshotStatuses.Approved => "status-pill-approved",
        RegulatorySnapshotStatuses.Rejected => "status-pill-changes",
        _ => "status-pill-pending"
    };

    private static string GetStatusText(string status) => status switch
    {
        RegulatorySnapshotStatuses.PendingReview => "Pending review",
        RegulatorySnapshotStatuses.Approved => "Approved",
        RegulatorySnapshotStatuses.Rejected => "Rejected",
        _ => status
    };
}