@page "/admin/reporting"
@using System.Security.Claims
@using Lms.Application.Services
@using Lms.Application.Data

@attribute [Authorize(Roles = "Admin")]

@inject IPaymentReportingService ReportingService
@inject IFraudDetectionService FraudService
@inject ApplicationDbContext DbContext
@inject ILogger<AdminReporting> Logger

<PageTitle>Payment & Refund Reporting - Admin</PageTitle>

<div class="admin-reporting-container">
    <h1>Payment & Refund Reporting</h1>

    <div class="report-controls">
        <div class="date-range">
            <label>Start Date:</label>
            <input type="date" @bind="_startDate" class="form-control" />
        </div>
        <div class="date-range">
            <label>End Date:</label>
            <input type="date" @bind="_endDate" class="form-control" />
        </div>
        <button class="btn btn-primary" @onclick="GenerateReport">Generate Report</button>
    </div>

    @if (_isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Generating report...</p>
        </div>
    }
    else if (_revenueReport != null)
    {
        <div class="report-section">
            <h2>Revenue Summary</h2>
            <div class="report-grid">
                <div class="report-card">
                    <div class="card-value">${_revenueReport.TotalRevenue:F2}</div>
                    <div class="card-label">Total Revenue</div>
                </div>
                <div class="report-card">
                    <div class="card-value">${_revenueReport.TotalRefunds:F2}</div>
                    <div class="card-label">Total Refunds</div>
                </div>
                <div class="report-card highlight">
                    <div class="card-value">${_revenueReport.NetRevenue:F2}</div>
                    <div class="card-label">Net Revenue</div>
                </div>
                <div class="report-card">
                    <div class="card-value">@_revenueReport.TransactionCount</div>
                    <div class="card-label">Transactions</div>
                </div>
            </div>
        </div>

        @if (_refundAnalytics != null)
        {
            <div class="report-section">
                <h2>Refund Analytics</h2>
                <div class="report-grid">
                    <div class="report-card">
                        <div class="card-value">@_refundAnalytics.TotalRefunds</div>
                        <div class="card-label">Total Refunds</div>
                    </div>
                    <div class="report-card">
                        <div class="card-value">${_refundAnalytics.TotalRefundAmount:F2}</div>
                        <div class="card-label">Refund Amount</div>
                    </div>
                    <div class="report-card">
                        <div class="card-value">@_refundAnalytics.RefundRate.ToString("F1")%</div>
                        <div class="card-label">Refund Rate</div>
                    </div>
                    <div class="report-card success">
                        <div class="card-value">@_refundAnalytics.SuccessfulRefunds</div>
                        <div class="card-label">Successful</div>
                    </div>
                </div>

                @if (_refundAnalytics.RefundsByReason.Count > 0)
                {
                    <div class="reasons-breakdown">
                        <h3>Refunds by Reason</h3>
                        <table class="simple-table">
                            <thead>
                                <tr>
                                    <th>Reason</th>
                                    <th>Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var kvp in _refundAnalytics.RefundsByReason.OrderByDescending(x => x.Value))
                                {
                                    <tr>
                                        <td>@kvp.Key</td>
                                        <td>@kvp.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @if (_fraudStats != null)
        {
            <div class="report-section warning">
                <h2>Fraud Statistics</h2>
                <div class="report-grid">
                    <div class="report-card">
                        <div class="card-value">@_fraudStats.FlaggedRefunds</div>
                        <div class="card-label">Flagged for Review</div>
                    </div>
                    <div class="report-card">
                        <div class="card-value">@_fraudStats.PercentageFlagged.ToString("F1")%</div>
                        <div class="card-label">Flagged Rate</div>
                    </div>
                    <div class="report-card error">
                        <div class="card-value">${_fraudStats.FraudulentAmount:F2}</div>
                        <div class="card-label">High Risk Amount</div>
                    </div>
                    <div class="report-card">
                        <div class="card-value">@_fraudStats.ApprovedRefunds</div>
                        <div class="card-label">Approved</div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .admin-reporting-container {
        max-width: 1200px;
        margin: 20px auto;
        padding: 20px;
    }

    .admin-reporting-container h1 {
        margin-bottom: 30px;
        color: #333;
    }

    .report-controls {
        display: flex;
        gap: 15px;
        margin-bottom: 30px;
        align-items: flex-end;
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        flex-wrap: wrap;
    }

    .date-range {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .date-range label {
        font-weight: 600;
        font-size: 13px;
        color: #333;
    }

    .form-control {
        padding: 8px 12px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        font-size: 14px;
    }

    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }

    .btn-primary:hover {
        background-color: #0056b3;
    }

    .loading {
        text-align: center;
        padding: 40px;
    }

    .spinner {
        border: 4px solid #f3f3f3;
        border-top: 4px solid #007bff;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .report-section {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 30px;
    }

    .report-section.warning {
        border-left: 4px solid #ffc107;
    }

    .report-section h2 {
        margin: 0 0 20px 0;
        font-size: 20px;
        color: #333;
        border-bottom: 2px solid #f8f9fa;
        padding-bottom: 15px;
    }

    .report-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 20px;
    }

    .report-card {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 20px;
        text-align: center;
    }

    .report-card.highlight {
        background: #e7f3ff;
        border-color: #007bff;
    }

    .report-card.success {
        background: #d4edda;
        border-color: #28a745;
    }

    .report-card.error {
        background: #f8d7da;
        border-color: #dc3545;
    }

    .card-value {
        font-size: 28px;
        font-weight: 700;
        color: #007bff;
        margin-bottom: 10px;
    }

    .report-card.success .card-value {
        color: #28a745;
    }

    .report-card.error .card-value {
        color: #dc3545;
    }

    .card-label {
        font-size: 13px;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .reasons-breakdown {
        margin-top: 20px;
    }

    .reasons-breakdown h3 {
        font-size: 16px;
        color: #333;
        margin-bottom: 15px;
    }

    .simple-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .simple-table thead {
        background: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
    }

    .simple-table th {
        padding: 12px;
        text-align: left;
        font-weight: 600;
        color: #495057;
    }

    .simple-table td {
        padding: 10px 12px;
        border-bottom: 1px solid #e9ecef;
    }

    .simple-table tbody tr:hover {
        background: #f8f9fa;
    }
</style>

@code {
    private DateTime _startDate = DateTime.Today.AddMonths(-1);
    private DateTime _endDate = DateTime.Today;
    private bool _isLoading;

    private PaymentRevenueReport? _revenueReport;
    private RefundAnalytics? _refundAnalytics;
    private FraudStatistics? _fraudStats;

    protected override async Task OnInitializedAsync()
    {
        await GenerateReport();
    }

    private async Task GenerateReport()
    {
        _isLoading = true;

        try
        {
            _revenueReport = await ReportingService.GetRevenueReportAsync(_startDate, _endDate);
            _refundAnalytics = await ReportingService.GetRefundAnalyticsAsync(_startDate, _endDate);
            _fraudStats = await FraudService.GetFraudStatsAsync(_startDate, _endDate);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating report");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
