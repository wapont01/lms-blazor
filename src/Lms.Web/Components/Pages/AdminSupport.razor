@page "/admin/support"
@attribute [Authorize(Roles = "Admin")]
@using System.Security.Claims
@using Lms.Application.Services
@using Lms.Domain.Entities
@using Lms.Web.Components.Shared
@inject ICourseService CourseService
@inject IUserAccountService UserAccountService
@inject IEnrollmentService EnrollmentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Learner Purchase Support</PageTitle>

<h1>Learner Purchase Support</h1>

<div class="dashboard-grid">
	<section class="card support-action-card admin-support-card">
		<h2>Purchase Support</h2>
		<p class="muted-text">Add or remove enrollment.</p>

		<div class="support-form-stack">
			<div>
				<label for="support-learner">Learner</label>
				<select id="support-learner" value="@(_selectedLearnerId?.ToString() ?? string.Empty)" @onchange="OnLearnerChanged">
					<option value="">Select learner</option>
					@foreach (var learner in _learners)
					{
						<option value="@learner.Id">@learner.DisplayName (@learner.Email)</option>
					}
				</select>
			</div>

			<div>
				<label for="support-course">Course</label>
				<select id="support-course" @bind="_selectedCourseId">
					<option value="">Select course</option>
					@foreach (var course in _courses)
					{
						<option value="@course.Id">@course.Title</option>
					}
				</select>
			</div>
		</div>

		<div class="form-row">
			<div class="form-field">
				<label for="support-reason">Reason</label>
				<textarea id="support-reason" rows="3" @bind="_supportReason"></textarea>
			</div>
		</div>

		<div class="support-op-actions">
			<button class="primary-btn" @onclick="EnrollSelectedLearnerAsync" disabled="@(!CanEnroll())">Enroll</button>
			<button class="secondary-btn" @onclick="UnenrollSelectedLearnerAsync" disabled="@(!CanUnenroll())">Unenroll</button>
		</div>

		@if (!string.IsNullOrWhiteSpace(_supportStatus))
		{
			<p class="@GetSupportStatusClass()">@_supportStatus</p>
		}
	</section>

	<section class="card support-ownership-card admin-support-card">
		<h3>Learner enrolled courses</h3>
		<p class="muted-text">Courses the selected learner is currently enrolled in.</p>

		<p><strong>@GetSelectedLearnerLabel()</strong></p>

		@{
			var learnerCourses = GetSelectedLearnerEnrolledCourses();
		}

		@if (learnerCourses.Count > 0)
		{
			<ul class="course-list">
				@foreach (var course in learnerCourses)
				{
					<li>
						<span>@course.Title</span>
						<span class="@course.SourceCssClass">@course.SourceLabel</span>
					</li>
				}
			</ul>
		}
		else
		{
			<p class="muted-text">This learner has no enrolled courses.</p>
		}
	</section>
</div>

@code {
	private List<Course> _courses = new();
	private List<UserAccount> _users = new();
	private List<UserAccount> _learners = new();
	private List<Enrollment> _learnerEnrollments = new();
	private Guid? _actorUserId;
	private string _actorEmail = "admin@lms.local";
	private Guid? _selectedLearnerId;
	private Guid? _selectedCourseId;
	private string _supportReason = string.Empty;
	private string? _supportStatus;
	private bool? _supportSucceeded;

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;

		var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
		if (Guid.TryParse(idClaim, out var parsedId))
		{
			_actorUserId = parsedId;
		}

		_actorEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? user.Identity?.Name ?? _actorEmail;

		await RefreshDataAsync();
		await RefreshLearnerEnrollmentsAsync();
	}

	private async Task RefreshDataAsync()
	{
		_courses = await CourseService.GetAllAsync();
		_users = await UserAccountService.GetAllAsync();
		_learners = _users.Where(user => user.Role == "Learner" && user.IsActive).OrderBy(user => user.DisplayName).ToList();

		_selectedLearnerId ??= _learners.FirstOrDefault()?.Id;
		_selectedCourseId ??= _courses.FirstOrDefault()?.Id;
	}

	private async Task OnLearnerChanged(ChangeEventArgs args)
	{
		if (Guid.TryParse(args.Value?.ToString(), out var learnerId))
		{
			_selectedLearnerId = learnerId;
		}
		else
		{
			_selectedLearnerId = null;
		}

		await RefreshLearnerEnrollmentsAsync();
		_supportStatus = null;
		_supportSucceeded = null;
	}

	private async Task RefreshLearnerEnrollmentsAsync()
	{
		if (!_selectedLearnerId.HasValue)
		{
			_learnerEnrollments = new();
			return;
		}

		_learnerEnrollments = await EnrollmentService.GetEnrollmentsForLearnerAsync(_selectedLearnerId.Value);
	}

	private bool CanEnroll()
	{
		if (!_selectedLearnerId.HasValue || !_selectedCourseId.HasValue)
		{
			return false;
		}

		return !_learnerEnrollments.Any(item => item.CourseId == _selectedCourseId.Value);
	}

	private bool CanUnenroll()
	{
		if (!_selectedLearnerId.HasValue || !_selectedCourseId.HasValue)
		{
			return false;
		}

		return _learnerEnrollments.Any(item => item.CourseId == _selectedCourseId.Value);
	}

	private async Task EnrollSelectedLearnerAsync()
	{
		_supportStatus = null;
		_supportSucceeded = null;

		if (!_selectedLearnerId.HasValue || !_selectedCourseId.HasValue || !_actorUserId.HasValue)
		{
			_supportStatus = "Select learner and course.";
			_supportSucceeded = false;
			return;
		}

		var result = await EnrollmentService.AdminEnrollLearnerAsync(_selectedLearnerId.Value, _selectedCourseId.Value, _actorUserId.Value, _actorEmail, _supportReason);
		_supportSucceeded = result.Succeeded;
		_supportStatus = result.Message;
		await RefreshLearnerEnrollmentsAsync();
	}

	private async Task UnenrollSelectedLearnerAsync()
	{
		_supportStatus = null;
		_supportSucceeded = null;

		if (!_selectedLearnerId.HasValue || !_selectedCourseId.HasValue || !_actorUserId.HasValue)
		{
			_supportStatus = "Select learner and course.";
			_supportSucceeded = false;
			return;
		}

		var result = await EnrollmentService.AdminRemoveEnrollmentAsync(_selectedLearnerId.Value, _selectedCourseId.Value, _actorUserId.Value, _actorEmail, _supportReason);
		_supportSucceeded = result.Succeeded;
		_supportStatus = result.Message;
		await RefreshLearnerEnrollmentsAsync();
	}

	private string GetSupportStatusClass()
	{
		return _supportSucceeded == true ? "status-badge status-success" : "status-badge status-error";
	}

	private string GetSelectedLearnerLabel()
	{
		var learner = _learners.FirstOrDefault(item => item.Id == _selectedLearnerId) ?? _learners.FirstOrDefault();
		return learner is null ? "Current learner" : $"{learner.DisplayName} ({learner.Email})";
	}

	private List<SupportEnrollmentCourseDisplay> GetSelectedLearnerEnrolledCourses()
	{
		return SupportEnrollmentDisplay.BuildCourseDisplays(_learnerEnrollments);
	}
}

