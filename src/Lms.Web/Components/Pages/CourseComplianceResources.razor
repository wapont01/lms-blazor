@page "/courses/{CourseId:guid}/compliance-resources"
@using Lms.Application.Services
@using Lms.Domain.Entities
@inject ICourseService CourseService
@inject IPolicyDisclosureService PolicyDisclosureService
@inject ISchoolProfileService SchoolProfileService

<PageTitle>Compliance Resources</PageTitle>

@if (_course is null || _profile is null)
{
    <p>Course compliance resources were not found.</p>
}
else
{
    <main class="compliance-resources-page">
        <header class="compliance-resources-header">
            <p class="muted-text course-kicker">Distance education resources</p>
            <h1>Compliance Resources</h1>
            <p>@_course.Title</p>
            <a href="@($"/courses/{_course.Id}")">Back to course</a>
        </header>

        <section class="card" aria-labelledby="syllabus-heading">
            <h2 id="syllabus-heading">Course Syllabus and Schedule</h2>
            <p>This course uses the @(_stateProfile?.State ?? "selected state") distance-learning profile. Verify current regulator and provider requirements before offering the course for credit.</p>
            <dl class="compliance-summary-list">
                <div><dt>Instructional hours</dt><dd>@((_course.RequiredInstructionalMinutes / 60m).ToString("0.#"))</dd></div>
                <div><dt>Configured Unit minutes</dt><dd>@ConfiguredUnitMinutes of @_course.RequiredInstructionalMinutes</dd></div>
                <div><dt>Completion period</dt><dd>@_course.CompletionWindowDays days after enrollment</dd></div>
                <div><dt>Minimum passing score</dt><dd>@_course.MinimumPassingPercent%</dd></div>
                <div><dt>End-of-course examination</dt><dd>@(_course.RequiresProctoredExam ? "Proctored" : "See course requirements")</dd></div>
            </dl>
            @if (_stateProfile is not null)
            {
                <dl class="compliance-summary-list">
                    <div><dt>Distance education</dt><dd>@(_stateProfile.Requirements.AllowsDistanceEducation ? "Supported" : "Not configured")</dd></div>
                    <div><dt>Provider disclosure</dt><dd>@(_stateProfile.Requirements.RequiresProviderDisclosure ? "Required" : "Not configured")</dd></div>
                    <div><dt>Synchronous attendance</dt><dd>@(_stateProfile.Requirements.RequiresAttendanceTrackingForSynchronousCourses ? "Tracked" : "Not required by profile")</dd></div>
                    <div><dt>Live camera visibility</dt><dd>@(_stateProfile.Requirements.RequiresInstructorCameraVisibilityForSynchronousLearning ? "Required" : "Not required by profile")</dd></div>
                </dl>
                <p class="muted-text">@_stateProfile.Notes</p>
            }
            @if (ConfiguredUnitMinutes < _course.RequiredInstructionalMinutes)
            {
                <p class="compliance-configuration-warning" role="status">The regulatory Unit and exam structure is active, but the configured instructional content does not yet satisfy the 75-hour requirement. Additional Commission-syllabus Units must be authored before course approval or delivery.</p>
            }
            <ol class="compliance-unit-schedule">
                @foreach (var unit in GetRegulatoryUnits())
                {
                    <li>
                        <strong>@unit.Title</strong>
                        <span>@unit.Lessons.Sum(lesson => lesson.DurationMinutes) minutes plus mandatory Unit exam</span>
                    </li>
                }
            </ol>
        </section>

        <AuthorizeView Roles="Admin,Instructor">
            <Authorized>
                @if (_examProctoringPolicy is not null)
                {
                    <section class="card" aria-labelledby="exam-policy-heading">
                        <h2 id="exam-policy-heading">Course exam policy reference</h2>
                        <p><strong>@_examProctoringPolicy.StatusLabel</strong></p>
                        <p>@_examProctoringPolicy.Requirement</p>
                        <dl class="compliance-summary-list">
                            @if (_examProctoringPolicy.MinimumPassingPercent is int passingPercent)
                            {
                                <div><dt>Source minimum passing score</dt><dd>@passingPercent%</dd></div>
                            }
                            @if (_examProctoringPolicy.ClosedBookRequired is bool closedBookRequired)
                            {
                                <div><dt>Closed-book requirement</dt><dd>@(closedBookRequired ? "Required" : "Not required by source")</dd></div>
                            }
                            @if (_examProctoringPolicy.IdentityVerificationRequired is bool identityVerificationRequired)
                            {
                                <div><dt>Identity verification</dt><dd>@(identityVerificationRequired ? "Required" : "Not required by source")</dd></div>
                            }
                            @if (_examProctoringPolicy.RemoteProctoringAllowed is bool remoteProctoringAllowed)
                            {
                                <div><dt>Remote proctoring</dt><dd>@(remoteProctoringAllowed ? "Allowed by source" : "Not allowed by source")</dd></div>
                            }
                            @if (_examProctoringPolicy.RemoteProctoringRequiresCommissionApproval is true)
                            {
                                <div><dt>Remote approval</dt><dd>Commission approval required</dd></div>
                            }
                            @if (_examProctoringPolicy.EffectiveThrough is DateOnly effectiveThrough)
                            {
                                <div><dt>Policy caveat through</dt><dd>@effectiveThrough.ToString("yyyy-MM-dd")</dd></div>
                            }
                        </dl>
                        @if (_examProctoringPolicy.Citation is not null)
                        {
                            <p class="muted-text">@_examProctoringPolicy.EvidenceKind: @_examProctoringPolicy.Citation</p>
                        }
                        @if (_examProctoringPolicy.SourceDocument is not null)
                        {
                            <p class="muted-text">Source file: @_examProctoringPolicy.SourceDocument</p>
                        }
                        @if (_examProctoringPolicy.ReviewNote is not null)
                        {
                            <p class="compliance-configuration-warning" role="status">@_examProctoringPolicy.ReviewNote</p>
                        }
                        <p class="muted-text">This reference does not replace verification of current Commission rules or course-specific approval conditions.</p>
                    </section>
                }
            </Authorized>
        </AuthorizeView>

        <section class="card" aria-labelledby="materials-heading">
            <h2 id="materials-heading">Required Materials and Resources</h2>
            <ul>
                <li>A reliable internet connection and a device capable of using this LMS.</li>
                <li>The lessons, referenced forms, and resources provided in each Unit.</li>
                <li>The current Commission Broker Prelicensing Course Syllabus.</li>
                <li>The Williams Land Realty LLC Policies and Procedures Disclosure below.</li>
                <li>Continued access to the email address associated with your learner account.</li>
            </ul>
        </section>

        <section class="card" aria-labelledby="instructors-heading">
            <h2 id="instructors-heading">Instructors</h2>
            <div class="compliance-contact-list">
                @foreach (var instructor in GetInstructors())
                {
                    <div>
                        <strong>@instructor.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(instructor.Email))
                        {
                            <a href="mailto:@instructor.Email">@instructor.Email</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(instructor.Telephone))
                        {
                            <a href="tel:@instructor.Telephone">@instructor.Telephone</a>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="card" aria-labelledby="support-heading">
            <h2 id="support-heading">Technical Support</h2>
            <div class="compliance-contact-list">
                <div>
                    <a href="mailto:@_profile.SupportEmail">@_profile.SupportEmail</a>
                    <a href="tel:@_profile.SupportTelephone">@_profile.SupportTelephone</a>
                    <strong>Hours (@_profile.SupportTimeZoneLabel)</strong>
                    <span>Monday-Friday: @_profile.WeekdaySupportHours</span>
                    @if (!string.IsNullOrWhiteSpace(_profile.WeekdayExtendedSupportHours))
                    {
                        <span>@_profile.WeekdayExtendedSupportHours</span>
                    }
                    <span>Saturday: @_profile.SaturdaySupportHours</span>
                    @if (!string.IsNullOrWhiteSpace(_profile.SaturdayExtendedSupportHours))
                    {
                        <span>@_profile.SaturdayExtendedSupportHours</span>
                    }
                    <span>Sunday: @_profile.SundaySupportHours</span>
                    @if (!string.IsNullOrWhiteSpace(_profile.SupportScheduleExceptions))
                    {
                        <span>Exceptions: @_profile.SupportScheduleExceptions</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_profile.SupportResponseTarget))
                    {
                        <span>Response target: @_profile.SupportResponseTarget</span>
                    }
                </div>
            </div>
        </section>

        <section class="card" aria-labelledby="ppd-heading">
            <h2 id="ppd-heading">Policies and Procedures Disclosure</h2>
            @if (_disclosure is null)
            {
                <p>The provider disclosure is not available for this course.</p>
            }
            else
            {
                <pre class="compliance-disclosure-text">@_disclosure.DisclosureText</pre>
            }
        </section>
    </main>
}

@code {
    [Parameter] public Guid CourseId { get; set; }

    private Course? _course;
    private SchoolProfile? _profile;
    private DistanceLearningProfile? _stateProfile;
    private PolicyDisclosurePreview? _disclosure;
    private CourseExamProctoringPolicyResolution? _examProctoringPolicy;
    private int ConfiguredUnitMinutes => GetRegulatoryUnits().Sum(unit => unit.Lessons.Sum(lesson => lesson.DurationMinutes));

    protected override async Task OnParametersSetAsync()
    {
        _course = await CourseService.GetByIdAsync(CourseId);
        _profile = await SchoolProfileService.GetAsync();
        _disclosure = await PolicyDisclosureService.GetCourseDisclosureAsync(CourseId);
        _examProctoringPolicy = _course is null ? null : CourseExamProctoringPolicyCatalog.Resolve(_course);
        _stateProfile = !string.IsNullOrWhiteSpace(_course?.State)
            && DistanceLearningProfileCatalog.TryGet(_course.State, out var profile)
            ? profile
            : null;
    }

    private IEnumerable<Unit> GetRegulatoryUnits()
    {
        if (_course is null)
        {
            return [];
        }

        return _course.Units
            .Where(unit => !string.Equals(unit.Title, "Getting Started", StringComparison.OrdinalIgnoreCase))
            .OrderBy(unit => unit.OrderIndex);
    }

    private IEnumerable<SchoolStaffMember> GetInstructors()
    {
        if (_profile is null)
        {
            return [];
        }

        var instructors = _profile.StaffMembers
            .Where(member => string.Equals(member.Role, SchoolStaffRoles.Instructor, StringComparison.OrdinalIgnoreCase))
            .OrderBy(member => member.Name)
            .ToList();

        return instructors.Count > 0
            ? instructors
            : [new SchoolStaffMember
            {
                Name = _profile.PrimaryInstructorName,
                Email = _profile.PrimaryInstructorEmail,
                Telephone = _profile.PrimaryInstructorTelephone
            }];
    }
}
