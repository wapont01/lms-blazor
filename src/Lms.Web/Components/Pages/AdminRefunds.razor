@page "/admin/refunds"
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Lms.Application.Services
@using Lms.Application.Data
@using Lms.Domain.Entities

@attribute [Authorize(Roles = "Admin")]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApplicationDbContext DbContext
@inject IRefundService RefundService
@inject NavigationManager NavigationManager
@inject ILogger<AdminRefunds> Logger

<PageTitle>Refund Management - Admin</PageTitle>

<div class="admin-refunds-container">
    <h1>Refund Management</h1>

    <div class="dashboard-stats">
        <div class="stat-card">
            <div class="stat-value">@_totalRefunds</div>
            <div class="stat-label">Total Refunds</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">${_totalRefundAmount:F2}</div>
            <div class="stat-label">Total Refund Amount</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_successfulRefunds</div>
            <div class="stat-label">Successful</div>
        </div>
        <div class="stat-card error">
            <div class="stat-value">@_failedRefunds</div>
            <div class="stat-label">Failed</div>
        </div>
    </div>

    <div class="filters-section">
        <div class="filter-group">
            <label>Filter by Status:</label>
            <select value="@_filterStatus" @onchange="@((ChangeEventArgs e) => { _filterStatus = (string?)e.Value; ApplyFilters(); })" class="form-control">
                <option value="">All Statuses</option>
                <option value="Initiated">Initiated</option>
                <option value="Processing">Processing</option>
                <option value="Succeeded">Succeeded</option>
                <option value="Failed">Failed</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Date Range:</label>
            <input type="date" value="@_filterStartDate?.ToString("yyyy-MM-dd")" @onchange="@((ChangeEventArgs e) => { DateTime.TryParse((string?)e.Value, out var d); _filterStartDate = d == DateTime.MinValue ? null : d; ApplyFilters(); })" class="form-control" />
            to
            <input type="date" value="@_filterEndDate?.ToString("yyyy-MM-dd")" @onchange="@((ChangeEventArgs e) => { DateTime.TryParse((string?)e.Value, out var d); _filterEndDate = d == DateTime.MinValue ? null : d; ApplyFilters(); })" class="form-control" />
        </div>
        <button class="btn btn-secondary" @onclick="ResetFilters">Reset Filters</button>
    </div>

    @if (_isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading refunds...</p>
        </div>
    }
    else if (_filteredRefunds == null || _filteredRefunds.Count == 0)
    {
        <div class="empty-message">
            <p>No refunds found.</p>
        </div>
    }
    else
    {
        <div class="refunds-table">
            <div class="table-header">
                <div class="header-cell date">Date</div>
                <div class="header-cell learner">Learner</div>
                <div class="header-cell amount">Amount</div>
                <div class="header-cell reason">Reason</div>
                <div class="header-cell status">Status</div>
                <div class="header-cell actions">Actions</div>
            </div>

            @foreach (var refund in _filteredRefunds)
            {
                var payment = _paymentMap.ContainsKey(refund.PaymentTransactionId) ? _paymentMap[refund.PaymentTransactionId] : null;
                var learner = payment != null && _learnerMap.ContainsKey(payment.LearnerId) ? _learnerMap[payment.LearnerId] : null;

                <div class="table-row">
                    <div class="cell date">
                        @refund.CreatedAt.ToString("MMM d, yyyy HH:mm")
                    </div>
                    <div class="cell learner">
                        @if (learner != null)
                        {
                            <div class="learner-info">
                                <strong>@learner.DisplayName</strong>
                                <small>@learner.Email</small>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">Unknown</span>
                        }
                    </div>
                    <div class="cell amount">
                        $@refund.Amount.ToString("F2")
                    </div>
                    <div class="cell reason">
                        @if (!string.IsNullOrEmpty(refund.Reason))
                        {
                            <span class="badge">@refund.Reason</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </div>
                    <div class="cell status">
                        <span class="status-badge @GetStatusClass(refund.Status)">
                            @refund.Status
                        </span>
                    </div>
                    <div class="cell actions">
                        <button class="btn btn-sm btn-info" @onclick="() => ShowRefundDetails(refund)">
                            View
                        </button>
                        @if (refund.Status == "Failed")
                        {
                            <button class="btn btn-sm btn-warning" @onclick="() => RetryRefund(refund)">
                                Retry
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Refund Details Modal -->
@if (_showDetailsModal && _selectedRefund != null)
{
    <div class="modal-overlay" @onclick="CloseDetailsModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Refund Details</h2>
                <button class="close-btn" @onclick="CloseDetailsModal">×</button>
            </div>

            <div class="modal-body">
                @{
                    var payment = _paymentMap.ContainsKey(_selectedRefund.PaymentTransactionId) ? _paymentMap[_selectedRefund.PaymentTransactionId] : null;
                    var learner = payment != null && _learnerMap.ContainsKey(payment.LearnerId) ? _learnerMap[payment.LearnerId] : null;
                }

                <div class="details-section">
                    <h3>Refund Information</h3>
                    <div class="detail-row">
                        <span class="label">Refund ID:</span>
                        <span class="value">@_selectedRefund.Id</span>
                    </div>
                    <div class="detail-row">
                        <span class="label">Amount:</span>
                        <span class="value">$@_selectedRefund.Amount.ToString("F2")</span>
                    </div>
                    <div class="detail-row">
                        <span class="label">Status:</span>
                        <span class="value">
                            <span class="status-badge @GetStatusClass(_selectedRefund.Status)">
                                @_selectedRefund.Status
                            </span>
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="label">Reason:</span>
                        <span class="value">@(_selectedRefund.Reason ?? "Not specified")</span>
                    </div>
                    <div class="detail-row">
                        <span class="label">Created:</span>
                        <span class="value">@_selectedRefund.CreatedAt.ToString("MMM d, yyyy HH:mm:ss")</span>
                    </div>
                    @if (_selectedRefund.CompletedAt.HasValue)
                    {
                        <div class="detail-row">
                            <span class="label">Completed:</span>
                            <span class="value">@_selectedRefund.CompletedAt.Value.ToString("MMM d, yyyy HH:mm:ss")</span>
                        </div>
                    }
                </div>

                <div class="details-section">
                    <h3>Payment Information</h3>
                    @if (payment != null)
                    {
                        <div class="detail-row">
                            <span class="label">Payment ID:</span>
                            <span class="value">@payment.Id</span>
                        </div>
                        <div class="detail-row">
                            <span class="label">Payment Amount:</span>
                            <span class="value">$@payment.Amount.ToString("F2")</span>
                        </div>
                        <div class="detail-row">
                            <span class="label">Payment Status:</span>
                            <span class="value">@payment.Status</span>
                        </div>
                        <div class="detail-row">
                            <span class="label">Stripe Intent:</span>
                            <span class="value monospace">@(payment.StripePaymentIntentId ?? "N/A")</span>
                        </div>
                    }
                </div>

                <div class="details-section">
                    <h3>Learner Information</h3>
                    @if (learner != null)
                    {
                        <div class="detail-row">
                            <span class="label">Name:</span>
                            <span class="value">@learner.DisplayName</span>
                        </div>
                        <div class="detail-row">
                            <span class="label">Email:</span>
                            <span class="value">@learner.Email</span>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_selectedRefund.FailureReason))
                {
                    <div class="details-section error">
                        <h3>Failure Reason</h3>
                        <p>@_selectedRefund.FailureReason</p>
                    </div>
                }

                <div class="modal-actions">
                    <button class="btn btn-secondary" @onclick="CloseDetailsModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
