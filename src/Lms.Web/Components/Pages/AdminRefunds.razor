    .modal-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        padding-top: 20px;
        border-top: 1px solid #dee2e6;
    }

    @@media (max-width: 768px) {
        .table-header,
        .table-row {
            grid-template-columns: 1fr;
        }

        .filters-section {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-group {
            width: 100%;
        }

        .form-control {
            min-width: 100%;
        }
    }
</style>

@code {
    private List<Refund>? _allRefunds;
    private List<Refund>? _filteredRefunds;
    private bool _isLoading = true;
    private bool _showDetailsModal;
    private Refund? _selectedRefund;

    private string? _filterStatus;
    private DateTime? _filterStartDate;
    private DateTime? _filterEndDate;

    private Dictionary<Guid, PaymentTransaction> _paymentMap = new();
    private Dictionary<Guid, UserAccount> _learnerMap = new();

    private int _totalRefunds;
    private decimal _totalRefundAmount;
    private int _successfulRefunds;
    private int _failedRefunds;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load all refunds with their related data
            _allRefunds = await DbContext.Refunds
                .AsNoTracking()
                .ToListAsync();

            // Load related payments
            var paymentIds = _allRefunds.Select(r => r.PaymentTransactionId).Distinct();
            var payments = await DbContext.PaymentTransactions
                .AsNoTracking()
                .Where(p => paymentIds.Contains(p.Id))
                .ToListAsync();

            _paymentMap = payments.ToDictionary(p => p.Id);

            // Load related learners
            var learnerIds = payments.Select(p => p.LearnerId).Distinct();
            var learners = await DbContext.UserAccounts
                .AsNoTracking()
                .Where(u => learnerIds.Contains(u.Id))
                .ToListAsync();

            _learnerMap = learners.ToDictionary(u => u.Id);

            // Calculate stats
            _totalRefunds = _allRefunds.Count;
            _totalRefundAmount = _allRefunds.Sum(r => r.Amount);
            _successfulRefunds = _allRefunds.Count(r => r.Status == "Succeeded");
            _failedRefunds = _allRefunds.Count(r => r.Status == "Failed");

            // Apply initial filter
            _filteredRefunds = _allRefunds.OrderByDescending(r => r.CreatedAt).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading refunds");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        if (_allRefunds == null) return;

        _filteredRefunds = _allRefunds
            .Where(r =>
            {
                if (!string.IsNullOrEmpty(_filterStatus) && r.Status != _filterStatus)
                    return false;

                if (_filterStartDate.HasValue && r.CreatedAt.Date < _filterStartDate.Value.Date)
                    return false;

                if (_filterEndDate.HasValue && r.CreatedAt.Date > _filterEndDate.Value.Date)
                    return false;

                return true;
            })
            .OrderByDescending(r => r.CreatedAt)
            .ToList();
    }

    private void ResetFilters()
    {
        _filterStatus = null;
        _filterStartDate = null;
        _filterEndDate = null;
        ApplyFilters();
    }

    private string GetStatusClass(string status)
    {
        return status.ToLower();
    }

    private void ShowRefundDetails(Refund refund)
    {
        _selectedRefund = refund;
        _showDetailsModal = true;
    }

    private void CloseDetailsModal()
    {
        _showDetailsModal = false;
        _selectedRefund = null;
    }

    private async Task RetryRefund(Refund refund)
    {
        // Retry logic would go here
        Logger.LogInformation("Retry refund: {RefundId}", refund.Id);
    }
}
