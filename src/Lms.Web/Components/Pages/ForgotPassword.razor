@page "/forgot-password"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@inject Lms.Application.Services.PasswordRecoveryOptions Recovery

<PageTitle>Forgot password?</PageTitle>

<div class="card auth-card">
    <h1>Forgot password?</h1>
    @if (!Recovery.Enabled || Error == "unavailable")
    {
        <p class="auth-error" role="alert">Password recovery is currently unavailable. Contact an administrator.</p>
    }
    else if (Sent)
    {
        <p role="status">If an eligible account uses this email, you will receive a password reset link. Check your inbox and spam folder.</p>
    }
    else
    {
        @if (Error is not null)
        {
            <p class="auth-error" role="alert">Enter a valid email address.</p>
        }
        <form method="post" action="/auth/password/forgot" class="auth-form">
            <AntiforgeryToken />
            <div class="form-field">
                <label for="recovery-email">Email</label>
                <input id="recovery-email" type="email" name="email" autocomplete="email" maxlength="160" required />
            </div>
            <button type="submit">Send reset link</button>
        </form>
    }
    <p class="auth-help">For Google or Microsoft accounts, reset your password with that provider.</p>
    <p><a href="/login" target="_top" data-enhance-nav="false">Back to sign in</a></p>
</div>

@code {
    [SupplyParameterFromQuery] public bool Sent { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
