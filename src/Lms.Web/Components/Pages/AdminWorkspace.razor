	private async Task ResetPasswordAsync(Guid userId)
	{
		_userError = null;
		var candidatePassword = GetResetPassword(userId);

		try
		{
			if (!_actorUserId.HasValue)
			{
				throw new InvalidOperationException("Unable to identify the signed in admin account.");
			}

			await UserAccountService.AdminResetPasswordAsync(_actorUserId.Value, _actorEmail, userId, candidatePassword);
			_resetPasswords[userId] = string.Empty;
			await RefreshAuditAsync();
		}
		catch (InvalidOperationException exception)
		{
			_userError = exception.Message;
		}
	}

	private string GetResetPassword(Guid userId)
	{
		return _resetPasswords.TryGetValue(userId, out var value) ? value : string.Empty;
	}

	private void SetResetPassword(Guid userId, string value)
