@attribute [Authorize(Roles = "Admin")]
@using System.Security.Claims
@using Lms.Application.Services
@using Lms.Domain.Entities
@using Lms.Web.Components.Shared.Admin
@inject ICourseService CourseService
@inject IUserAccountService UserAccountService
@inject IAuditLogService AuditLogService
@inject IEnrollmentService EnrollmentService
@inject IExamService ExamService
@inject IComplianceReportingService ComplianceReportingService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Admin</PageTitle>

<h1>@PageHeading</h1>

<div class="dashboard-grid">
	@if (IsSectionVisible("courses"))
	{
		<AdminCoursesPanel
			Draft="_draft"
			OnCreateCourse="CreateCourseAsync"
			Courses="_courses"
			CourseError="@_courseError"
			CourseMessage="@_courseMessage"
			OnTogglePublish="TogglePublishAsync"
			OnToggleArchive="ToggleArchiveAsync"
			OnSavePrice="SaveCoursePriceAsync"
			OnSaveTier="SaveCourseTierAsync"
			OnApproveCourse="ApproveCourseAsync"
			OnRequestChanges="RequestCourseChangesAsync"
			OnRejectCourse="RejectCourseAsync" />
	}

	@if (IsSectionVisible("exams"))
	{
		<AdminExamsPanel
			ExamError="@_examError"
			ExamMessage="@_examMessage"
			Courses="_courses"
			Users="_users"
			ExamCourseIdText="@_examCourseIdText"
			OnExamCourseChanged="OnExamCourseChanged"
			OnLoadExamEditor="LoadExamEditorAsync"
			ExamEditor="_examEditor"
			OnAddExamQuestion="AddExamQuestion"
			OnRemoveExamQuestion="RemoveExamQuestion"
			OnSaveExamEditor="SaveExamEditorAsync"
			OnRetakeLearnerChanged="OnRetakeLearnerChanged"
			RetakeLearnerIdText="@GetRetakeLearnerIdText()"
			RetakeGrantAttempts="_retakeGrantAttempts"
			RetakeGrantAttemptsChanged="OnRetakeGrantAttemptsChanged"
			ResetCooldownTimerOnRetakeGrant="_resetCooldownTimerOnRetakeGrant"
			ResetCooldownTimerOnRetakeGrantChanged="OnResetCooldownTimerOnRetakeGrantChanged"
			OnGrantRetake="GrantRetakeAsync"
			RetakeGrants="_retakeGrants"
			GetRetakeGrantDraft="GetRetakeGrantDraft"
			SetRetakeGrantDraft="SetRetakeGrantDraft"
			OnUpdateRetakeGrant="UpdateRetakeGrantAsync"
			OnRevokeRetakeGrant="RevokeRetakeGrantAsync" />
	}

	@if (IsSectionVisible("users"))
	{
		<AdminUsersPanel
			UserError="@_userError"
			NewUser="_newUser"
			OnCreateUser="CreateUserAsync"
			Users="_users"
			Roles="_roles"
			GetResetPassword="GetResetPassword"
			SetResetPassword="SetResetPassword"
			OnToggleUser="ToggleUserAsync"
			OnResetPassword="ResetPasswordAsync"
			ChangeRole="ChangeRoleAsync"
			OnSaveLicenseCompliance="SaveLicenseComplianceAsync" />
	}

	@if (IsSectionVisible("audit"))
	{
		<AdminAuditPanel
			@bind-AuditFilterActor="_auditFilterActor"
			@bind-AuditFilterAction="_auditFilterAction"
			@bind-AuditFromUtc="_auditFromUtc"
			@bind-AuditToUtc="_auditToUtc"
			AuditLogs="_auditLogs"
			AuditCsvDataUrl="@_auditCsvDataUrl"
			OnApplyFilter="ApplyAuditFilterAsync"
			OnClearFilter="ClearAuditFilterAsync"
			OnExportCsv="ExportAuditAsync" />
	}

	@if (IsSectionVisible("certificates"))
	{
		<AdminCertificatesPanel
			CertificateSummary="_certificateSummary"
			CertificateRows="_certificateRows"
			BuildVerifyLink="BuildVerifyLink"
			OnRenewCertificate="RenewCertificateAsync" />
	}

	@if (IsSectionVisible("compliance"))
	{
		<AdminCompliancePanel
			PendingReports="_pendingCompletionReports"
			OnMarkSubmitted="MarkCompletionReportSubmittedAsync"
			SummaryYear="_summaryYear"
			SummaryMonth="_summaryMonth"
			SummaryYearChanged="OnSummaryYearChangedAsync"
			SummaryMonthChanged="OnSummaryMonthChangedAsync"
			SummaryRows="_summaryRows"
			PendingCheatingIncidents="_pendingCheatingIncidents"
			OnMarkCheatingIncidentReported="MarkCheatingIncidentReportedAsync"
			EducationDirectorOrientation="_educationDirectorOrientation"
			OnMarkEducationDirectorOrientationViewed="MarkEducationDirectorOrientationViewedAsync"
			InstructorCompliance="_instructorCompliance"
			OnMarkInstructorHireReported="MarkInstructorHireReportedAsync"
			OnRecordInstructorObservation="RecordInstructorObservationAsync"
			RetentionSummary="_retentionSummary"
			Courses="_courses"
			PendingScheduleNotifications="_pendingScheduleNotifications"
			PendingScheduleChangeReports="_pendingScheduleChangeReports"
			OnMarkScheduleNotificationSent="MarkScheduleNotificationSentAsync"
			OnMarkScheduleChangeReported="MarkScheduleChangeReportedAsync"
			OnScheduleSession="ScheduleCourseSessionAsync"
			ScheduleWarnings="_scheduleWarnings"
			OnProcessReminders="ProcessComplianceRemindersAsync"
			LastReminderRunResult="_lastReminderRunResult"
			ScheduledSessions="_scheduledSessions"
			OnRescheduleSession="RescheduleCourseSessionAsync"
			OnCancelSession="CancelCourseSessionAsync" />
	}
	
	@if (IsSectionVisible("logs"))
	{
		<section class="card">
			<h2>Learner Logs</h2>

			<div class="form-row">
				<div class="form-field">
					<label>Learner</label>
					<select value="@(_selectedLogsLearnerId?.ToString() ?? string.Empty)" @onchange="OnLogsLearnerChangedAsync">
						<option value="">Select learner</option>
						@foreach (var learner in _users.Where(user => user.Role == "Learner"))
						{
							<option value="@learner.Id">@learner.DisplayName (@learner.Email)</option>
						}
					</select>
				</div>
			</div>

			@if (_adminLogs.Count == 0)
			{
				<p class="muted-text">No log events available for the selected learner.</p>
			}
			else
			{
				<table class="simple-table">
					<thead>
						<tr>
							<th>Timestamp (UTC)</th>
							<th>Type</th>
							<th>Title</th>
							<th>Details</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in _adminLogs)
						{
							<tr>
								<td>@item.TimestampUtc.ToString("yyyy-MM-dd HH:mm")</td>
								<td>@item.Type</td>
								<td>@item.Title</td>
								<td>@item.Details</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</section>
	}
</div>

@code {
	[Parameter]
	public string? Section { get; set; } = "dashboard";

	private string NormalizedSection { get; set; } = "dashboard";

	private bool IsDashboardView => string.Equals(NormalizedSection, "dashboard", StringComparison.Ordinal);

	private string PageHeading => IsDashboardView ? "Admin" : ToHeadingCase(NormalizedSection);

	private List<Course> _courses = new();
	private List<UserAccount> _users = new();
	private List<AuditLog> _auditLogs = new();
	private CertificateComplianceSummary _certificateSummary = new(0, 0, 0, 0, 0);
	private List<CertificateComplianceRow> _certificateRows = new();
	private List<CourseCompletionReportRow> _pendingCompletionReports = new();
	private List<MonthlySummaryReportRow> _summaryRows = new();
	private List<CheatingIncidentReportRow> _pendingCheatingIncidents = new();
	private EducationDirectorOrientationStatus _educationDirectorOrientation = new("Education Director", null, null, null, false);
	private List<InstructorComplianceRow> _instructorCompliance = new();
	private List<RetentionCategorySummary> _retentionSummary = new();
	private List<PendingScheduleNotificationRow> _pendingScheduleNotifications = new();
	private List<PendingScheduleChangeReportRow> _pendingScheduleChangeReports = new();
	private List<ScheduledCourseSessionRow> _scheduledSessions = new();
	private List<string> _scheduleWarnings = new();
	private int? _lastReminderRunResult;
	private int _summaryYear = DateTime.UtcNow.Year;
	private int _summaryMonth = DateTime.UtcNow.Month;
	private readonly Dictionary<Guid, string> _resetPasswords = new();
	private ExamEditorModel? _examEditor;
	private Guid? _examCourseId;
	private string _examCourseIdText = string.Empty;
	private string? _examError;
	private string? _examMessage;
	private Guid? _retakeLearnerId;
	private int _retakeGrantAttempts = 1;
	private bool _resetCooldownTimerOnRetakeGrant = true;
	private List<RetakeGrantView> _retakeGrants = new();
	private readonly Dictionary<Guid, int> _retakeGrantDraftAttempts = new();
	private string _auditFilterActor = string.Empty;
	private string _auditFilterAction = string.Empty;
	private DateTime? _auditFromUtc;
	private DateTime? _auditToUtc;
	private string? _auditCsvDataUrl;
	private Guid? _selectedLogsLearnerId;
	private List<LearnerLogItem> _adminLogs = new();
	private readonly string[] _roles = ["Admin", "Instructor", "Broker", "Learner"];
	private string? _userError;
	private string? _courseError;
	private string? _courseMessage;
	private Guid? _actorUserId;
	private string _actorEmail = "admin@lms.local";
	private Course _draft = new()
	{
		Level = "Beginner",
		State = "General",
		DurationHours = 0,
		CreditHours = 0,
		Price = 0m
	};
	private AdminCreateUserModel _newUser = new();

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;

		var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
		if (Guid.TryParse(idClaim, out var parsedId))
		{
			_actorUserId = parsedId;
		}

		_actorEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? user.Identity?.Name ?? _actorEmail;

		await RefreshCoursesAsync();
		await RefreshUsersAsync();
		await LoadExamEditorAsync();
		await RefreshAuditAsync();
		await RefreshCertificatesAsync();
		await RefreshComplianceReportsAsync();

		if (_selectedLogsLearnerId is null)
		{
			_selectedLogsLearnerId = _users.FirstOrDefault(user => user.Role == "Learner")?.Id;
		}

		if (_selectedLogsLearnerId.HasValue)
		{
			_adminLogs = await EnrollmentService.GetLearnerLogsAsync(_selectedLogsLearnerId.Value);
		}
	}

	protected override void OnParametersSet()
	{
		NormalizedSection = NormalizeSection(Section);
	}

	private bool IsSectionVisible(string sectionName)
	{
		return IsDashboardView || string.Equals(NormalizedSection, sectionName, StringComparison.Ordinal);
	}

	private static string NormalizeSection(string? section)
	{
		return (section ?? string.Empty).Trim().ToLowerInvariant() switch
		{
			"" => "dashboard",
			"dashboard" => "dashboard",
			"courses" => "courses",
			"exams" => "exams",
			"users" => "users",
			"audit" => "audit",
			"certificates" => "certificates",
			"compliance" => "compliance",
			"logs" => "logs",
			_ => "dashboard"
		};
	}

	private static string ToHeadingCase(string section)
	{
		return section switch
		{
			"courses" => "Courses",
			"exams" => "Exams",
			"users" => "Users",
			"audit" => "Audit",
			"certificates" => "Certificates",
			"compliance" => "Compliance Reports",
			"logs" => "Learner Logs",
			_ => "Dashboard"
		};
	}

	private async Task OnLogsLearnerChangedAsync(ChangeEventArgs args)
	{
		if (!Guid.TryParse(args.Value?.ToString(), out var learnerId))
		{
			_selectedLogsLearnerId = null;
			_adminLogs = new();
			return;
		}

		_selectedLogsLearnerId = learnerId;
		_adminLogs = await EnrollmentService.GetLearnerLogsAsync(learnerId);
	}

	private async Task CreateCourseAsync()
	{
		_courseError = null;
		_courseMessage = null;

		_draft.Slug = CreateSlug(_draft.Title);
		_draft.IsArchived = false;

		await CourseService.CreateAsync(_draft);

		_draft = new Course
		{
			Level = "Beginner",
			State = "General",
			DurationHours = 0,
			CreditHours = 0,
			Price = 0m
		};

		await RefreshCoursesAsync();
		_courseMessage = "Course created.";
	}

	private async Task TogglePublishAsync(Course course)
	{
		_courseError = null;
		_courseMessage = null;

		course.IsPublished = !course.IsPublished;
		await CourseService.UpdateAsync(course);
		await RefreshCoursesAsync();
		_courseMessage = course.IsPublished ? "Course published." : "Course unpublished.";
	}

	private async Task ToggleArchiveAsync(Course course)
	{
		_courseError = null;
		_courseMessage = null;

		course.IsArchived = !course.IsArchived;
		if (course.IsArchived)
		{
			course.IsPublished = false;
		}

		await CourseService.UpdateAsync(course);
		await RefreshCoursesAsync();
		_courseMessage = course.IsArchived ? "Course archived." : "Course restored.";
	}

	private async Task ApproveCourseAsync(Course course)
	{
		_courseError = null;
		_courseMessage = null;

		if (!_actorUserId.HasValue)
		{
			return;
		}

		await CourseService.ApproveCourseAsync(course.Id, _actorUserId.Value);
		await RefreshCoursesAsync();
		_courseMessage = "Course approved and published.";
	}

	private async Task RequestCourseChangesAsync((Course Course, string Note) request)
	{
		_courseError = null;
		_courseMessage = null;

		if (!_actorUserId.HasValue)
		{
			return;
		}

		await CourseService.RequestChangesAsync(request.Course.Id, _actorUserId.Value, request.Note);
		await RefreshCoursesAsync();
		_courseMessage = "Change request sent to instructor.";
	}

	private async Task RejectCourseAsync((Course Course, string Note) request)
	{
		_courseError = null;
		_courseMessage = null;

		if (!_actorUserId.HasValue)
		{
			return;
		}

		await CourseService.RejectCourseAsync(request.Course.Id, _actorUserId.Value, request.Note);
		await RefreshCoursesAsync();
		_courseMessage = "Course rejected.";
	}

	private async Task SaveCoursePriceAsync(Course course)
	{
		_courseError = null;
		_courseMessage = null;

		if (!_actorUserId.HasValue)
		{
			_courseError = "Unable to identify the signed in admin account.";
			return;
		}

		var existing = await CourseService.GetByIdAsync(course.Id);
		if (existing is null)
		{
			_courseError = "Course no longer exists.";
			await RefreshCoursesAsync();
			return;
		}

		var previousPrice = existing.Price;
		var updatedPrice = Math.Max(0m, course.Price);
		existing.Price = updatedPrice;

		await CourseService.UpdateAsync(existing);

		if (previousPrice != updatedPrice)
		{
			await AuditLogService.WriteAsync(
				_actorUserId.Value,
				_actorEmail,
				"course.price.updated",
				"Course",
				existing.Id,
				$"OldPrice={previousPrice:F2};NewPrice={updatedPrice:F2}");
			await RefreshAuditAsync();
		}

		await RefreshCoursesAsync();
		_courseMessage = previousPrice == updatedPrice
			? "No price change was detected."
			: "Course price updated.";
	}

	private async Task SaveCourseTierAsync(Course course)
	{
		_courseError = null;
		_courseMessage = null;

		if (!_actorUserId.HasValue)
		{
			_courseError = "Unable to identify the signed in admin account.";
			return;
		}

		var existing = await CourseService.GetByIdAsync(course.Id);
		if (existing is null)
		{
			_courseError = "Course no longer exists.";
			await RefreshCoursesAsync();
			return;
		}

		if (!string.IsNullOrWhiteSpace(course.Tier)
			&& !CourseTiers.All.Contains(course.Tier, StringComparer.OrdinalIgnoreCase))
		{
			_courseError = "Select a valid course tier.";
			await RefreshCoursesAsync();
			return;
		}

		var previousTier = existing.Tier;
		var updatedTier = CourseTiers.All.FirstOrDefault(tier =>
			string.Equals(tier, course.Tier, StringComparison.OrdinalIgnoreCase));
		existing.Tier = updatedTier;
		await CourseService.UpdateAsync(existing);

		if (!string.Equals(previousTier, updatedTier, StringComparison.Ordinal))
		{
			await AuditLogService.WriteAsync(
				_actorUserId.Value,
				_actorEmail,
				"course.tier.updated",
				"Course",
				existing.Id,
				$"OldTier={previousTier ?? "None"};NewTier={updatedTier ?? "None"}");
			await RefreshAuditAsync();
			_courseMessage = "Course tier updated.";
		}
		else
		{
			_courseMessage = "No tier change was detected.";
		}

		await RefreshCoursesAsync();
	}

	private async Task RefreshCoursesAsync()
	{
		_courses = await CourseService.GetAllAsync();

		if (_courses.Count > 0 && _examCourseId is null)
		{
			_examCourseId = _courses[0].Id;
			_examCourseIdText = _examCourseId.Value.ToString();
		}
	}

	private Task OnExamCourseChanged(ChangeEventArgs args)
	{
		_examCourseIdText = args.Value?.ToString() ?? string.Empty;
		_examCourseId = Guid.TryParse(_examCourseIdText, out var parsed) ? parsed : null;
		_examEditor = null;
		_examError = null;
		_examMessage = null;
		_retakeGrants.Clear();
		_retakeGrantDraftAttempts.Clear();
		return Task.CompletedTask;
	}

	private async Task LoadExamEditorAsync()
	{
		_examError = null;
		_examMessage = null;

		if (!_examCourseId.HasValue)
		{
			_examError = "Select a course first.";
			return;
		}

		_examEditor = await ExamService.GetExamEditorAsync(_examCourseId.Value);
		_retakeGrants = await ExamService.GetRetakeGrantsAsync(_examCourseId.Value);
		_retakeGrantDraftAttempts.Clear();
		_examMessage = _examEditor is null
			? "No exam is available for this course."
			: "Exam loaded.";

		if (_retakeLearnerId is null && _users.Any(user => user.Role == "Learner"))
		{
			_retakeLearnerId = _users.First(user => user.Role == "Learner").Id;
		}

		if (_examEditor is not null)
		{
			_retakeLearnerId ??= _users.FirstOrDefault(user => user.Role == "Learner")?.Id;
		}
	}

	private void AddExamQuestion()
	{
		_examEditor ??= new ExamEditorModel();

		_examEditor.Questions.Add(new ExamQuestionEditorItem
		{
			OrderIndex = _examEditor.Questions.Count + 1,
			CorrectOption = "A",
			Prompt = "",
			OptionA = "",
			OptionB = "",
			OptionC = "",
			OptionD = ""
		});
	}

	private void RemoveExamQuestion(int index)
	{
		if (_examEditor is null || index < 0 || index >= _examEditor.Questions.Count)
		{
			return;
		}

		_examEditor.Questions.RemoveAt(index);
		for (var i = 0; i < _examEditor.Questions.Count; i++)
		{
			_examEditor.Questions[i].OrderIndex = i + 1;
		}
	}

	private async Task SaveExamEditorAsync()
	{
		_examError = null;
		_examMessage = null;

		if (!_examCourseId.HasValue || _examEditor is null)
		{
			_examError = "Load an exam before saving.";
			return;
		}

		if (!_actorUserId.HasValue)
		{
			_examError = "Unable to identify the signed in admin account.";
			return;
		}

		try
		{
			await ExamService.SaveExamEditorAsync(_examCourseId.Value, _examEditor, _actorUserId.Value, _actorEmail);
			_examMessage = "Exam saved. Existing attempts were reset for this course.";
			await RefreshCertificatesAsync();
			await RefreshAuditAsync();
			await LoadExamEditorAsync();
		}
		catch (InvalidOperationException exception)
		{
			_examError = exception.Message;
		}
	}

	private Task OnRetakeLearnerChanged(ChangeEventArgs args)
	{
		_retakeLearnerId = Guid.TryParse(args.Value?.ToString(), out var parsed) ? parsed : null;
		return Task.CompletedTask;
	}

	private string GetRetakeLearnerIdText()
	{
		return _retakeLearnerId?.ToString("D") ?? string.Empty;
	}

	private Task OnRetakeGrantAttemptsChanged(int value)
	{
		_retakeGrantAttempts = value;
		return Task.CompletedTask;
	}

	private Task OnResetCooldownTimerOnRetakeGrantChanged(bool value)
	{
		_resetCooldownTimerOnRetakeGrant = value;
		return Task.CompletedTask;
	}

	private async Task GrantRetakeAsync()
	{
		_examError = null;
		_examMessage = null;

		if (!_examCourseId.HasValue || !_retakeLearnerId.HasValue)
		{
			_examError = "Select both course and learner before granting retake.";
			return;
		}

		if (!_actorUserId.HasValue)
		{
			_examError = "Unable to identify the signed in admin account.";
			return;
		}

		try
		{
			await ExamService.GrantRetakeAsync(_examCourseId.Value, _retakeLearnerId.Value, Math.Max(_retakeGrantAttempts, 1), _resetCooldownTimerOnRetakeGrant, _actorUserId.Value, _actorEmail);
			_retakeGrants = await ExamService.GetRetakeGrantsAsync(_examCourseId.Value);
			_retakeGrantDraftAttempts.Clear();
			_examMessage = _resetCooldownTimerOnRetakeGrant
				? "Retake attempts granted and cooldown timer reset successfully."
				: "Retake attempts granted successfully.";
			await RefreshAuditAsync();
		}
		catch (InvalidOperationException exception)
		{
			_examError = exception.Message;
		}
	}

	private int GetRetakeGrantDraft(Guid learnerUserId, int fallback)
	{
		return _retakeGrantDraftAttempts.TryGetValue(learnerUserId, out var value) ? value : fallback;
	}

	private void SetRetakeGrantDraft(Guid learnerUserId, string? rawValue)
	{
		if (!int.TryParse(rawValue, out var parsed) || parsed < 1)
		{
			_retakeGrantDraftAttempts.Remove(learnerUserId);
			return;
		}

		_retakeGrantDraftAttempts[learnerUserId] = parsed;
	}

	private async Task UpdateRetakeGrantAsync(RetakeGrantView grant)
	{
		_examError = null;
		_examMessage = null;

		if (!_examCourseId.HasValue || !_actorUserId.HasValue)
		{
			_examError = "Select a course and ensure an admin account is active.";
			return;
		}

		var attempts = GetRetakeGrantDraft(grant.LearnerUserId, grant.GrantedAttempts);

		try
		{
			await ExamService.SetRetakeGrantAttemptsAsync(_examCourseId.Value, grant.LearnerUserId, attempts, _resetCooldownTimerOnRetakeGrant, _actorUserId.Value, _actorEmail);
			_retakeGrants = await ExamService.GetRetakeGrantsAsync(_examCourseId.Value);
			_retakeGrantDraftAttempts.Clear();
			_examMessage = _resetCooldownTimerOnRetakeGrant
				? "Retake grant updated and cooldown timer reset."
				: "Retake grant updated.";
			await RefreshAuditAsync();
		}
		catch (InvalidOperationException exception)
		{
			_examError = exception.Message;
		}
	}

	private async Task RevokeRetakeGrantAsync(RetakeGrantView grant)
	{
		_examError = null;
		_examMessage = null;

		if (!_examCourseId.HasValue || !_actorUserId.HasValue)
		{
			_examError = "Select a course and ensure an admin account is active.";
			return;
		}

		try
		{
			await ExamService.RevokeRetakeGrantAsync(_examCourseId.Value, grant.LearnerUserId, _actorUserId.Value, _actorEmail);
			_retakeGrants = await ExamService.GetRetakeGrantsAsync(_examCourseId.Value);
			_retakeGrantDraftAttempts.Clear();
			_examMessage = "Retake grant revoked.";
			await RefreshAuditAsync();
		}
		catch (InvalidOperationException exception)
		{
			_examError = exception.Message;
		}
	}

	private async Task CreateUserAsync()
	{
		_userError = null;

		try
		{
			await UserAccountService.CreateAsync(_newUser.Email, _newUser.DisplayName, _newUser.Password, _newUser.Role, _actorUserId, _actorEmail);
			_newUser = new AdminCreateUserModel();
			await RefreshUsersAsync();
			await RefreshAuditAsync();
		}
