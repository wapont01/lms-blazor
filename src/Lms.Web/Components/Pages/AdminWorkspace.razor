	private Task ExportAuditAsync()
	{
		var csv = new System.Text.StringBuilder();
		csv.AppendLine("CreatedAtUtc,ActorEmail,Action,TargetType,Details");

		foreach (var log in _auditLogs)
		{
			var details = (log.Details ?? string.Empty).Replace("\"", "\"\"");
			csv.AppendLine($"{log.CreatedAt:u},{log.ActorEmail},{log.Action},{log.TargetType},\"{details}\"");
		}

		_auditCsvDataUrl = $"data:text/csv;charset=utf-8,{Uri.EscapeDataString(csv.ToString())}";
		return Task.CompletedTask;
	}

	private static string CreateSlug(string? title)
	{
		if (string.IsNullOrWhiteSpace(title))
		{
			return string.Empty;
		}

		var slug = title.Trim().ToLowerInvariant();
		return string.Concat(slug.Select(character => char.IsLetterOrDigit(character) ? character : '-'))
			.Replace("--", "-")
			.Trim('-');
	}

