	private static string CreateSlug(string? title)
	{
		if (string.IsNullOrWhiteSpace(title))
		{
			return string.Empty;
		}

		var slug = title.Trim().ToLowerInvariant();
		return string.Concat(slug.Select(character => char.IsLetterOrDigit(character) ? character : '-'))
			.Replace("--", "-")
			.Trim('-');
	}

	private bool HasModuleCheckpoint(Guid moduleId)
	{
		return _checkpoints.Any(checkpoint => checkpoint.ModuleId == moduleId);
	}

	private string GetModuleCheckpointSummary(Guid moduleId)
	{
		var moduleCheckpoints = _checkpoints.Where(checkpoint => checkpoint.ModuleId == moduleId).ToList();
		return moduleCheckpoints.Count switch
		{
			0 => "No checkpoint configured.",
