				<div class="form-row">
					<div class="form-field">
						<label>Duration Hours</label>
						<InputNumber @bind-Value="_newCourseDraft.DurationHours" @bind-Value:after="SaveCreateDraftAsync" required />
					</div>
					<div class="form-field">
						<label>Credit Hours</label>
						<InputNumber @bind-Value="_newCourseDraft.CreditHours" @bind-Value:after="SaveCreateDraftAsync" required />
					</div>
				</div>
				<div class="form-field">
					<label>Jurisdiction</label>
					<InputText @bind-Value="_newCourseDraft.Jurisdiction" @bind-Value:after="SaveCreateDraftAsync" required />
				</div>
				<div class="form-field">
					<label>Price</label>
					<InputNumber @bind-Value="_newCourseDraft.Price" @bind-Value:after="SaveCreateDraftAsync" required />
				</div>
