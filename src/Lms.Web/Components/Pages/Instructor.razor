	private string BuildEditorUri(Guid courseId, CourseEditorStep step, Guid? subId = null)
	{
		var uri = $"/instructor/courses/{courseId}/{GetEditorStepSlug(step)}";
		return subId.HasValue ? $"{uri}/{subId.Value}" : uri;
	}

	private static string BuildPreviewUri(Guid courseId)
	{
		return $"/courses/{courseId}?preview=1&previewSession={Uri.EscapeDataString(Guid.NewGuid().ToString("N"))}";
	}

	private void NextEditorStep()
	{
		if (_editingCourse is null)
		{
			return;
		}

		if (_activeEditorStep is CourseEditorStep.Lessons or CourseEditorStep.Checkpoints or CourseEditorStep.Assessment
			&& GetCurrentAuthoringItem() is not null)
		{
			GoToAdjacentAuthoringItem(1);
			return;
		}

		if (_activeEditorStep < CourseEditorStep.Assessment)
		{
			NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, _activeEditorStep + 1));
		}
	}

	private void PreviousEditorStep()
	{
		if (_editingCourse is null)
		{
			return;
		}

		if (_activeEditorStep is CourseEditorStep.Lessons or CourseEditorStep.Checkpoints or CourseEditorStep.Assessment
			&& GetCurrentAuthoringItem() is not null)
		{
			GoToAdjacentAuthoringItem(-1);
			return;
		}

		if (_activeEditorStep > CourseEditorStep.Overview)
		{
			NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, _activeEditorStep - 1));
		}
	}

	private List<Course> GetVisibleCourses()
	{
		var visible = _courses.AsEnumerable();

		if (!string.IsNullOrWhiteSpace(_courseSearchText))
		{
			var search = _courseSearchText.Trim();
			visible = visible.Where(course => course.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
				|| course.Description.Contains(search, StringComparison.OrdinalIgnoreCase));
		}

		visible = _courseStatusFilter switch
		{
			"draft" => visible.Where(course => course.ReviewStatus == CourseReviewStatuses.Draft && !course.IsPublished && !course.IsArchived),
			"pending" => visible.Where(course => course.ReviewStatus == CourseReviewStatuses.PendingReview && !course.IsArchived),
			"changes" => visible.Where(course => course.ReviewStatus == CourseReviewStatuses.ChangesRequested && !course.IsArchived),
			"approved" => visible.Where(course => course.ReviewStatus == CourseReviewStatuses.Approved && !course.IsArchived),
			"published" => visible.Where(course => course.IsPublished && !course.IsArchived),
			"rejected" => visible.Where(course => course.ReviewStatus == CourseReviewStatuses.Rejected),
			"archived" => visible.Where(course => course.IsArchived),
			// archived courses are hidden by default so retired drafts don't clutter the list
			_ => visible.Where(course => !course.IsArchived)
		};

		return _courseSortOption switch
		{
			"title" => visible.OrderBy(course => course.Title, StringComparer.OrdinalIgnoreCase).ToList(),
			"status" => visible.OrderBy(course => GetCourseStatusLabel(course), StringComparer.OrdinalIgnoreCase).ToList(),
			_ => visible.OrderByDescending(course => course.UpdatedAt ?? course.CreatedAt).ToList()
		};
	}

	private string GetCourseStatusLabel(Course course)
	{
		if (course.IsArchived)
		{
			return "Archived";
		}

		if (course.ReviewStatus == CourseReviewStatuses.PendingReview)
		{
			return "Pending review";
		}

		if (course.ReviewStatus == CourseReviewStatuses.ChangesRequested)
		{
			return "Changes requested";
		}

		if (course.ReviewStatus == CourseReviewStatuses.Approved)
		{
			return "Approved";
		}

		if (course.ReviewStatus == CourseReviewStatuses.Rejected)
		{
			return "Rejected";
		}

		return course.IsPublished ? "Published" : "Draft";
	}

	private string GetCourseStatusClass(Course course)
	{
		if (course.IsArchived)
		{
			return "status-pill-archived";
		}

		return course.ReviewStatus switch
		{
			CourseReviewStatuses.PendingReview => "status-pill-pending",
			CourseReviewStatuses.ChangesRequested => "status-pill-changes",
			CourseReviewStatuses.Approved => "status-pill-approved",
			CourseReviewStatuses.Rejected => "status-pill-rejected",
			_ => course.IsPublished ? "status-pill-published" : "status-pill-draft"
		};
	}

	private static bool CanSubmitForReview(Course course)
	{
		if (course.ReviewStatus is CourseReviewStatuses.Draft or CourseReviewStatuses.ChangesRequested)
		{
			return true;
		}

		return course.ReviewStatus == CourseReviewStatuses.Rejected
			&& CourseReviewStatuses.CanResubmitAfterRejection(course.ReviewedAt, DateTime.UtcNow);
	}

