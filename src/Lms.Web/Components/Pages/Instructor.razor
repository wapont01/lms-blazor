@page "/instructor"
@page "/instructor/courses/{CourseId:guid}"
@page "/instructor/courses/{CourseId:guid}/{Step}"
@page "/instructor/courses/{CourseId:guid}/{Step}/{SubId:guid}"
@attribute [Authorize(Roles = "Admin,Instructor")]
@using System.Security.Claims
@using System.Text
@using System.Text.Json
@using Lms.Application.Services
@using Lms.Domain.Entities
@using Lms.Web.Components.Shared.Admin
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject ICourseService CourseService
@inject IUserAccountService UserAccountService
@inject IAssessmentService AssessmentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Instructor</PageTitle>

@if (_editingCourse is not null && CourseId != Guid.Empty)
{
	var readiness = CourseAuthoringProgressHelper.Evaluate(_editingCourse, _checkpoints);
	<div class="instructor-hero card instructor-editor-hero">
		<a class="course-kicker back-to-library-link" href="/instructor">&larr; Back to course library</a>

		<div class="instructor-hero-main">
			<h1>@_editingCourse.Title</h1>

			<section class="course-summary-strip" aria-label="Course editor summary">
				<div class="summary-chip">
					<span class="summary-label">@(_editingCourse.UsesUnitBasedStructure ? "Units" : "Modules")</span>
					<strong>@_editingCourse.Modules.Count</strong>
				</div>
				<div class="summary-chip">
					<span class="summary-label">Status</span>
					<strong>@GetCourseStatusLabel(_editingCourse)</strong>
				</div>
			</section>
		</div>
	</div>

	<div class="lesson-layout instructor-editor-layout">
		<aside class="card lesson-menu-column" aria-label="Course editor menu">
					<div class="lesson-menu-list" aria-label="Course readiness @(readiness.PercentComplete)% complete">
						<div class="menu-progress-rail" aria-hidden="true">
							<div class="menu-progress-rail-fill" style="height: @(readiness.PercentComplete)%;"></div>
						</div>
						<section class="lesson-menu-module">
							<a class="menu-module-toggle @(GetEditorStepLabel(_activeEditorStep) is "Overview" or "Modules" ? "is-current-step" : string.Empty)" href="@BuildEditorUri(_editingCourse.Id, CourseEditorStep.Overview)">
								<span class="module-toggle-label">@_editingCourse.Title</span>
								<span class="module-toggle-icon" aria-hidden="true">▸</span>
							</a>
							@if (_editingCourse.Modules.Count > 0)
							{
								<ul class="menu-sublist">
									@foreach (var module in _editingCourse.Modules.OrderBy(module => module.OrderIndex))
									{
										<li>
											<div class="menu-subsection">
												<a class="menu-item-link @(_activeEditorStep == CourseEditorStep.Modules && _editingModule?.Id == module.Id ? "active-lesson-link" : string.Empty)" href="@BuildEditorUri(_editingCourse.Id, CourseEditorStep.Modules, module.Id)">@module.OrderIndex. @module.Title</a>
												<ul class="menu-sublist">
													@{
														var moduleCheckpoints = GetOrderedModuleCheckpoints(module);
													}
													@foreach (var checkpoint in moduleCheckpoints.Where(candidate => candidate.LessonId == CourseCheckpointDefinition.StartOfModuleAnchor))
													{
														<li>
															<a class="menu-item-link @(_activeEditorStep == CourseEditorStep.Checkpoints && _editingCheckpoint?.Id == checkpoint.Id ? "active-lesson-link" : string.Empty)" href="@BuildEditorUri(_editingCourse.Id, CourseEditorStep.Checkpoints, checkpoint.Id)">@GetModuleItemNumber(module, checkpoint.Id). @checkpoint.Title</a>
														</li>
													}
													@foreach (var lesson in module.Lessons.OrderBy(lesson => lesson.OrderIndex))
													{
														<li>
															<a class="menu-item-link @(_activeEditorStep == CourseEditorStep.Lessons && _editingLesson?.Id == lesson.Id ? "active-lesson-link" : string.Empty)" href="@BuildEditorUri(_editingCourse.Id, CourseEditorStep.Lessons, lesson.Id)">@GetModuleItemNumber(module, lesson.Id). @lesson.Title</a>
														</li>
														@foreach (var checkpoint in moduleCheckpoints.Where(candidate => candidate.LessonId == lesson.Id))
														{
															<li>
																<a class="menu-item-link @(_activeEditorStep == CourseEditorStep.Checkpoints && _editingCheckpoint?.Id == checkpoint.Id ? "active-lesson-link" : string.Empty)" href="@BuildEditorUri(_editingCourse.Id, CourseEditorStep.Checkpoints, checkpoint.Id)">@GetModuleItemNumber(module, checkpoint.Id). @checkpoint.Title</a>
															</li>
														}
													}
													@foreach (var checkpoint in moduleCheckpoints.Where(candidate => candidate.LessonId is null))
													{
														<li>
															<a class="menu-item-link @(_activeEditorStep == CourseEditorStep.Checkpoints && _editingCheckpoint?.Id == checkpoint.Id ? "active-lesson-link" : string.Empty)" href="@BuildEditorUri(_editingCourse.Id, CourseEditorStep.Checkpoints, checkpoint.Id)">@GetModuleItemNumber(module, checkpoint.Id). @checkpoint.Title</a>
														</li>
													}
												</ul>
											</div>
										</li>
									}
								</ul>
							}
						</section>

						<section class="lesson-menu-module">
							<a class="menu-module-toggle @(GetEditorStepLabel(_activeEditorStep) == "Assessment" ? "is-current-step" : string.Empty)" href="@BuildEditorUri(_editingCourse.Id, CourseEditorStep.Assessment)">
								<span class="module-toggle-label">Assessment</span>
								<span class="module-toggle-icon" aria-hidden="true">▸</span>
							</a>
							<p class="menu-subprompt">Review the assessment flow and publish once the course is ready.</p>
						</section>
					</div>
				</aside>

				<section class="lesson-main-column">
					@if (readiness.Items.Any(item => !item.IsComplete))
					{
						<section class="card readiness-checklist-card">
							<p class="muted-text">Still needed before this course is ready for review:</p>
							<ul class="progress-list">
								@foreach (var item in readiness.Items)
								{
									<li class="@(item.IsComplete ? "complete" : string.Empty)">@(item.IsComplete ? "✓" : "•") @item.Label</li>
								}
							</ul>
						</section>
					}

					<section class="card lesson-content-card editor-step-content">
				@if (_activeEditorStep == CourseEditorStep.Overview)
				{
					<EditForm Model="_editingCourse" OnValidSubmit="SaveCourseAsync">
						<DataAnnotationsValidator />
						<ValidationSummary />

						<div class="form-field">
							<label>Title</label>
							<InputText @bind-Value="_editingCourse.Title" />
							<ValidationMessage For="() => _editingCourse.Title" />
						</div>
						<div class="form-field">
							<label>Description</label>
							<InputTextArea @bind-Value="_editingCourse.Description" />
						</div>
						<div class="form-field">
							<label>Level</label>
							<InputText @bind-Value="_editingCourse.Level" />
							<ValidationMessage For="() => _editingCourse.Level" />
						</div>
						<div class="form-field">
							<label>Compliance type</label>
							<InputSelect @bind-Value="_editingCourse.ComplianceType">
								<option value="">Select compliance type</option>
								<option value="@CourseComplianceTypes.Prelicensing">@CourseComplianceTypes.ToDisplayText(CourseComplianceTypes.Prelicensing)</option>
								<option value="@CourseComplianceTypes.Postlicensing">@CourseComplianceTypes.ToDisplayText(CourseComplianceTypes.Postlicensing)</option>
								<option value="@CourseComplianceTypes.ContinuingEducation">@CourseComplianceTypes.ToDisplayText(CourseComplianceTypes.ContinuingEducation)</option>
							</InputSelect>
						</div>
						<div class="form-row">
							<div class="form-field">
								<label>Delivery method</label>
								<InputSelect @bind-Value="_editingCourse.DeliveryMethod">
									<option value="@CourseDeliveryMethods.DistanceEducation">@CourseDeliveryMethods.ToDisplayText(CourseDeliveryMethods.DistanceEducation)</option>
									<option value="@CourseDeliveryMethods.SynchronousDistanceLearning">@CourseDeliveryMethods.ToDisplayText(CourseDeliveryMethods.SynchronousDistanceLearning)</option>
									<option value="@CourseDeliveryMethods.InPerson">@CourseDeliveryMethods.ToDisplayText(CourseDeliveryMethods.InPerson)</option>
									<option value="@CourseDeliveryMethods.Blended">@CourseDeliveryMethods.ToDisplayText(CourseDeliveryMethods.Blended)</option>
								</InputSelect>
							</div>
							<div class="form-field">
								<label>Commission course number</label>
								<InputText @bind-Value="_editingCourse.CommissionCourseNumber" />
								<ValidationMessage For="() => _editingCourse.CommissionCourseNumber" />
							</div>
						</div>
						@if (_editingCourse.ComplianceType == CourseComplianceTypes.ContinuingEducation)
						{
							<div class="form-field">
								<label>Continuing education type</label>
								<InputSelect @bind-Value="_editingCourse.ContinuingEducationType">
									@foreach (var type in ContinuingEducationTypes.All)
									{
										<option value="@type">@ContinuingEducationTypes.ToDisplayText(type)</option>
									}
								</InputSelect>
							</div>
						}
						<div class="form-row">
							<div class="form-field">
								<label>Duration Hours</label>
								<InputNumber @bind-Value="_editingCourse.DurationHours" />
								<ValidationMessage For="() => _editingCourse.DurationHours" />
							</div>
							<div class="form-field">
								<label>Credit Hours</label>
								<InputNumber @bind-Value="_editingCourse.CreditHours" />
								<ValidationMessage For="() => _editingCourse.CreditHours" />
							</div>
						</div>
						<div class="form-field">
							<label>Jurisdiction</label>
							<InputText @bind-Value="_editingCourse.Jurisdiction" />
						</div>
						<div class="form-row">
							<div class="form-field">
								<label>Price</label>
								<InputNumber @bind-Value="_editingCourse.Price" />
								<ValidationMessage For="() => _editingCourse.Price" />
							</div>
						</div>
						@if (_editingCourse.UsesUnitBasedStructure)
						{
							<div class="form-row">
								<div class="form-field">
									<label>Required instructional minutes</label>
									<InputNumber @bind-Value="_editingCourse.RequiredInstructionalMinutes" />
								</div>
								<div class="form-field">
									<label>Minimum pass %</label>
									<InputNumber @bind-Value="_editingCourse.MinimumPassingPercent" />
								</div>
								<div class="form-field">
									<label>Minimum attendance %</label>
									<InputNumber @bind-Value="_editingCourse.MinimumAttendancePercent" />
								</div>
							</div>
						}
						@if (CourseComplianceTypes.IsRegulated(_editingCourse.ComplianceType))
						{
							<div class="form-row">
								<div class="form-field">
									<label>Completion window (days)</label>
									<InputNumber @bind-Value="_editingCourse.CompletionWindowDays" />
								</div>
								<div class="form-field checkbox-field">
									<label>
										<InputCheckbox @bind-Value="_editingCourse.RequiresProctoredExam" />
										Requires proctored exam
									</label>
								</div>
							</div>
						}
						<div class="form-row">
							<div class="form-field checkbox-field">
								<label>
									<InputCheckbox @bind-Value="_editingCourse.IsArchived" />
									Archived
								</label>
							</div>
						</div>
						<div class="form-field">
							<label>Review status</label>
							<p><strong>@CourseReviewStatuses.ToDisplayText(_editingCourse.ReviewStatus)</strong></p>
							@if (!string.IsNullOrWhiteSpace(_editingCourse.ReviewNote))
							{
								<p class="muted-text">Admin note: @_editingCourse.ReviewNote</p>
							}
							@if (_editingCourse.ReviewStatus == CourseReviewStatuses.Rejected && !CourseReviewStatuses.CanResubmitAfterRejection(_editingCourse.ReviewedAt, DateTime.UtcNow))
							{
								<p class="muted-text">This course was rejected and the resubmission window has closed. Contact an admin to proceed.</p>
							}
						</div>

						<div class="course-actions editor-step-actions">
							<button type="submit">Save changes</button>
							<button type="button" @onclick="@(() => NavigationManager.NavigateTo("/instructor"))">Cancel</button>
							@if (!_isAdmin && CanSubmitForReview(_editingCourse) && readiness.Items.All(item => item.IsComplete))
							{
								<button type="button" @onclick="SubmitCourseForReviewAsync">Submit for review</button>
							}
							<button type="button" @onclick="NextEditorStep">Next</button>
						</div>
						@if (!_isAdmin && CanSubmitForReview(_editingCourse) && !readiness.Items.All(item => item.IsComplete))
						{
							<p class="muted-text">Complete all required items above before this course can be submitted for review.</p>
						}
						@if (!string.IsNullOrWhiteSpace(_reviewStatusMessage))
						{
							<p class="muted-text">@_reviewStatusMessage</p>
						}
					</EditForm>
				}
				else if (_activeEditorStep == CourseEditorStep.Modules)
				{
					@if (_editingModule is null)
					{
						<section class="card instructor-structure-card">
							<div class="course-item-header">
								<h3 class="structure-section-title">Modules</h3>
							</div>
							<p class="muted-text">Open each module to manage lessons and checkpoints.</p>

							@if (_editingCourse.Modules.Count == 0)
							{
								<p class="muted-text">No modules yet. Add one below to start the structure.</p>
							}
							else
							{
								<div class="course-list">
									@foreach (var module in _editingCourse.Modules.OrderBy(module => module.OrderIndex))
									{
										<article class="course-item">
											<div>
												<h3>@module.OrderIndex. @module.Title</h3>
												<p>@GetModuleLessonsSummary(module)</p>
												<p class="muted-text">@GetModuleCheckpointSummary(module.Id)</p>
											</div>
											<div class="course-actions">
												<button type="button" @onclick="() => NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.Modules, module.Id))">Edit module</button>
												<button type="button" @onclick="() => DeleteModuleAsync(module)">Delete module</button>
												<div class="course-move-actions">
													<select class="course-position-select" title="Move to position" @onchange="e => MoveModuleToSelectedPositionAsync(module, e)">
														@for (var position = 1; position <= _editingCourse.Modules.Count; position++)
														{
															<option value="@position" selected="@(position == module.OrderIndex)">@position</option>
														}
													</select>
													<button type="button" title="Move up" disabled="@(module.OrderIndex <= 1)" @onclick="() => MoveModuleAsync(module, true)">↑</button>
													<button type="button" title="Move down" disabled="@(module.OrderIndex >= _editingCourse.Modules.Count)" @onclick="() => MoveModuleAsync(module, false)">↓</button>
												</div>
											</div>
										</article>
									}
								</div>
							}
						</section>

						<section class="card instructor-structure-card instructor-structure-inline-card">
							<div class="course-item-header">
								<h3>Add a module</h3>
							</div>
							<div class="course-actions">
								<button type="button" @onclick="StartNewModule">Add module</button>
							</div>
						</section>

						<div class="card instructor-structure-card instructor-structure-inline-card">
							<div class="course-item-header">
								<h3>Assessment handoff</h3>
							</div>
							<p class="muted-text">Move to the final assessment once the course structure is ready.</p>
							<div class="course-actions">
								<button type="button" @onclick="() => NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.Assessment))">Edit final assessment</button>
							</div>
						</div>

						<hr />
						<h3>Import course structure</h3>
						<p class="muted-text">Use a .txt file or paste content with [module], [lesson], [checkpoint], [option], and [assessment] markers. Lesson duration and required flags are optional and default when omitted. Checkpoint metadata supports title, prompt, description, module, lesson, and gatesprogression. Assessment blocks support title and passpercent; each [question] block can include optionA/B/C/D, correct, and feedback.</p>
						<div class="form-field">
							<label>Upload a text file</label>
							<InputFile OnChange="HandleImportFileSelection" accept=".txt,text/plain" />
						</div>
						<div class="form-field">
							<label>Or paste import text</label>
							<InputTextArea Value="@_importText" ValueChanged="HandleImportTextChanged" ValueExpression="() => _importText" />
						</div>
						<button type="button" @onclick="ImportCourseStructureAsync">Import structure</button>
						@if (!string.IsNullOrWhiteSpace(_importStatusMessage))
						{
							<p class="muted-text">@_importStatusMessage</p>
						}
					}
					else
					{
						<h3>@(string.IsNullOrWhiteSpace(_editingModule.Title) ? "New module" : _editingModule.Title)</h3>
						<p class="muted-text">
							@(_isCreatingModule
								? "Save this module to create it and start adding lessons and checkpoints."
								: "This dedicated module page keeps lesson and checkpoint management focused on one module at a time.")
						</p>

						<EditForm Model="_editingModule" OnValidSubmit="SaveModuleAsync">
							<DataAnnotationsValidator />
							<ValidationSummary />
							<div class="form-field">
								<label>Module title</label>
								<InputText @bind-Value="_editingModule.Title" />
							</div>
							<div class="course-actions">
								<button type="submit">Save module</button>
								<button type="button" @onclick="GoToModulesList">Cancel</button>
							</div>
						</EditForm>

						@if (!_isCreatingModule)
						{
							<hr />
							<p class="muted-text">Lessons and checkpoints are shown in the order learners will encounter them. Add either one at any point to build the sequence you want, or use the ↑/↓ buttons to reorder existing ones.</p>
							<div class="course-list">
								@{
									var moduleCheckpointsInOrder = GetOrderedModuleCheckpoints(_editingModule);
								}
								@foreach (var moduleCheckpoint in moduleCheckpointsInOrder.Where(candidate => candidate.LessonId == CourseCheckpointDefinition.StartOfModuleAnchor))
								{
									<article class="course-item checkpoint-item">
										<div>
											<h3>@GetModuleItemNumber(_editingModule, moduleCheckpoint.Id). @moduleCheckpoint.Title</h3>
											<p class="muted-text">Placement: @GetCheckpointAnchorLabel(moduleCheckpoint)</p>
										</div>
										<div class="course-actions">
											<button type="button" @onclick="() => NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.Checkpoints, moduleCheckpoint.Id))">Edit checkpoint</button>
											<button type="button" @onclick="() => DeleteModuleCheckpointAsync(moduleCheckpoint.Id)">Delete checkpoint</button>
											<label class="course-gate-toggle">
												<input type="checkbox" checked="@moduleCheckpoint.GatesProgression" @onchange="e => ToggleCheckpointGatesProgressionAsync(moduleCheckpoint, e)" />
												Pass grade required
											</label>
											<div class="course-move-actions">
												@{ var startAnchoredItemCount = GetOrderedModuleItemIds(_editingModule).Count; var startAnchoredPosition = GetModuleItemNumber(_editingModule, moduleCheckpoint.Id); }
												<select class="course-position-select" title="Move to position" @onchange="e => MoveCheckpointToSelectedPositionAsync(moduleCheckpoint, e)">
													@for (var position = 1; position <= startAnchoredItemCount; position++)
													{
														<option value="@position" selected="@(position == startAnchoredPosition)">@position</option>
													}
												</select>
												<button type="button" title="Move up" disabled="@(GetModuleItemNumber(_editingModule, moduleCheckpoint.Id) <= 1)" @onclick="() => MoveCheckpointAsync(moduleCheckpoint, true)">↑</button>
												<button type="button" title="Move down" disabled="@(GetModuleItemNumber(_editingModule, moduleCheckpoint.Id) >= GetOrderedModuleItemIds(_editingModule).Count)" @onclick="() => MoveCheckpointAsync(moduleCheckpoint, false)">↓</button>
											</div>
										</div>
									</article>
								}
								@foreach (var lesson in _editingModule.Lessons.OrderBy(lesson => lesson.OrderIndex))
								{
									<article class="course-item">
										<div>
											<h3>@GetModuleItemNumber(_editingModule, lesson.Id). @lesson.Title</h3>
											<p class="muted-text">@lesson.DurationMinutes min</p>
										</div>
										<div class="course-actions">
											<button type="button" @onclick="() => NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.Lessons, lesson.Id))">Edit lesson</button>
											<button type="button" @onclick="() => DeleteLessonAsync(lesson.Id)">Delete lesson</button>
											<div class="course-move-actions">
												@{ var lessonItemCount = GetOrderedModuleItemIds(_editingModule).Count; var lessonItemPosition = GetModuleItemNumber(_editingModule, lesson.Id); }
												<select class="course-position-select" title="Move to position" @onchange="e => MoveLessonToSelectedPositionAsync(lesson, e)">
													@for (var position = 1; position <= lessonItemCount; position++)
													{
														<option value="@position" selected="@(position == lessonItemPosition)">@position</option>
													}
												</select>
												<button type="button" title="Move up" disabled="@(lesson.OrderIndex <= 1)" @onclick="() => MoveLessonAsync(lesson, true)">↑</button>
												<button type="button" title="Move down" disabled="@(lesson.OrderIndex >= _editingModule.Lessons.Count)" @onclick="() => MoveLessonAsync(lesson, false)">↓</button>
											</div>
										</div>
									</article>
									@foreach (var moduleCheckpoint in moduleCheckpointsInOrder.Where(candidate => candidate.LessonId == lesson.Id))
									{
										<article class="course-item checkpoint-item">
											<div>
												<h3>@GetModuleItemNumber(_editingModule, moduleCheckpoint.Id). @moduleCheckpoint.Title</h3>
												<p class="muted-text">Placement: @GetCheckpointAnchorLabel(moduleCheckpoint)</p>
											</div>
											<div class="course-actions">
												<button type="button" @onclick="() => NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.Checkpoints, moduleCheckpoint.Id))">Edit checkpoint</button>
												<button type="button" @onclick="() => DeleteModuleCheckpointAsync(moduleCheckpoint.Id)">Delete checkpoint</button>
												<label class="course-gate-toggle">
													<input type="checkbox" checked="@moduleCheckpoint.GatesProgression" @onchange="e => ToggleCheckpointGatesProgressionAsync(moduleCheckpoint, e)" />
													Pass grade required
												</label>
												<div class="course-move-actions">
													@{ var lessonCheckpointItemCount = GetOrderedModuleItemIds(_editingModule).Count; var lessonCheckpointPosition = GetModuleItemNumber(_editingModule, moduleCheckpoint.Id); }
													<select class="course-position-select" title="Move to position" @onchange="e => MoveCheckpointToSelectedPositionAsync(moduleCheckpoint, e)">
														@for (var position = 1; position <= lessonCheckpointItemCount; position++)
														{
															<option value="@position" selected="@(position == lessonCheckpointPosition)">@position</option>
														}
													</select>
													<button type="button" title="Move up" disabled="@(GetModuleItemNumber(_editingModule, moduleCheckpoint.Id) <= 1)" @onclick="() => MoveCheckpointAsync(moduleCheckpoint, true)">↑</button>
													<button type="button" title="Move down" disabled="@(GetModuleItemNumber(_editingModule, moduleCheckpoint.Id) >= GetOrderedModuleItemIds(_editingModule).Count)" @onclick="() => MoveCheckpointAsync(moduleCheckpoint, false)">↓</button>
												</div>
											</div>
										</article>
									}
								}
								@foreach (var moduleCheckpoint in moduleCheckpointsInOrder.Where(candidate => candidate.LessonId == null))
								{
									<article class="course-item checkpoint-item">
										<div>
											<h3>@GetModuleItemNumber(_editingModule, moduleCheckpoint.Id). @moduleCheckpoint.Title</h3>
											<p class="muted-text">Placement: @GetCheckpointAnchorLabel(moduleCheckpoint)</p>
										</div>
										<div class="course-actions">
											<button type="button" @onclick="() => NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.Checkpoints, moduleCheckpoint.Id))">Edit checkpoint</button>
											<button type="button" @onclick="() => DeleteModuleCheckpointAsync(moduleCheckpoint.Id)">Delete checkpoint</button>
											<label class="course-gate-toggle">
												<input type="checkbox" checked="@moduleCheckpoint.GatesProgression" @onchange="e => ToggleCheckpointGatesProgressionAsync(moduleCheckpoint, e)" />
												Pass grade required
											</label>
											<div class="course-move-actions">
												@{ var endAnchoredItemCount = GetOrderedModuleItemIds(_editingModule).Count; var endAnchoredPosition = GetModuleItemNumber(_editingModule, moduleCheckpoint.Id); }
												<select class="course-position-select" title="Move to position" @onchange="e => MoveCheckpointToSelectedPositionAsync(moduleCheckpoint, e)">
													@for (var position = 1; position <= endAnchoredItemCount; position++)
													{
														<option value="@position" selected="@(position == endAnchoredPosition)">@position</option>
													}
												</select>
												<button type="button" title="Move up" disabled="@(GetModuleItemNumber(_editingModule, moduleCheckpoint.Id) <= 1)" @onclick="() => MoveCheckpointAsync(moduleCheckpoint, true)">↑</button>
												<button type="button" title="Move down" disabled="@(GetModuleItemNumber(_editingModule, moduleCheckpoint.Id) >= GetOrderedModuleItemIds(_editingModule).Count)" @onclick="() => MoveCheckpointAsync(moduleCheckpoint, false)">↓</button>
											</div>
										</div>
									</article>
								}
