	private async Task HandleImportFileSelection(InputFileChangeEventArgs e)
	{
		var file = e.File;
		if (file is null)
		{
			return;
		}

		await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
		using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true, leaveOpen: false);
		_importText = await reader.ReadToEndAsync();
		_importStatusMessage = $"Loaded {file.Name} ({file.Size} bytes).";
	}

