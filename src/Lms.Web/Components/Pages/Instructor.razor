@page "/instructor"
@page "/instructor/courses/{CourseId:guid}"
@page "/instructor/courses/{CourseId:guid}/{Step}"
@page "/instructor/courses/{CourseId:guid}/{Step}/{SubId:guid}"
@attribute [Authorize(Roles = "Admin,Instructor")]
@using System.Security.Claims
@using System.Text
@using System.Text.Json
@using Lms.Application.Services
@using Lms.Domain.Entities
@using Lms.Web.Components.Shared.Admin
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject ICourseService CourseService
@inject IUserAccountService UserAccountService
@inject IExamService ExamService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Instructor</PageTitle>

@if (_editingCourse is not null && CourseId != Guid.Empty)
{
	var readiness = CourseAuthoringProgressHelper.Evaluate(_editingCourse);
	<div class="instructor-hero card instructor-editor-hero">
		<div class="instructor-hero-copy">
			<a class="course-kicker back-to-library-link" href="/instructor">&larr; Back to course library</a>
			<h1>@_editingCourse.Title</h1>
			<p class="course-description">Editing course content, unit exams, and the final exam.</p>
		</div>
	</div>

	<div class="lesson-layout instructor-editor-layout">
		<aside class="card lesson-menu-column" aria-label="Course editor menu">
					<div class="menu-progress" aria-label="Course readiness progress">
						<div class="menu-progress-header">
							<span>Course readiness</span>
							<strong>@(readiness.PercentComplete)%</strong>
						</div>
						<div class="menu-progress-track" aria-hidden="true">
							<div class="menu-progress-fill" style="width: @(readiness.PercentComplete)%;"></div>
						</div>
					</div>

					<h2>Editor Menu</h2>
					<div class="lesson-menu-list">
						@foreach (var step in _editorSteps)
						{
							<section class="lesson-menu-unit @(step == _activeEditorStep ? "is-active-unit" : string.Empty)">
								<a class="menu-unit-toggle" aria-current="@(step == _activeEditorStep ? "page" : null)" href="@BuildEditorUri(_editingCourse.Id, step)">
									<span class="unit-toggle-label">@GetEditorStepLabel(step)</span>
									<span class="unit-toggle-icon @(step == _activeEditorStep ? "is-expanded" : string.Empty)" aria-hidden="true">▸</span>
								</a>
								@if (step == CourseEditorStep.Units && _editingCourse.Units.Count > 0)
								{
									<ul>
										@foreach (var unit in _editingCourse.Units.OrderBy(unit => unit.OrderIndex))
										{
											<li>
												<a class="menu-item-link @(_editingUnit?.Id == unit.Id ? "active-lesson-link" : string.Empty)" href="@BuildEditorUri(_editingCourse.Id, CourseEditorStep.Units, unit.Id)">@unit.OrderIndex. @unit.Title</a>
											</li>
										}
									</ul>
								}
								@if (step == CourseEditorStep.UnitExams)
								{
									<ul>
										<li>
											<a class="menu-item-link @(_editingUnitExam?.IsFinal == true ? "active-lesson-link" : string.Empty)" href="@BuildEditorUri(_editingCourse.Id, CourseEditorStep.UnitExams)">Final unit exam @(HasFinalUnitExam() ? "✓" : string.Empty)</a>
										</li>
									</ul>
								}
							</section>
						}
					</div>
				</aside>

				<section class="lesson-main-column">
					<section class="course-summary-strip" aria-label="Course editor summary">
						<div class="summary-chip">
							<span class="summary-label">Status</span>
							<strong>@GetCourseStatusLabel(_editingCourse)</strong>
						</div>
						<div class="summary-chip">
							<span class="summary-label">Units</span>
							<strong>@_editingCourse.Units.Count</strong>
						</div>
						<div class="summary-chip">
							<span class="summary-label">Readiness</span>
							<strong>@(readiness.PercentComplete)%</strong>
						</div>
						<div class="summary-chip">
							<span class="summary-label">Review status</span>
							<strong>@_editingCourse.ReviewStatus</strong>
						</div>
					</section>

					@if (readiness.Items.Any(item => !item.IsComplete))
					{
						<section class="card readiness-checklist-card">
							<p class="muted-text">Still needed before this course is ready for review:</p>
							<ul class="progress-list">
								@foreach (var item in readiness.Items)
								{
									<li class="@(item.IsComplete ? "complete" : string.Empty)">@(item.IsComplete ? "✓" : "•") @item.Label</li>
								}
							</ul>
						</section>
					}

					<section class="card lesson-content-card editor-step-content">
				@if (_activeEditorStep == CourseEditorStep.Overview)
				{
					<EditForm Model="_editingCourse" OnValidSubmit="SaveCourseAsync">
						<DataAnnotationsValidator />
						<ValidationSummary />

						<div class="form-field">
							<label>Title</label>
							<InputText @bind-Value="_editingCourse.Title" />
							<ValidationMessage For="() => _editingCourse.Title" />
						</div>
						<div class="form-field">
							<label>Description</label>
							<InputTextArea @bind-Value="_editingCourse.Description" />
						</div>
						<div class="form-row">
							<div class="form-field">
								<label>Duration Hours</label>
								<InputNumber @bind-Value="_editingCourse.DurationHours" />
								<ValidationMessage For="() => _editingCourse.DurationHours" />
							</div>
							<div class="form-field">
								<label>Credit Hours</label>
								<InputNumber @bind-Value="_editingCourse.CreditHours" />
								<ValidationMessage For="() => _editingCourse.CreditHours" />
							</div>
						</div>
						<div class="form-field">
							<label>State</label>
							<InputText @bind-Value="_editingCourse.State" />
						</div>
						<div class="form-row">
							<div class="form-field">
								<label>Price</label>
								<InputNumber @bind-Value="_editingCourse.Price" />
								<ValidationMessage For="() => _editingCourse.Price" />
							</div>
							@if (_isAdmin)
							{
								<div class="form-field checkbox-field">
									<label>
										<InputCheckbox @bind-Value="_editingCourse.IsPublished" />
										Published
									</label>
								</div>
							}
						</div>
						<div class="form-row">
							<div class="form-field checkbox-field">
								<label>
									<InputCheckbox @bind-Value="_editingCourse.IsArchived" />
									Archived
								</label>
							</div>
						</div>
						<div class="form-field">
							<label>Review status</label>
							<p><strong>@_editingCourse.ReviewStatus</strong></p>
							@if (!string.IsNullOrWhiteSpace(_editingCourse.ReviewNote))
							{
								<p class="muted-text">Admin note: @_editingCourse.ReviewNote</p>
							}
						</div>

						<hr />
						<h3>Import course structure</h3>
						<p class="muted-text">Use a .txt file or paste content with [unit], [lesson], [unit exam], [option], and [exam] markers. Lesson duration and required flags are optional and default when omitted. Unit Exam metadata supports title, prompt, description, unit, and isfinal. Exam blocks support title, unit, and passpercent; each [question] block can include optionA/B/C/D, correct, and feedback.</p>
						<div class="form-field">
							<label>Upload a text file</label>
							<InputFile OnChange="HandleImportFileSelection" accept=".txt,text/plain" />
						</div>
						<div class="form-field">
							<label>Or paste import text</label>
							<InputTextArea Value="@_importText" ValueChanged="HandleImportTextChanged" ValueExpression="() => _importText" />
						</div>
						<button type="button" @onclick="ImportCourseStructureAsync">Import structure</button>
						@if (!string.IsNullOrWhiteSpace(_importStatusMessage))
						{
							<p class="muted-text">@_importStatusMessage</p>
						}

						<div class="course-actions editor-step-actions">
							<button type="submit">Save changes</button>
							<button type="button" @onclick="@(() => NavigationManager.NavigateTo("/instructor"))">Cancel</button>
							@if (!_isAdmin && CanSubmitForReview(_editingCourse))
							{
								<button type="button" @onclick="SubmitCourseForReviewAsync">Submit for review</button>
							}
							<button type="button" @onclick="NextEditorStep">Next</button>
						</div>
						@if (!string.IsNullOrWhiteSpace(_reviewStatusMessage))
						{
							<p class="muted-text">@_reviewStatusMessage</p>
						}
					</EditForm>
				}
				else if (_activeEditorStep == CourseEditorStep.Units)
				{
					<div class="form-field">
						<label>New unit title</label>
						<InputText @bind-Value="_newUnitTitle" />
					</div>
					<button type="button" @onclick="AddUnitAsync">Add unit</button>

					@if (_editingCourse.Units.Count == 0)
					{
						<p class="muted-text">No units yet.</p>
					}
					else
					{
						<div class="course-list">
							@foreach (var unit in _editingCourse.Units.OrderBy(unit => unit.OrderIndex))
							{
								<article class="course-item">
									<div>
										<h3>@unit.OrderIndex. @unit.Title</h3>
										<p>@unit.Lessons.Count lessons</p>
										<p class="muted-text">@GetUnitExamSummary(unit.Id)</p>
									</div>
									<div class="course-actions">
										<button type="button" @onclick="() => NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.Units, unit.Id))">Edit unit</button>
										<button type="button" @onclick="() => NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.UnitExams, unit.Id))">@(HasUnitExam(unit.Id) ? "Edit unit exam" : "Add unit exam")</button>
									</div>
								</article>
							}
						</div>
					}

					@if (_editingUnit is not null)
					{
						<hr />
						<h3>Edit unit</h3>
						<EditForm Model="_editingUnit" OnValidSubmit="SaveUnitAsync">
							<DataAnnotationsValidator />
							<ValidationSummary />
							<div class="form-field">
								<label>Title</label>
								<InputText @bind-Value="_editingUnit.Title" />
							</div>
							<div class="course-actions">
								<button type="submit">Save unit</button>
								<button type="button" @onclick="@(() => NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.Units)))">Cancel</button>
							</div>
						</EditForm>
					}

					<hr />
					<h3>Lessons</h3>
					@if (_editingUnit is null)
					{
						<p>Select a unit to manage its lessons.</p>
					}
					else
					{
						<div class="form-field">
							<label>New lesson title</label>
							<InputText @bind-Value="_newLessonTitle" />
						</div>
						<div class="form-field">
							<label>Lesson content</label>
							<InputTextArea @bind-Value="_newLessonText" />
						</div>
						<div class="form-row">
							<div class="form-field">
								<label>Duration Minutes</label>
								<InputNumber @bind-Value="_newLessonDurationMinutes" />
							</div>
							<div class="form-field checkbox-field">
								<label>
									<InputCheckbox @bind-Value="_newLessonRequired" />
									Required
								</label>
							</div>
						</div>
						<button type="button" @onclick="AddLessonAsync">Add lesson</button>

						@if (_editingUnit.Lessons.Count == 0)
						{
							<p class="muted-text">No lessons yet.</p>
						}
						else
						{
							<div class="course-list">
								@foreach (var lesson in _editingUnit.Lessons.OrderBy(lesson => lesson.OrderIndex))
								{
									<article class="course-item">
										<div>
											<h3>@lesson.OrderIndex. @lesson.Title</h3>
											<p>@lesson.DurationMinutes minutes | @(lesson.IsRequired ? "Required" : "Optional")</p>
											<p>@lesson.TextContent</p>
										</div>
										<button type="button" @onclick="() => BeginEditingLesson(lesson)">Edit lesson</button>
									</article>
								}
							</div>
						}

						@if (_editingLesson is not null)
						{
							<hr />
							<h3>Edit lesson</h3>
							<EditForm Model="_editingLesson" OnValidSubmit="SaveLessonAsync">
								<DataAnnotationsValidator />
								<ValidationSummary />
								<div class="form-field">
									<label>Title</label>
									<InputText @bind-Value="_editingLesson.Title" />
								</div>
								<div class="form-field">
									<label>Lesson content</label>
									<InputTextArea @bind-Value="_editingLesson.TextContent" />
								</div>
								<div class="form-field">
									<label>Duration Minutes</label>
									<InputNumber @bind-Value="_editingLesson.DurationMinutes" />
								</div>
								<div class="form-row">
									<div class="form-field checkbox-field">
										<label>
											<InputCheckbox @bind-Value="_editingLesson.IsRequired" />
											Required
										</label>
									</div>
								</div>
								<div class="course-actions">
									<button type="submit">Save lesson</button>
									<button type="button" @onclick="ClearLessonSelection">Cancel</button>
								</div>
							</EditForm>
						}
					}

					<div class="course-actions editor-step-actions">
						<button type="button" @onclick="PreviousEditorStep">Previous</button>
						<button type="button" @onclick="NextEditorStep">Next</button>
					</div>
				}
				else if (_activeEditorStep == CourseEditorStep.UnitExams)
				{
					<h3>Final unit exam</h3>
					<p class="muted-text">The final unit exam is a comprehension gate shown before the final exam unlocks.</p>
					<div class="course-actions">
						<button type="button" @onclick="() => NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.UnitExams))">@(HasFinalUnitExam() ? "Edit final unit exam" : "Add final unit exam")</button>
					</div>

					@if (_editingUnitExam is not null)
					{
						<hr />
						<h3>@(_editingUnitExam.IsFinal ? "Edit final unit exam" : $"Edit unit exam for {GetUnitTitle(_editingUnitExam.UnitId)}")</h3>

						@if (!string.IsNullOrWhiteSpace(_unitExamError))
						{
							<p class="auth-error">@_unitExamError</p>
						}
						@if (!string.IsNullOrWhiteSpace(_unitExamMessage))
						{
							<p class="auth-help">@_unitExamMessage</p>
						}

						<div class="form-field">
							<label>Title</label>
							<InputText @bind-Value="_editingUnitExam.Title" />
						</div>
						<div class="form-field">
							<label>Prompt</label>
							<InputTextArea @bind-Value="_editingUnitExam.Prompt" />
						</div>
						<div class="form-field">
							<label>Description</label>
							<InputTextArea @bind-Value="_editingUnitExam.Description" />
						</div>

						<h4>Options</h4>
						@for (var optionIndex = 0; optionIndex < _editingUnitExam.Options.Count; optionIndex++)
						{
							var capturedIndex = optionIndex;
							var option = _editingUnitExam.Options[capturedIndex];
							<div class="form-row">
								<div class="form-field">
									<label>Option @(capturedIndex + 1)</label>
									<InputText @bind-Value="option.Label" />
								</div>
								<div class="form-field checkbox-field">
									<label>
										<InputCheckbox @bind-Value="option.IsCorrect" />
										Correct
									</label>
								</div>
								<div class="form-field">
									<label>&nbsp;</label>
									<button type="button" @onclick="() => RemoveUnitExamOption(capturedIndex)">Remove</button>
								</div>
							</div>
						}

						<div class="course-actions">
							<button type="button" @onclick="AddUnitExamOption">Add option</button>
							<button type="button" @onclick="SaveUnitExamAsync">Save unit exam</button>
							@if (_editingUnitExam.Id.HasValue)
							{
								<button type="button" @onclick="DeleteUnitExamAsync">Delete unit exam</button>
							}
							<button type="button" @onclick="@(() => NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.UnitExams)))">Cancel</button>
						</div>
					}

					<div class="course-actions editor-step-actions">
						<button type="button" @onclick="PreviousEditorStep">Previous</button>
						<button type="button" @onclick="NextEditorStep">Next</button>
					</div>
				}
				else
				{
					<div class="editor-step-summary">
						<p class="muted-text">Review the exam flow and finalize the course before sending it for review.</p>
					</div>
					<AdminExamsPanel
						ExamError="@_examError"
						ExamMessage="@_examMessage"
						Courses="_courses"
						Users="_users"
						ExamCourseIdText="@_examCourseIdText"
						ActiveCourseTitle="@(_editingCourse?.Title ?? "Current course")"
						OnLoadExamEditor="LoadExamEditorAsync"
						ExamEditor="_examEditor"
						OnAddExamQuestion="AddExamQuestion"
						OnRemoveExamQuestion="RemoveExamQuestion"
						OnSaveExamEditor="SaveExamEditorAsync"
						OnRetakeLearnerChanged="OnRetakeLearnerChanged"
						RetakeLearnerIdText="@GetRetakeLearnerIdText()"
						RetakeGrantAttempts="_retakeGrantAttempts"
						RetakeGrantAttemptsChanged="OnRetakeGrantAttemptsChanged"
						ResetCooldownTimerOnRetakeGrant="_resetCooldownTimerOnRetakeGrant"
						ResetCooldownTimerOnRetakeGrantChanged="OnResetCooldownTimerOnRetakeGrantChanged"
						OnGrantRetake="GrantRetakeAsync"
						RetakeGrants="_retakeGrants"
						GetRetakeGrantDraft="GetRetakeGrantDraft"
						SetRetakeGrantDraft="SetRetakeGrantDraft"
						OnUpdateRetakeGrant="UpdateRetakeGrantAsync"
						OnRevokeRetakeGrant="RevokeRetakeGrantAsync" />

					<div class="course-actions editor-step-actions">
						<button type="button" @onclick="PreviousEditorStep">Previous</button>
					</div>
				}
					</section>
				</section>
			</div>
}
else
{
	<div class="instructor-hero card">
		<div class="instructor-hero-copy">
			<p class="muted-text course-kicker">Instructor workspace</p>
			<h1>Course authoring</h1>
			<p class="course-description">Create, refine, and prepare a course for review with the same calm structure learners experience when they move through a course.</p>
		</div>
		<div class="course-actions instructor-hero-actions">
			<button type="button" @onclick="ShowCreateView" disabled="@_showCreateMode">Create course</button>
			<button type="button" @onclick="ShowEditView" disabled="@(!_showCreateMode)">Edit courses</button>
		</div>
	</div>

	@if (_showCreateMode)
	{
		<section class="card instructor-create-panel">
			<h2>Create course</h2>
			<p class="muted-text">Start with the essentials, then continue editing to add units, lessons, and unit exams.</p>

			<EditForm Model="_newCourseDraft" OnValidSubmit="CreateCourseAsync">
				<DataAnnotationsValidator />
				<ValidationSummary />

				<div class="form-field">
					<label>Title</label>
					<InputText @bind-Value="_newCourseDraft.Title" @bind-Value:after="SaveCreateDraftAsync" />
					<ValidationMessage For="() => _newCourseDraft.Title" />
				</div>
				<div class="form-field">
					<label>Description</label>
					<InputTextArea @bind-Value="_newCourseDraft.Description" @bind-Value:after="SaveCreateDraftAsync" />
				</div>
				<div class="form-row">
					<div class="form-field">
						<label>Duration Hours</label>
						<InputNumber @bind-Value="_newCourseDraft.DurationHours" @bind-Value:after="SaveCreateDraftAsync" />
					</div>
					<div class="form-field">
						<label>Credit Hours</label>
						<InputNumber @bind-Value="_newCourseDraft.CreditHours" @bind-Value:after="SaveCreateDraftAsync" />
					</div>
				</div>
				<div class="form-field">
					<label>State</label>
					<InputText @bind-Value="_newCourseDraft.State" @bind-Value:after="SaveCreateDraftAsync" />
				</div>
				<div class="form-field">
					<label>Price</label>
					<InputNumber @bind-Value="_newCourseDraft.Price" @bind-Value:after="SaveCreateDraftAsync" />
				</div>
				<div class="course-actions">
					<button type="submit">Create course</button>
				</div>
			</EditForm>
			<p class="muted-text">Drafts are auto-saved locally so you can return to the same setup later.</p>
			@if (!string.IsNullOrWhiteSpace(_createCourseMessage))
			{
				<p class="muted-text">@_createCourseMessage</p>
			}
		</section>
	}
	else
	{
		<section class="card instructor-course-list-panel">
			<div class="instructor-panel-header">
				<div>
					<p class="muted-text course-kicker">Course library</p>
					<h2>Editable courses</h2>
				</div>
			</div>
			<div class="course-list-toolbar">
				<input class="filter-input" placeholder="Search courses" @bind="_courseSearchText" @bind:event="oninput" />
				<select @bind="_courseStatusFilter">
					<option value="all">All statuses</option>
					<option value="draft">Draft</option>
					<option value="pending">Pending review</option>
					<option value="changes">Changes requested</option>
					<option value="approved">Approved</option>
					<option value="published">Published</option>
				</select>
				<select @bind="_courseSortOption">
					<option value="updated">Most recently updated</option>
					<option value="title">Title</option>
					<option value="status">Status</option>
				</select>
			</div>

			@if (GetVisibleCourses().Count == 0)
			{
				<p>No matching courses are available to edit.</p>
			}
			else
			{
				<div class="course-list">
					@foreach (var course in GetVisibleCourses())
					{
						<article class="course-item">
							<div>
								<div class="course-item-header">
									<h3>@course.Title</h3>
									<span class="status-pill @GetCourseStatusClass(course)">@GetCourseStatusLabel(course)</span>
								</div>
								<p>@course.Level | @(course.IsPublished ? "Published" : "Unpublished") | Review: @course.ReviewStatus</p>
								<p>@course.Description</p>
								<p class="muted-text">Last updated: @(course.UpdatedAt?.ToLocalTime().ToString("MMM d, yyyy h:mm tt") ?? "Not yet saved")</p>
							</div>
							<div class="course-actions">
								<button type="button" @onclick="() => NavigationManager.NavigateTo(BuildEditorUri(course.Id, CourseEditorStep.Overview))">Continue editing</button>
							</div>
						</article>
					}
				</div>
			}
		</section>
	}
}

@code {
	[Parameter] public Guid CourseId { get; set; }
	[Parameter] public string? Step { get; set; }
	[Parameter] public Guid? SubId { get; set; }

	private bool _showCreateMode;
	private List<Course> _courses = new();
	private List<UserAccount> _users = new();
	private Course? _editingCourse;
	private string _courseSearchText = string.Empty;
	private string _courseStatusFilter = "all";
	private string _courseSortOption = "updated";
	private Unit? _editingUnit;
	private Lesson? _editingLesson;
	private string _newUnitTitle = string.Empty;
	private string _newLessonTitle = string.Empty;
	private string? _newLessonText;
	private int _newLessonDurationMinutes;
	private bool _newLessonRequired = true;
	private string _importText = string.Empty;
	private string _importStatusMessage = string.Empty;
	private Course _newCourseDraft = new()
	{
		Level = "Beginner",
		State = "General",
		DurationHours = 0,
		CreditHours = 0,
		Price = 0m
	};
	private string? _createCourseMessage;
	private Guid? _actorUserId;
