@code {
	[Parameter] public Guid CourseId { get; set; }
	[Parameter] public string? Step { get; set; }
	[Parameter] public Guid? SubId { get; set; }

	private List<Course> _courses = new();
	private string? _confirmDialogMessage;
	private bool _confirmDialogShowCancel;
	private TaskCompletionSource<bool>? _confirmDialogTcs;
	private enum CourseAuthoringItemKind
	{
		Lesson,
		Checkpoint,
		Assessment
	}

	private sealed class CourseAuthoringNavigationItem
	{
		public CourseAuthoringItemKind Kind { get; init; }
		public string Label { get; init; } = string.Empty;
		public Guid? LessonId { get; init; }
		public Guid? CheckpointId { get; init; }
		public Guid? ModuleId { get; init; }
	}
	private List<UserAccount> _users = new();
	private Course? _editingCourse;
	private string _courseSearchText = string.Empty;
	private string _courseStatusFilter = "all";
	private string _courseSortOption = "updated";
	private Module? _editingModule;
	private bool _isCreatingModule;
	private Lesson? _editingLesson;
	private bool _isCreatingLesson;

	private string _importText = string.Empty;
	private string _importStatusMessage = string.Empty;
	private Course _newCourseDraft = new()
	{
		Level = "Beginner",
		Jurisdiction = "General",
		DurationHours = 0,
		CreditHours = 0,
		Price = 0m
	};
	private string? _createCourseMessage;
	private Guid? _actorUserId;
	private string _actorEmail = "instructor@lms.local";
	private bool _isAdmin;
	private string? _reviewStatusMessage;
	private CourseEditorStep _activeEditorStep = CourseEditorStep.Overview;
	private readonly CourseEditorStep[] _editorSteps = { CourseEditorStep.Overview, CourseEditorStep.Modules, CourseEditorStep.Lessons, CourseEditorStep.Checkpoints, CourseEditorStep.Assessment };

	private enum CourseEditorStep
	{
		Overview = 1,
		Modules = 2,
		Lessons = 3,
		Checkpoints = 4,
		Assessment = 5
	}

	private List<CourseCheckpointDefinition> _checkpoints = new();
	private CheckpointDefinitionEditorModel? _editingCheckpoint;
	private string? _checkpointError;
	private string? _checkpointMessage;

	private AssessmentEditorModel? _assessmentEditor;
	private Guid? _assessmentCourseId;
	private string _assessmentCourseIdText = string.Empty;
	private string? _assessmentError;
	private string? _assessmentMessage;
	private Guid? _retakeLearnerId;
	private int _retakeGrantAttempts = 1;
	private bool _resetCooldownTimerOnRetakeGrant = true;
	private List<RetakeGrantView> _retakeGrants = new();
	private readonly Dictionary<Guid, int> _retakeGrantDraftAttempts = new();

	private const string CreateDraftStorageKey = "instructor-create-draft";
	private const string EditingCourseDraftPrefix = "instructor-edit-draft-";

	private sealed class InstructorCourseDraftState
	{
		public string Title { get; set; } = string.Empty;
		public string Description { get; set; } = string.Empty;
		public string Level { get; set; } = string.Empty;
		public int DurationHours { get; set; }
		public int CreditHours { get; set; }
		public string ComplianceType { get; set; } = CourseComplianceTypes.Unspecified;
		public string DeliveryMethod { get; set; } = CourseDeliveryMethods.DistanceEducation;
		public string? ContinuingEducationType { get; set; }
		public string? CommissionCourseNumber { get; set; }
		public int? CompletionWindowDays { get; set; }
		public bool RequiresProctoredExam { get; set; }
		public int RequiredInstructionalMinutes { get; set; }
		public int MinimumPassingPercent { get; set; } = 75;
		public int MinimumAttendancePercent { get; set; } = 80;
		public string Jurisdiction { get; set; } = string.Empty;
		public decimal Price { get; set; }
	}

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;

		var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
		if (Guid.TryParse(idClaim, out var parsedId))
		{
			_actorUserId = parsedId;
		}

		_actorEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? user.Identity?.Name ?? _actorEmail;
		_isAdmin = user.IsInRole("Admin");

		await RefreshCoursesAsync();
		_users = await UserAccountService.GetAllAsync();
		await RestoreCreateDraftAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		if (CourseId == Guid.Empty)
		{
			if (_editingCourse is not null)
			{
				ClearSelection();
			}

			return;
		}

		if (_editingCourse is null || _editingCourse.Id != CourseId)
		{
			var course = _courses.FirstOrDefault(candidate => candidate.Id == CourseId);
			if (course is null)
			{
				await RefreshCoursesAsync();
				course = _courses.FirstOrDefault(candidate => candidate.Id == CourseId);
			}

			if (course is null)
			{
				NavigationManager.NavigateTo("/instructor");
				return;
			}

			await BeginEditing(course);
		}

		_activeEditorStep = ParseEditorStep(Step);

		if (_editingCourse is null)
		{
			return;
		}

		if (_activeEditorStep == CourseEditorStep.Modules)
		{
			if (SubId.HasValue)
			{
				if (_editingModule?.Id != SubId.Value)
				{
					var module = _editingCourse.Modules.FirstOrDefault(candidate => candidate.Id == SubId.Value);
					if (module is not null)
					{
						BeginEditingModule(module);
					}
				}
			}
			else if (_editingModule is not null)
			{
				ClearModuleSelection();
			}
		}
		else if (_activeEditorStep == CourseEditorStep.Lessons)
		{
			if (SubId.HasValue)
			{
				if (_editingLesson?.Id != SubId.Value)
				{
					var module = _editingCourse.Modules.FirstOrDefault(candidate => candidate.Lessons.Any(lesson => lesson.Id == SubId.Value));
					var lesson = module?.Lessons.FirstOrDefault(candidate => candidate.Id == SubId.Value);
					if (module is not null && lesson is not null)
					{
						BeginEditingModule(module);
						BeginEditingLesson(lesson);
					}
				}
			}
			else
			{
				// The bare Lessons list duplicates the module list on the Modules step, so jump straight to a real lesson (or back to Modules if none exist).
				var firstLesson = GetCourseAuthoringNavigationItems().FirstOrDefault(item => item.Kind == CourseAuthoringItemKind.Lesson);
				NavigationManager.NavigateTo(firstLesson is not null
					? BuildEditorUri(_editingCourse.Id, CourseEditorStep.Lessons, firstLesson.LessonId!.Value)
					: BuildEditorUri(_editingCourse.Id, CourseEditorStep.Modules));
				return;
			}
		}
		else if (_activeEditorStep == CourseEditorStep.Checkpoints)
		{
			if (SubId.HasValue)
			{
				var checkpoint = _checkpoints.FirstOrDefault(candidate => candidate.Id == SubId.Value);
				if (checkpoint is not null)
				{
					BeginEditingCheckpoint(checkpoint.ModuleId, checkpoint.Id);
				}
				else
				{
					var module = _editingCourse.Modules.FirstOrDefault(candidate => candidate.Id == SubId.Value);
					BeginEditingCheckpoint(module?.Id);
				}
			}
			else
			{
				CancelCheckpointEditing();
			}
		}
	}


