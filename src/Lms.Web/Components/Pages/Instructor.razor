		_retakeGrantAttempts = value;
		return Task.CompletedTask;
	}

	private Task OnResetCooldownTimerOnRetakeGrantChanged(bool value)
	{
		_resetCooldownTimerOnRetakeGrant = value;
		return Task.CompletedTask;
	}

	private async Task GrantRetakeAsync()
	{
		_examError = null;
		_examMessage = null;

		if (!_examCourseId.HasValue || !_retakeLearnerId.HasValue)
		{
			_examError = "Select both course and learner before granting retake.";
			return;
		}

		if (!_actorUserId.HasValue)
		{
			_examError = "Unable to identify the signed in account.";
			return;
		}

		try
		{
			await ExamService.GrantRetakeAsync(_examCourseId.Value, _retakeLearnerId.Value, Math.Max(_retakeGrantAttempts, 1), _resetCooldownTimerOnRetakeGrant, _actorUserId.Value, _actorEmail);
			_retakeGrants = await ExamService.GetRetakeGrantsAsync(_examCourseId.Value);
			_retakeGrantDraftAttempts.Clear();
			_examMessage = _resetCooldownTimerOnRetakeGrant
				? "Retake attempts granted and cooldown timer reset successfully."
				: "Retake attempts granted successfully.";
		}
		catch (InvalidOperationException exception)
		{
			_examError = exception.Message;
		}
	}

	private int GetRetakeGrantDraft(Guid learnerUserId, int fallback)
	{
		return _retakeGrantDraftAttempts.TryGetValue(learnerUserId, out var value) ? value : fallback;
	}

	private void SetRetakeGrantDraft(Guid learnerUserId, string? rawValue)
	{
		if (!int.TryParse(rawValue, out var parsed) || parsed < 1)
		{
			_retakeGrantDraftAttempts.Remove(learnerUserId);
			return;
		}

		_retakeGrantDraftAttempts[learnerUserId] = parsed;
	}

	private async Task UpdateRetakeGrantAsync(RetakeGrantView grant)
	{
		_examError = null;
		_examMessage = null;

		if (!_examCourseId.HasValue || !_actorUserId.HasValue)
		{
			_examError = "Select a course and ensure an instructor account is active.";
			return;
		}

		var attempts = GetRetakeGrantDraft(grant.LearnerUserId, grant.GrantedAttempts);

		try
		{
			await ExamService.SetRetakeGrantAttemptsAsync(_examCourseId.Value, grant.LearnerUserId, attempts, _resetCooldownTimerOnRetakeGrant, _actorUserId.Value, _actorEmail);
			_retakeGrants = await ExamService.GetRetakeGrantsAsync(_examCourseId.Value);
			_retakeGrantDraftAttempts.Clear();
			_examMessage = _resetCooldownTimerOnRetakeGrant
				? "Retake grant updated and cooldown timer reset."
				: "Retake grant updated.";
		}
		catch (InvalidOperationException exception)
		{
			_examError = exception.Message;
		}
	}

	private async Task RevokeRetakeGrantAsync(RetakeGrantView grant)
	{
		_examError = null;
		_examMessage = null;

		if (!_examCourseId.HasValue || !_actorUserId.HasValue)
		{
			_examError = "Select a course and ensure an instructor account is active.";
			return;
		}

		try
		{
			await ExamService.RevokeRetakeGrantAsync(_examCourseId.Value, grant.LearnerUserId, _actorUserId.Value, _actorEmail);
			_retakeGrants = await ExamService.GetRetakeGrantsAsync(_examCourseId.Value);
			_retakeGrantDraftAttempts.Clear();
			_examMessage = "Retake grant revoked.";
		}
		catch (InvalidOperationException exception)
		{
			_examError = exception.Message;
		}
	}

	private void BeginEditingUnit(Unit unit)
	{
		_editingUnit = CloneUnit(unit);
		ClearLessonSelection();
	}

	private async Task SaveUnitAsync()
	{
		if (_editingUnit is null)
		{
			return;
		}

		await CourseService.UpdateUnitAsync(_editingUnit);
		await ReloadSelectedCourseAsync();
		await PersistEditingDraftAsync();
		BeginEditingUnit(_editingCourse!.Units.First(unit => unit.Id == _editingUnit.Id));
	}

	private void ClearUnitSelection()
	{
		_editingUnit = null;
		_newUnitTitle = string.Empty;
	}

	private async Task AddLessonAsync()
	{
		if (_editingUnit is null || string.IsNullOrWhiteSpace(_newLessonTitle))
		{
			return;
		}

		await CourseService.AddLessonAsync(_editingUnit.Id, new Lesson
		{
			Title = _newLessonTitle.Trim(),
			TextContent = _newLessonText,
			DurationMinutes = _newLessonDurationMinutes,
			IsRequired = _newLessonRequired
		});

		_newLessonTitle = string.Empty;
		_newLessonText = string.Empty;
		_newLessonDurationMinutes = 0;
		_newLessonRequired = true;
		await ReloadSelectedCourseAsync();
		await PersistEditingDraftAsync();
		if (_editingCourse is not null)
		{
			var refreshedUnit = _editingCourse.Units.FirstOrDefault(unit => unit.Id == _editingUnit.Id);
			_editingUnit = refreshedUnit is null ? null : CloneUnit(refreshedUnit);
		}
	}

	private void BeginEditingLesson(Lesson lesson)
	{
		_editingLesson = CloneLesson(lesson);
	}

	private async Task SaveLessonAsync()
	{
		if (_editingLesson is null)
		{
			return;
		}

		await CourseService.UpdateLessonAsync(_editingLesson);
		await ReloadSelectedCourseAsync();
		await PersistEditingDraftAsync();
		if (_editingUnit is not null)
		{
			var refreshedUnit = _editingCourse?.Units.FirstOrDefault(unit => unit.Id == _editingUnit.Id);
			_editingUnit = refreshedUnit is null ? null : CloneUnit(refreshedUnit);
		}
		if (_editingUnit is not null)
		{
			var refreshedLesson = _editingUnit.Lessons.FirstOrDefault(lesson => lesson.Id == _editingLesson.Id);
			_editingLesson = refreshedLesson is null ? null : CloneLesson(refreshedLesson);
		}
	}

	private void ClearLessonSelection()
	{
		_editingLesson = null;
		_newLessonTitle = string.Empty;
		_newLessonText = string.Empty;
		_newLessonDurationMinutes = 0;
		_newLessonRequired = true;
	}

	private async Task ReloadSelectedCourseAsync()
	{
		if (_editingCourse is null)
		{
			return;
		}

		var refreshedCourse = await CourseService.GetByIdAsync(_editingCourse.Id);
		_editingCourse = refreshedCourse is null ? null : CloneCourse(refreshedCourse);
		await PersistEditingDraftAsync();
	}

	private static Course CloneCourse(Course course)
	{
		return new Course
		{
			Id = course.Id,
			Title = course.Title,
			Slug = course.Slug,
			Description = course.Description,
			Level = course.Level,
			DurationHours = course.DurationHours,
			CreditHours = course.CreditHours,
			State = course.State,
			Price = course.Price,
			IsPublished = course.IsPublished,
			IsArchived = course.IsArchived,
			OwnerInstructorId = course.OwnerInstructorId,
			ReviewStatus = course.ReviewStatus,
			ReviewNote = course.ReviewNote,
			ReviewedByUserId = course.ReviewedByUserId,
			ReviewedAt = course.ReviewedAt,
			CreatedAt = course.CreatedAt,
			UpdatedAt = course.UpdatedAt,
			Units = course.Units
				.OrderBy(unit => unit.OrderIndex)
				.Select(CloneUnit)
				.ToList()
		};
	}

	private static Unit CloneUnit(Unit unit)
	{
		return new Unit
		{
			Id = unit.Id,
			CourseId = unit.CourseId,
			Title = unit.Title,
			OrderIndex = unit.OrderIndex,
			Lessons = unit.Lessons
				.OrderBy(lesson => lesson.OrderIndex)
				.Select(CloneLesson)
				.ToList()
		};
	}

	private static Lesson CloneLesson(Lesson lesson)
	{
		return new Lesson
		{
			Id = lesson.Id,
			UnitId = lesson.UnitId,
			Title = lesson.Title,
			ContentType = lesson.ContentType,
			ContentUrl = lesson.ContentUrl,
			TextContent = lesson.TextContent,
			DurationMinutes = lesson.DurationMinutes,
			OrderIndex = lesson.OrderIndex,
			IsRequired = lesson.IsRequired
		};
	}
}
