	private async Task SaveAssessmentEditorAsync()
	{
		_assessmentError = null;
		_assessmentMessage = null;

		if (!_assessmentCourseId.HasValue || _assessmentEditor is null)
		{
			_assessmentError = "Load an assessment before saving.";
			return;
		}

		if (!_actorUserId.HasValue)
		{
			_assessmentError = "Unable to identify the signed in account.";
			return;
		}

		try
		{
			await AssessmentService.SaveAssessmentEditorAsync(_assessmentCourseId.Value, _assessmentEditor, _actorUserId.Value, _actorEmail);
			_assessmentMessage = "Assessment saved. Existing attempts were reset for this course.";
			await LoadAssessmentEditorAsync();
