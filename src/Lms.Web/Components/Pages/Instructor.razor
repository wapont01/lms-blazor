	private List<(Module Module, Lesson Lesson)> GetOrderedLessonsWithModules()
	{
		if (_editingCourse is null)
		{
			return new List<(Module, Lesson)>();
		}

		return _editingCourse.Modules
			.OrderBy(module => module.OrderIndex)
			.SelectMany(module => module.Lessons
				.OrderBy(lesson => lesson.OrderIndex)
				.Select(lesson => (Module: module, Lesson: lesson)))
			.ToList();
	}

	private (Module Module, Lesson Lesson)? GetAdjacentLesson(int offset)
	{
		if (_editingLesson is null)
		{
			return null;
		}

		var ordered = GetOrderedLessonsWithModules();
		var currentIndex = ordered.FindIndex(entry => entry.Lesson.Id == _editingLesson.Id);
		var targetIndex = currentIndex + offset;
		if (currentIndex < 0 || targetIndex < 0 || targetIndex >= ordered.Count)
		{
			return null;
		}

		return ordered[targetIndex];
	}

	private void GoToAdjacentLesson(int offset)
	{
		if (_editingCourse is null)
		{
			return;
		}

		var target = GetAdjacentLesson(offset);
		if (target is null)
		{
			return;
		}

		NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.Lessons, target.Value.Lesson.Id));
	}

	private List<CourseAuthoringNavigationItem> GetCourseAuthoringNavigationItems()
	{
		if (_editingCourse is null)
		{
			return new List<CourseAuthoringNavigationItem>();
		}

		var items = new List<CourseAuthoringNavigationItem>();

		foreach (var module in _editingCourse.Modules.OrderBy(module => module.OrderIndex))
		{
			foreach (var lesson in module.Lessons.OrderBy(lesson => lesson.OrderIndex))
			{
				items.Add(new CourseAuthoringNavigationItem
				{
					Kind = CourseAuthoringItemKind.Lesson,
					Label = $"{module.OrderIndex}. {module.Title} — Lesson {lesson.OrderIndex}",
					LessonId = lesson.Id,
					ModuleId = module.Id
				});
			}

			var moduleCheckpoints = _checkpoints.Where(candidate => candidate.ModuleId == module.Id);
			foreach (var checkpoint in moduleCheckpoints)
			{
				items.Add(new CourseAuthoringNavigationItem
				{
					Kind = CourseAuthoringItemKind.Checkpoint,
					Label = $"{module.OrderIndex}. {module.Title} — {checkpoint.Title}",
					CheckpointId = checkpoint.Id,
					ModuleId = module.Id
				});
			}
		}

		items.Add(new CourseAuthoringNavigationItem
		{
			Kind = CourseAuthoringItemKind.Assessment,
			Label = "Final assessment"
		});

		return items;
	}

	private CourseAuthoringNavigationItem? GetCurrentAuthoringItem()
	{
		var items = GetCourseAuthoringNavigationItems();
		if (_activeEditorStep == CourseEditorStep.Lessons && _editingLesson is not null)
		{
			return items.FirstOrDefault(item => item.Kind == CourseAuthoringItemKind.Lesson && item.LessonId == _editingLesson.Id);
		}

		if (_activeEditorStep == CourseEditorStep.Checkpoints && _editingCheckpoint is not null)
		{
			var existing = items.FirstOrDefault(item => item.Kind == CourseAuthoringItemKind.Checkpoint && item.CheckpointId.HasValue && item.CheckpointId == _editingCheckpoint.Id);
			if (existing is not null)
			{
				return existing;
			}

			return new CourseAuthoringNavigationItem
			{
				Kind = CourseAuthoringItemKind.Checkpoint,
				Label = $"{GetModuleTitle(_editingCheckpoint.ModuleId)} — checkpoint",
				CheckpointId = _editingCheckpoint.Id,
				ModuleId = _editingCheckpoint.ModuleId
			};
		}

		if (_activeEditorStep == CourseEditorStep.Assessment)
		{
			return items.FirstOrDefault(item => item.Kind == CourseAuthoringItemKind.Assessment);
		}

		return null;
	}

	private CourseAuthoringNavigationItem? GetAdjacentAuthoringItem(int offset)
	{
		var current = GetCurrentAuthoringItem();
		if (current is null)
		{
			return null;
		}

		var items = GetCourseAuthoringNavigationItems();
		var currentIndex = items.FindIndex(item => item.Kind == current.Kind
			&& item.LessonId == current.LessonId
			&& item.CheckpointId == current.CheckpointId
			&& item.ModuleId == current.ModuleId);
		if (currentIndex < 0)
		{
			return null;
		}

		var targetIndex = currentIndex + offset;
		if (targetIndex < 0 || targetIndex >= items.Count)
		{
			return null;
		}

		return items[targetIndex];
	}

	private void GoToAdjacentAuthoringItem(int offset)
	{
		if (_editingCourse is null)
		{
			return;
		}

		var target = GetAdjacentAuthoringItem(offset);
		if (target is null)
		{
			return;
		}

		if (target.Kind == CourseAuthoringItemKind.Lesson)
		{
			NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.Lessons, target.LessonId));
			return;
		}

		if (target.Kind == CourseAuthoringItemKind.Checkpoint)
		{
			NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.Checkpoints, target.CheckpointId ?? target.ModuleId));
			return;
		}

		NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, CourseEditorStep.Assessment));
	}

	private void BeginEditingLesson(Lesson lesson)
	{
		_editingLesson = CloneLesson(lesson);
		_isCreatingLesson = false;
	}

	private async Task SaveLessonAsync()
	{
		if (_editingLesson is null || _editingCourse is null)
		{
			return;
		}

		var moduleId = _editingModule?.Id;

		if (_isCreatingLesson)
		{
			if (moduleId is null)
			{
				return;
			}

			await CourseService.AddLessonAsync(moduleId.Value, new Lesson
			{
				Title = _editingLesson.Title,
				TextContent = _editingLesson.TextContent,
				DurationMinutes = _editingLesson.DurationMinutes,
				IsRequired = _editingLesson.IsRequired
			});
		}
		else
		{
			await CourseService.UpdateLessonAsync(_editingLesson);
		}

		await ReloadSelectedCourseAsync();
		if (_editingCourse is null)
		{
			return;
		}

		// Refresh the module clone too, otherwise the module page still renders the pre-save lesson list.
		if (moduleId.HasValue)
		{
			var refreshedModule = _editingCourse.Modules.FirstOrDefault(module => module.Id == moduleId.Value);
			if (refreshedModule is not null)
			{
				BeginEditingModule(refreshedModule);
			}
		}

		var targetUri = moduleId.HasValue
			? BuildEditorUri(_editingCourse.Id, CourseEditorStep.Modules, moduleId.Value)
			: BuildEditorUri(_editingCourse.Id, CourseEditorStep.Lessons);
		ClearLessonSelection();

		// NavigateTo won't re-run OnParametersSet (and reset _activeEditorStep) when the target
		// URI matches the current one, e.g. lesson creation never left the module's URL.
		_activeEditorStep = moduleId.HasValue ? CourseEditorStep.Modules : CourseEditorStep.Lessons;
		NavigationManager.NavigateTo(targetUri);
	}

	private void ClearLessonSelection()
	{
		_editingLesson = null;
		_isCreatingLesson = false;
	}

	private async Task ReloadSelectedCourseAsync()
	{
		if (_editingCourse is null)
		{
			return;
		}

		var refreshedCourse = await CourseService.GetByIdAsync(_editingCourse.Id);
		_editingCourse = refreshedCourse is null ? null : CloneCourse(refreshedCourse);
		await PersistEditingDraftAsync();
	}

	private static Course CloneCourse(Course course)
	{
		return new Course
		{
			Id = course.Id,
			Title = course.Title,
			Slug = course.Slug,
			Description = course.Description,
			Level = course.Level,
			DurationHours = course.DurationHours,
			CreditHours = course.CreditHours,
			Jurisdiction = course.Jurisdiction,
			Price = course.Price,
			IsPublished = course.IsPublished,
			IsArchived = course.IsArchived,
			OwnerInstructorId = course.OwnerInstructorId,
			ReviewStatus = course.ReviewStatus,
			ReviewNote = course.ReviewNote,
			ReviewedByUserId = course.ReviewedByUserId,
			ReviewedAt = course.ReviewedAt,
			CreatedAt = course.CreatedAt,
			UpdatedAt = course.UpdatedAt,
			Modules = course.Modules
				.OrderBy(module => module.OrderIndex)
				.Select(CloneModule)
				.ToList()
		};
	}

	private static Module CloneModule(Module module)
	{
		return new Module
		{
			Id = module.Id,
			CourseId = module.CourseId,
			Title = module.Title,
			OrderIndex = module.OrderIndex,
			Lessons = module.Lessons
				.OrderBy(lesson => lesson.OrderIndex)
				.Select(CloneLesson)
				.ToList()
		};
	}

	private static Lesson CloneLesson(Lesson lesson)
	{
		return new Lesson
		{
			Id = lesson.Id,
			ModuleId = lesson.ModuleId,
			Title = lesson.Title,
			ContentType = lesson.ContentType,
			ContentUrl = lesson.ContentUrl,
			TextContent = lesson.TextContent,
			DurationMinutes = lesson.DurationMinutes,
			OrderIndex = lesson.OrderIndex,
			IsRequired = lesson.IsRequired
		};
	}
}
