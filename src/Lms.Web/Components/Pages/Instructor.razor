	private async Task DeleteLessonAsync(Guid lessonId)
	{
		var confirmed = await ShowConfirmDialogAsync("Delete this lesson? This cannot be undone.");
		if (!confirmed)
		{
			return;
		}

		await CourseService.DeleteLessonAsync(lessonId);
		await ReloadSelectedCourseAsync();
		await ReloadCheckpointsAsync();

		if (_editingCourse is not null && _editingModule is not null)
		{
			var refreshedModule = _editingCourse.Modules.FirstOrDefault(module => module.Id == _editingModule.Id);
			if (refreshedModule is not null)
			{
				BeginEditingModule(refreshedModule);
			}
		}
	}

	private async Task DeleteModuleAsync(Module module)
	{
		if (module.Lessons.Count > 0 || _checkpoints.Any(checkpoint => checkpoint.ModuleId == module.Id))
		{
			await ShowAlertDialogAsync("Delete all lessons and checkpoints in this module before deleting it.");
			return;
		}

		var confirmed = await ShowConfirmDialogAsync("Delete this module? This cannot be undone.");
		if (!confirmed)
		{
			return;
		}

		var deleted = await CourseService.DeleteModuleAsync(module.Id);
		if (!deleted)
		{
			await ShowAlertDialogAsync("Delete all lessons and checkpoints in this module before deleting it.");
			return;
		}

		await ReloadSelectedCourseAsync();
		await ReloadCheckpointsAsync();
	}

