						</div>
						<div class="form-field">
							<label>Minimum pass %</label>
							<InputNumber @bind-Value="_newCourseDraft.MinimumPassingPercent" @bind-Value:after="SaveCreateDraftAsync" />
						</div>
						<div class="form-field">
							<label>Minimum attendance %</label>
