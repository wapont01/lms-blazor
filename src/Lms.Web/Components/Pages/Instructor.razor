	private const string CreateDraftStorageKey = "instructor-create-draft";
	private const string EditingCourseDraftPrefix = "instructor-edit-draft-";

	private sealed class InstructorCourseDraftState
	{
		public string Title { get; set; } = string.Empty;
		public string Description { get; set; } = string.Empty;
		public string Level { get; set; } = string.Empty;
		public int DurationHours { get; set; }
		public int CreditHours { get; set; }
		public string State { get; set; } = string.Empty;
		public decimal Price { get; set; }
	}

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;

		var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
		if (Guid.TryParse(idClaim, out var parsedId))
		{
			_actorUserId = parsedId;
		}

		_actorEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? user.Identity?.Name ?? _actorEmail;
		_isAdmin = user.IsInRole("Admin");

		await RefreshCoursesAsync();
		_users = await UserAccountService.GetAllAsync();
		await RestoreCreateDraftAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		if (CourseId == Guid.Empty)
		{
			if (_editingCourse is not null)
			{
				ClearSelection();
			}

			return;
		}

		if (_editingCourse is null || _editingCourse.Id != CourseId)
		{
			var course = _courses.FirstOrDefault(candidate => candidate.Id == CourseId);
			if (course is null)
			{
				await RefreshCoursesAsync();
				course = _courses.FirstOrDefault(candidate => candidate.Id == CourseId);
			}

			if (course is null)
			{
				NavigationManager.NavigateTo("/instructor");
				return;
			}

			await BeginEditing(course);
		}

		_activeEditorStep = ParseEditorStep(Step);

		if (_editingCourse is null)
		{
			return;
		}

		if (_activeEditorStep == CourseEditorStep.Modules && SubId.HasValue && _editingModule?.Id != SubId.Value)
		{
			var module = _editingCourse.Modules.FirstOrDefault(candidate => candidate.Id == SubId.Value);
			if (module is not null)
			{
				BeginEditingModule(module);
			}
		}
		else if (_activeEditorStep == CourseEditorStep.Checkpoints)
		{
			var isFinal = !SubId.HasValue;
			var alreadyMatching = _editingCheckpoint is not null
				&& _editingCheckpoint.IsFinal == isFinal
				&& (isFinal || _editingCheckpoint.ModuleId == SubId);

			if (!alreadyMatching)
			{
				BeginEditingCheckpoint(SubId, isFinal);
			}
		}
	}

	private void ShowCreateView()
	{
		_showCreateMode = true;
	}

	private void ShowEditView()
	{
		_showCreateMode = false;
	}

	private string GetEditorStepLabel(CourseEditorStep step)
	{
		return step switch
		{
			CourseEditorStep.Modules => "Units",
			CourseEditorStep.Checkpoints => "Checkpoints",
			CourseEditorStep.Assessment => "Assessment",
			_ => "Overview"
		};
	}

	private static CourseEditorStep ParseEditorStep(string? step)
	{
		return step?.ToLowerInvariant() switch
		{
			"units" => CourseEditorStep.Modules,
			"modules" => CourseEditorStep.Modules,
			"checkpoints" => CourseEditorStep.Checkpoints,
			"assessment" => CourseEditorStep.Assessment,
			_ => CourseEditorStep.Overview
		};
	}

	private static string GetEditorStepSlug(CourseEditorStep step)
	{
		return step switch
		{
			CourseEditorStep.Modules => "units",
			CourseEditorStep.Checkpoints => "checkpoints",
			CourseEditorStep.Assessment => "assessment",
			_ => "overview"
		};
	}

	private string BuildEditorUri(Guid courseId, CourseEditorStep step, Guid? subId = null)
	{
		var uri = $"/instructor/courses/{courseId}/{GetEditorStepSlug(step)}";
		return subId.HasValue ? $"{uri}/{subId.Value}" : uri;
	}

	private void NextEditorStep()
	{
		if (_editingCourse is not null && _activeEditorStep < CourseEditorStep.Assessment)
		{
			NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, _activeEditorStep + 1));
		}
	}

	private void PreviousEditorStep()
	{
		if (_editingCourse is not null && _activeEditorStep > CourseEditorStep.Overview)
		{
			NavigationManager.NavigateTo(BuildEditorUri(_editingCourse.Id, _activeEditorStep - 1));
		}
	}

	private List<Course> GetVisibleCourses()
	{
		var visible = _courses.AsEnumerable();

		if (!string.IsNullOrWhiteSpace(_courseSearchText))
		{
			var search = _courseSearchText.Trim();
			visible = visible.Where(course => course.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
				|| course.Description.Contains(search, StringComparison.OrdinalIgnoreCase));
		}

		visible = _courseStatusFilter switch
		{
			"draft" => visible.Where(course => course.ReviewStatus == CourseReviewStatuses.Draft && !course.IsPublished),
			"pending" => visible.Where(course => course.ReviewStatus == CourseReviewStatuses.PendingReview),
			"changes" => visible.Where(course => course.ReviewStatus == CourseReviewStatuses.ChangesRequested),
			"approved" => visible.Where(course => course.ReviewStatus == CourseReviewStatuses.Approved),
			"published" => visible.Where(course => course.IsPublished),
			_ => visible
		};

		return _courseSortOption switch
		{
			"title" => visible.OrderBy(course => course.Title, StringComparer.OrdinalIgnoreCase).ToList(),
			"status" => visible.OrderBy(course => GetCourseStatusLabel(course), StringComparer.OrdinalIgnoreCase).ToList(),
			_ => visible.OrderByDescending(course => course.UpdatedAt ?? course.CreatedAt).ToList()
		};
	}

	private string GetCourseStatusLabel(Course course)
	{
		if (course.IsArchived)
		{
			return "Archived";
		}

		if (course.ReviewStatus == CourseReviewStatuses.PendingReview)
		{
			return "Pending review";
		}

		if (course.ReviewStatus == CourseReviewStatuses.ChangesRequested)
		{
			return "Changes requested";
		}

		if (course.ReviewStatus == CourseReviewStatuses.Approved)
		{
			return "Approved";
		}

		if (course.ReviewStatus == CourseReviewStatuses.Rejected)
		{
			return "Rejected";
		}

		return course.IsPublished ? "Published" : "Draft";
	}

	private string GetCourseStatusClass(Course course)
	{
		if (course.IsArchived)
		{
			return "status-pill-archived";
		}

		return course.ReviewStatus switch
		{
			CourseReviewStatuses.PendingReview => "status-pill-pending",
			CourseReviewStatuses.ChangesRequested => "status-pill-changes",
			CourseReviewStatuses.Approved => "status-pill-approved",
			CourseReviewStatuses.Rejected => "status-pill-rejected",
			_ => course.IsPublished ? "status-pill-published" : "status-pill-draft"
		};
	}

	private static bool CanSubmitForReview(Course course)
	{
		return course.ReviewStatus is Lms.Domain.Entities.CourseReviewStatuses.Draft
			or Lms.Domain.Entities.CourseReviewStatuses.ChangesRequested
			or Lms.Domain.Entities.CourseReviewStatuses.Rejected;
	}

	private async Task SaveCreateDraftAsync()
	{
		try
		{
			await JSRuntime.InvokeVoidAsync("localStorage.setItem", CreateDraftStorageKey, JsonSerializer.Serialize(new InstructorCourseDraftState
			{
				Title = _newCourseDraft.Title,
				Description = _newCourseDraft.Description,
				Level = _newCourseDraft.Level,
				DurationHours = _newCourseDraft.DurationHours,
				CreditHours = _newCourseDraft.CreditHours,
				State = _newCourseDraft.State,
				Price = _newCourseDraft.Price
			}));
		}
		catch (InvalidOperationException)
		{
			// Ignore when browser storage is unavailable during prerendering.
		}
	}

	private async Task RestoreCreateDraftAsync()
	{
		try
		{
			var savedDraft = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", CreateDraftStorageKey);
			if (string.IsNullOrWhiteSpace(savedDraft))
			{
				return;
			}

			var restoredDraft = JsonSerializer.Deserialize<InstructorCourseDraftState>(savedDraft);
			if (restoredDraft is null)
			{
				return;
			}

			_newCourseDraft.Title = restoredDraft.Title;
			_newCourseDraft.Description = restoredDraft.Description;
			_newCourseDraft.Level = restoredDraft.Level;
			_newCourseDraft.DurationHours = restoredDraft.DurationHours;
			_newCourseDraft.CreditHours = restoredDraft.CreditHours;
			_newCourseDraft.State = restoredDraft.State;
			_newCourseDraft.Price = restoredDraft.Price;
		}
		catch (InvalidOperationException)
		{
			// Ignore when browser storage is unavailable during prerendering.
		}
	}

	private async Task ClearCreateDraftAsync()
	{
		try
		{
			await JSRuntime.InvokeVoidAsync("localStorage.removeItem", CreateDraftStorageKey);
		}
		catch (InvalidOperationException)
		{
			// Ignore when browser storage is unavailable during prerendering.
		}
	}

	private async Task PersistEditingDraftAsync()
	{
		if (_editingCourse is null)
		{
			return;
		}

		try
		{
			await JSRuntime.InvokeVoidAsync("localStorage.setItem", $"{EditingCourseDraftPrefix}{_editingCourse.Id}", JsonSerializer.Serialize(_editingCourse));
		}
		catch (InvalidOperationException)
		{
			// Ignore when browser storage is unavailable during prerendering.
		}
	}

	private async Task RestoreEditingDraftAsync(Course course)
	{
		try
		{
			var savedDraft = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", $"{EditingCourseDraftPrefix}{course.Id}");
			if (string.IsNullOrWhiteSpace(savedDraft))
			{
				_editingCourse = CloneCourse(course);
				return;
			}

			var restoredDraft = JsonSerializer.Deserialize<Course>(savedDraft);
			_editingCourse = restoredDraft is null ? CloneCourse(course) : CloneCourse(restoredDraft);
		}
		catch (InvalidOperationException)
		{
			_editingCourse = CloneCourse(course);
		}
	}

	private async Task SubmitCourseForReviewAsync()
	{
		if (_editingCourse is null || !_actorUserId.HasValue)
		{
			return;
		}

		var succeeded = await CourseService.SubmitForReviewAsync(_editingCourse.Id, _actorUserId.Value);
		_reviewStatusMessage = succeeded ? "Course submitted for admin review." : "Unable to submit this course for review.";

		await RefreshCoursesAsync();
	}

	private async Task BeginEditing(Course course)
	{
		await RestoreEditingDraftAsync(course);
		ShowEditView();
		_activeEditorStep = CourseEditorStep.Overview;
		ClearModuleSelection();
		ClearLessonSelection();
		CancelCheckpointEditing();
		await ReloadCheckpointsAsync();
		await LoadAssessmentEditorAsync();
	}

	private async Task SaveCourseAsync()
	{
		if (_editingCourse is null)
		{
			return;
		}

		var editedCourseId = _editingCourse.Id;

		if (_editingCourse.IsArchived)
		{
			_editingCourse.IsPublished = false;
		}

		await CourseService.UpdateAsync(_editingCourse);
		await PersistEditingDraftAsync();
		await RefreshCoursesAsync();

		var refreshedCourse = _courses.FirstOrDefault(course => course.Id == editedCourseId);
		_editingCourse = refreshedCourse is null ? null : CloneCourse(refreshedCourse);
	}

	private void ClearSelection()
	{
		_editingCourse = null;
		_activeEditorStep = CourseEditorStep.Overview;
		ShowEditView();
		_assessmentCourseId = null;
		_assessmentCourseIdText = string.Empty;
		_assessmentEditor = null;
		_retakeGrants.Clear();
		_retakeGrantDraftAttempts.Clear();
		ClearModuleSelection();
		ClearLessonSelection();
	}

	private async Task RefreshCoursesAsync()
	{
		_courses = _isAdmin || !_actorUserId.HasValue
			? await CourseService.GetAllAsync()
			: await CourseService.GetCoursesForInstructorAsync(_actorUserId.Value);

		if (_editingCourse is not null)
		{
			var refreshedCourse = _courses.FirstOrDefault(course => course.Id == _editingCourse.Id);
			_editingCourse = refreshedCourse is null ? null : CloneCourse(refreshedCourse);
		}
	}

	private async Task AddModuleAsync()
	{
		if (_editingCourse is null || string.IsNullOrWhiteSpace(_newModuleTitle))
		{
			return;
		}

		await CourseService.AddModuleAsync(_editingCourse.Id, new Module
		{
			Title = _newModuleTitle.Trim()
		});

		_newModuleTitle = string.Empty;
		await ReloadSelectedCourseAsync();
	}

	private async Task HandleImportFileSelection(InputFileChangeEventArgs e)
	{
		var file = e.File;
		if (file is null)
		{
			return;
		}

		await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
		using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true, leaveOpen: false);
		_importText = await reader.ReadToEndAsync();
		_importStatusMessage = $"Loaded {file.Name} ({file.Size} bytes).";
	}

	private Task HandleImportTextChanged(string? value)
	{
		_importText = value ?? string.Empty;
		return Task.CompletedTask;
	}

	private async Task ImportCourseStructureAsync()
	{
		if (_editingCourse is null || string.IsNullOrWhiteSpace(_importText))
		{
			_importStatusMessage = "Enter some import text before importing.";
			return;
		}

		await CourseService.ImportCourseStructureAsync(_editingCourse.Id, _importText);
		_importText = string.Empty;
		_importStatusMessage = "Course structure imported.";
		CancelCheckpointEditing();
		await ReloadSelectedCourseAsync();
		await ReloadCheckpointsAsync();
	}

	private async Task CreateCourseAsync()
	{
		_createCourseMessage = null;

		_newCourseDraft.Slug = CreateSlug(_newCourseDraft.Title);
		_newCourseDraft.IsArchived = false;
		_newCourseDraft.OwnerInstructorId = _actorUserId;

		var created = await CourseService.CreateAsync(_newCourseDraft);

		_newCourseDraft = new Course
		{
			Level = "Beginner",
			State = "General",
			DurationHours = 0,
			CreditHours = 0,
			Price = 0m
		};

		await ClearCreateDraftAsync();
		await RefreshCoursesAsync();
		_createCourseMessage = "Course created.";

		var createdCourse = _courses.FirstOrDefault(course => course.Id == created.Id);
		if (createdCourse is not null)
		{
			await BeginEditing(createdCourse);
		}
		else
		{
			ShowEditView();
		}
	}

	private static string CreateSlug(string? title)
	{
		if (string.IsNullOrWhiteSpace(title))
		{
			return string.Empty;
		}

		var slug = title.Trim().ToLowerInvariant();
		return string.Concat(slug.Select(character => char.IsLetterOrDigit(character) ? character : '-'))
			.Replace("--", "-")
			.Trim('-');
	}

	private bool HasModuleCheckpoint(Guid moduleId)
	{
		return _checkpoints.Any(checkpoint => !checkpoint.IsFinal && checkpoint.ModuleId == moduleId);
	}

	private bool HasFinalCheckpoint()
	{
		return _checkpoints.Any(checkpoint => checkpoint.IsFinal);
	}

	private string GetModuleCheckpointSummary(Guid moduleId)
	{
		var checkpoint = _checkpoints.FirstOrDefault(checkpoint => !checkpoint.IsFinal && checkpoint.ModuleId == moduleId);
		return checkpoint is null ? "No checkpoint configured." : $"Checkpoint: {checkpoint.Title}";
	}

	private string GetModuleTitle(Guid? moduleId)
	{
		return _editingCourse?.Modules.FirstOrDefault(module => module.Id == moduleId)?.Title ?? "unit";
	}

	private void BeginEditingCheckpoint(Guid? moduleId, bool isFinal)
	{
		if (_editingCourse is null)
		{
			return;
		}

		_checkpointError = null;
		_checkpointMessage = null;

		var existing = isFinal
			? _checkpoints.FirstOrDefault(checkpoint => checkpoint.IsFinal)
			: _checkpoints.FirstOrDefault(checkpoint => !checkpoint.IsFinal && checkpoint.ModuleId == moduleId);

		if (existing is not null)
		{
			_editingCheckpoint = new CheckpointDefinitionEditorModel
			{
				Id = existing.Id,
				CourseId = existing.CourseId,
				ModuleId = existing.ModuleId,
				IsFinal = existing.IsFinal,
				Title = existing.Title,
				Prompt = existing.Prompt,
				Description = existing.Description,
				Options = existing.Options
					.OrderBy(option => option.OrderIndex)
					.Select(option => new CheckpointOptionEditorItem
					{
						Id = option.Id,
						Label = option.Label,
						IsCorrect = option.IsCorrect
					})
					.ToList()
			};
		}
		else
		{
			_editingCheckpoint = new CheckpointDefinitionEditorModel
			{
				CourseId = _editingCourse.Id,
				ModuleId = isFinal ? null : moduleId,
				IsFinal = isFinal,
				Title = isFinal ? "Final Checkpoint" : "Unit Checkpoint",
				Prompt = string.Empty,
				Description = string.Empty,
				Options = new List<CheckpointOptionEditorItem>
				{
					new() { Label = string.Empty, IsCorrect = true },
					new() { Label = string.Empty, IsCorrect = false }
				}
			};
		}
	}

	private void AddCheckpointOption()
	{
		_editingCheckpoint?.Options.Add(new CheckpointOptionEditorItem { Label = string.Empty, IsCorrect = false });
	}

	private void RemoveCheckpointOption(int index)
	{
		if (_editingCheckpoint is null || index < 0 || index >= _editingCheckpoint.Options.Count)
		{
			return;
		}

		_editingCheckpoint.Options.RemoveAt(index);
	}

	private async Task SaveCheckpointAsync()
	{
		_checkpointError = null;
		_checkpointMessage = null;

		if (_editingCheckpoint is null)
		{
			return;
		}

		if (string.IsNullOrWhiteSpace(_editingCheckpoint.Title) || string.IsNullOrWhiteSpace(_editingCheckpoint.Prompt))
		{
			_checkpointError = "Title and prompt are required.";
			return;
		}

		if (_editingCheckpoint.Options.Count < 2 || _editingCheckpoint.Options.All(option => !option.IsCorrect) || _editingCheckpoint.Options.Any(option => string.IsNullOrWhiteSpace(option.Label)))
		{
			_checkpointError = "Add at least two options with labels, and mark at least one as correct.";
			return;
		}

		await CourseService.SaveCheckpointDefinitionAsync(_editingCheckpoint);
		_checkpointMessage = "Checkpoint saved.";
		_editingCheckpoint = null;
		await ReloadCheckpointsAsync();
	}

	private async Task DeleteCheckpointAsync()
	{
		if (_editingCheckpoint?.Id is null)
		{
			return;
		}

		await CourseService.DeleteCheckpointDefinitionAsync(_editingCheckpoint.Id.Value);
		_checkpointMessage = "Checkpoint deleted.";
		_editingCheckpoint = null;
		await ReloadCheckpointsAsync();
	}

	private void CancelCheckpointEditing()
	{
		_editingCheckpoint = null;
		_checkpointError = null;
		_checkpointMessage = null;
	}

	private async Task ReloadCheckpointsAsync()
	{
		_checkpoints = _editingCourse is null
			? new List<CourseCheckpointDefinition>()
			: await CourseService.GetCheckpointDefinitionsForEditingAsync(_editingCourse.Id);
	}

	private Task OnAssessmentCourseChanged(ChangeEventArgs args)
	{
		_assessmentCourseIdText = args.Value?.ToString() ?? string.Empty;
		_assessmentCourseId = Guid.TryParse(_assessmentCourseIdText, out var parsed) ? parsed : null;
		_assessmentEditor = null;
		_assessmentError = null;
		_assessmentMessage = null;
		_retakeGrants.Clear();
		_retakeGrantDraftAttempts.Clear();
		return Task.CompletedTask;
	}

	private async Task LoadAssessmentEditorAsync()
	{
		_assessmentError = null;
		_assessmentMessage = null;

		if (_editingCourse is null)
		{
			_assessmentCourseId = null;
			_assessmentCourseIdText = string.Empty;
			_assessmentEditor = null;
			_retakeGrants.Clear();
			_retakeGrantDraftAttempts.Clear();
			_assessmentMessage = "Select a course to manage its final assessment.";
			return;
		}

		_assessmentCourseId = _editingCourse.Id;
		_assessmentCourseIdText = _assessmentCourseId.Value.ToString();
		_assessmentEditor = await AssessmentService.GetAssessmentEditorAsync(_assessmentCourseId.Value);
		_retakeGrants = await AssessmentService.GetRetakeGrantsAsync(_assessmentCourseId.Value);
		_retakeGrantDraftAttempts.Clear();
		_assessmentMessage = _assessmentEditor is null
			? "No assessment is available for this course."
			: "Assessment loaded.";

		if (_retakeLearnerId is null && _users.Any(user => user.Role == "Learner"))
		{
			_retakeLearnerId = _users.First(user => user.Role == "Learner").Id;
		}
	}

	private void AddAssessmentQuestion()
	{
		_assessmentEditor ??= new AssessmentEditorModel();

		_assessmentEditor.Questions.Add(new AssessmentQuestionEditorItem
		{
			OrderIndex = _assessmentEditor.Questions.Count + 1,
			CorrectOption = "A",
			Prompt = "",
			OptionA = "",
			OptionB = "",
			OptionC = "",
			OptionD = ""
		});
	}

	private void RemoveAssessmentQuestion(int index)
	{
		if (_assessmentEditor is null || index < 0 || index >= _assessmentEditor.Questions.Count)
		{
			return;
		}

		_assessmentEditor.Questions.RemoveAt(index);
		for (var i = 0; i < _assessmentEditor.Questions.Count; i++)
		{
			_assessmentEditor.Questions[i].OrderIndex = i + 1;
		}
	}

	private async Task SaveAssessmentEditorAsync()
	{
		_assessmentError = null;
		_assessmentMessage = null;

		if (!_assessmentCourseId.HasValue || _assessmentEditor is null)
		{
			_assessmentError = "Load an assessment before saving.";
			return;
		}

		if (!_actorUserId.HasValue)
		{
			_assessmentError = "Unable to identify the signed in account.";
			return;
		}

		try
		{
			await AssessmentService.SaveAssessmentEditorAsync(_assessmentCourseId.Value, _assessmentEditor, _actorUserId.Value, _actorEmail);
			_assessmentMessage = "Assessment saved. Existing attempts were reset for this course.";
			await LoadAssessmentEditorAsync();
		}
		catch (InvalidOperationException exception)
		{
			_assessmentError = exception.Message;
		}
	}

	private Task OnRetakeLearnerChanged(ChangeEventArgs args)
	{
		_retakeLearnerId = Guid.TryParse(args.Value?.ToString(), out var parsed) ? parsed : null;
		return Task.CompletedTask;
	}

	private string GetRetakeLearnerIdText()
	{
		return _retakeLearnerId?.ToString("D") ?? string.Empty;
	}

	private Task OnRetakeGrantAttemptsChanged(int value)
	{
		_retakeGrantAttempts = value;
		return Task.CompletedTask;
	}

	private Task OnResetCooldownTimerOnRetakeGrantChanged(bool value)
	{
		_resetCooldownTimerOnRetakeGrant = value;
		return Task.CompletedTask;
	}

	private async Task GrantRetakeAsync()
	{
		_assessmentError = null;
		_assessmentMessage = null;

		if (!_assessmentCourseId.HasValue || !_retakeLearnerId.HasValue)
		{
			_assessmentError = "Select both course and learner before granting retake.";
			return;
		}

		if (!_actorUserId.HasValue)
		{
			_assessmentError = "Unable to identify the signed in account.";
			return;
		}

		try
		{
			await AssessmentService.GrantRetakeAsync(_assessmentCourseId.Value, _retakeLearnerId.Value, Math.Max(_retakeGrantAttempts, 1), _resetCooldownTimerOnRetakeGrant, _actorUserId.Value, _actorEmail);
			_retakeGrants = await AssessmentService.GetRetakeGrantsAsync(_assessmentCourseId.Value);
			_retakeGrantDraftAttempts.Clear();
			_assessmentMessage = _resetCooldownTimerOnRetakeGrant
				? "Retake attempts granted and cooldown timer reset successfully."
				: "Retake attempts granted successfully.";
		}
		catch (InvalidOperationException exception)
		{
			_assessmentError = exception.Message;
		}
	}

	private int GetRetakeGrantDraft(Guid learnerUserId, int fallback)
	{
		return _retakeGrantDraftAttempts.TryGetValue(learnerUserId, out var value) ? value : fallback;
	}

	private void SetRetakeGrantDraft(Guid learnerUserId, string? rawValue)
	{
		if (!int.TryParse(rawValue, out var parsed) || parsed < 1)
		{
			_retakeGrantDraftAttempts.Remove(learnerUserId);
			return;
		}

		_retakeGrantDraftAttempts[learnerUserId] = parsed;
	}

	private async Task UpdateRetakeGrantAsync(RetakeGrantView grant)
	{
		_assessmentError = null;
		_assessmentMessage = null;

		if (!_assessmentCourseId.HasValue || !_actorUserId.HasValue)
		{
			_assessmentError = "Select a course and ensure an instructor account is active.";
			return;
		}

		var attempts = GetRetakeGrantDraft(grant.LearnerUserId, grant.GrantedAttempts);

		try
		{
			await AssessmentService.SetRetakeGrantAttemptsAsync(_assessmentCourseId.Value, grant.LearnerUserId, attempts, _resetCooldownTimerOnRetakeGrant, _actorUserId.Value, _actorEmail);
			_retakeGrants = await AssessmentService.GetRetakeGrantsAsync(_assessmentCourseId.Value);
			_retakeGrantDraftAttempts.Clear();
			_assessmentMessage = _resetCooldownTimerOnRetakeGrant
				? "Retake grant updated and cooldown timer reset."
				: "Retake grant updated.";
		}
		catch (InvalidOperationException exception)
		{
			_assessmentError = exception.Message;
		}
	}

	private async Task RevokeRetakeGrantAsync(RetakeGrantView grant)
	{
		_assessmentError = null;
		_assessmentMessage = null;

		if (!_assessmentCourseId.HasValue || !_actorUserId.HasValue)
		{
			_assessmentError = "Select a course and ensure an instructor account is active.";
			return;
		}

		try
		{
			await AssessmentService.RevokeRetakeGrantAsync(_assessmentCourseId.Value, grant.LearnerUserId, _actorUserId.Value, _actorEmail);
			_retakeGrants = await AssessmentService.GetRetakeGrantsAsync(_assessmentCourseId.Value);
			_retakeGrantDraftAttempts.Clear();
			_assessmentMessage = "Retake grant revoked.";
		}
		catch (InvalidOperationException exception)
		{
			_assessmentError = exception.Message;
		}
	}

	private void BeginEditingModule(Module module)
	{
		_editingModule = CloneModule(module);
		ClearLessonSelection();
	}

	private async Task SaveModuleAsync()
	{
		if (_editingModule is null)
		{
			return;
		}

		await CourseService.UpdateModuleAsync(_editingModule);
		await ReloadSelectedCourseAsync();
		await PersistEditingDraftAsync();
		BeginEditingModule(_editingCourse!.Modules.First(module => module.Id == _editingModule.Id));
	}

	private void ClearModuleSelection()
	{
		_editingModule = null;
		_newModuleTitle = string.Empty;
	}

	private async Task AddLessonAsync()
	{
		if (_editingModule is null || string.IsNullOrWhiteSpace(_newLessonTitle))
		{
			return;
		}

		await CourseService.AddLessonAsync(_editingModule.Id, new Lesson
		{
			Title = _newLessonTitle.Trim(),
			TextContent = _newLessonText,
			DurationMinutes = _newLessonDurationMinutes,
			IsRequired = _newLessonRequired
		});

		_newLessonTitle = string.Empty;
		_newLessonText = string.Empty;
		_newLessonDurationMinutes = 0;
		_newLessonRequired = true;
		await ReloadSelectedCourseAsync();
		await PersistEditingDraftAsync();
		if (_editingCourse is not null)
		{
			var refreshedModule = _editingCourse.Modules.FirstOrDefault(module => module.Id == _editingModule.Id);
			_editingModule = refreshedModule is null ? null : CloneModule(refreshedModule);
		}
	}

	private void BeginEditingLesson(Lesson lesson)
	{
		_editingLesson = CloneLesson(lesson);
	}

	private async Task SaveLessonAsync()
	{
		if (_editingLesson is null)
		{
			return;
		}

		await CourseService.UpdateLessonAsync(_editingLesson);
		await ReloadSelectedCourseAsync();
		await PersistEditingDraftAsync();
		if (_editingModule is not null)
		{
			var refreshedModule = _editingCourse?.Modules.FirstOrDefault(module => module.Id == _editingModule.Id);
			_editingModule = refreshedModule is null ? null : CloneModule(refreshedModule);
		}
		if (_editingModule is not null)
		{
			var refreshedLesson = _editingModule.Lessons.FirstOrDefault(lesson => lesson.Id == _editingLesson.Id);
			_editingLesson = refreshedLesson is null ? null : CloneLesson(refreshedLesson);
		}
	}

	private void ClearLessonSelection()
	{
		_editingLesson = null;
		_newLessonTitle = string.Empty;
		_newLessonText = string.Empty;
		_newLessonDurationMinutes = 0;
		_newLessonRequired = true;
	}

	private async Task ReloadSelectedCourseAsync()
	{
		if (_editingCourse is null)
		{
			return;
		}

		var refreshedCourse = await CourseService.GetByIdAsync(_editingCourse.Id);
		_editingCourse = refreshedCourse is null ? null : CloneCourse(refreshedCourse);
		await PersistEditingDraftAsync();
	}

	private static Course CloneCourse(Course course)
	{
		return new Course
		{
			Id = course.Id,
			Title = course.Title,
			Slug = course.Slug,
			Description = course.Description,
			Level = course.Level,
			DurationHours = course.DurationHours,
			CreditHours = course.CreditHours,
			State = course.State,
			Price = course.Price,
			IsPublished = course.IsPublished,
			IsArchived = course.IsArchived,
			OwnerInstructorId = course.OwnerInstructorId,
			ReviewStatus = course.ReviewStatus,
			ReviewNote = course.ReviewNote,
			ReviewedByUserId = course.ReviewedByUserId,
			ReviewedAt = course.ReviewedAt,
			CreatedAt = course.CreatedAt,
			UpdatedAt = course.UpdatedAt,
			Modules = course.Modules
				.OrderBy(module => module.OrderIndex)
				.Select(CloneModule)
				.ToList()
		};
	}

	private static Module CloneModule(Module module)
	{
		return new Module
		{
			Id = module.Id,
			CourseId = module.CourseId,
			Title = module.Title,
			OrderIndex = module.OrderIndex,
			Lessons = module.Lessons
				.OrderBy(lesson => lesson.OrderIndex)
				.Select(CloneLesson)
				.ToList()
		};
	}

	private static Lesson CloneLesson(Lesson lesson)
	{
		return new Lesson
		{
			Id = lesson.Id,
			ModuleId = lesson.ModuleId,
			Title = lesson.Title,
			ContentType = lesson.ContentType,
			ContentUrl = lesson.ContentUrl,
			TextContent = lesson.TextContent,
			DurationMinutes = lesson.DurationMinutes,
			OrderIndex = lesson.OrderIndex,
			IsRequired = lesson.IsRequired
		};
	}
}
