		}

		var succeeded = await CourseService.SubmitForReviewAsync(_editingCourse.Id, _actorUserId.Value);
		_reviewStatusMessage = succeeded ? "Course submitted for admin review." : "Unable to submit this course for review.";

		await RefreshCoursesAsync();
	}

