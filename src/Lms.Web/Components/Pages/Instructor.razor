	private string GetModuleLessonsSummary(Module module)
	{
		if (module.Lessons.Count == 0)
		{
			return "0 lessons";
		}

		var lessonTitles = string.Join(", ", module.Lessons.OrderBy(lesson => lesson.OrderIndex).Select(lesson => lesson.Title));
		return $"{module.Lessons.Count} lessons: {lessonTitles}";
	}

	private string GetModuleTitle(Guid? moduleId)
	{
		return _editingCourse?.Modules.FirstOrDefault(module => module.Id == moduleId)?.Title ?? "module";
	}

	private string GetCheckpointAnchorLabel(CourseCheckpointDefinition checkpoint)
	{
		if (checkpoint.LessonId is null)
		{
			return "End of module";
		}

		if (checkpoint.LessonId == CourseCheckpointDefinition.StartOfModuleAnchor)
		{
			return "Start of module";
		}

		var module = _editingCourse?.Modules.FirstOrDefault(candidate => candidate.Id == checkpoint.ModuleId);
		var lesson = module?.Lessons.FirstOrDefault(candidate => candidate.Id == checkpoint.LessonId.Value);
		return lesson is null ? "After a lesson" : $"After \"{lesson.Title}\"";
	}

	// Orders a module's checkpoints the same way they're rendered (start-of-module first, then lesson-anchored
	// in lesson order, then end-of-module), so numbering matches display.
	private List<CourseCheckpointDefinition> GetOrderedModuleCheckpoints(Module module)
	{
		var lessonOrder = module.Lessons
			.OrderBy(lesson => lesson.OrderIndex)
			.Select(lesson => lesson.Id)
			.ToList();

		return _checkpoints
			.Where(checkpoint => checkpoint.ModuleId == module.Id)
			.OrderBy(checkpoint => checkpoint.LessonId == CourseCheckpointDefinition.StartOfModuleAnchor
				? -1
				: checkpoint.LessonId.HasValue ? lessonOrder.IndexOf(checkpoint.LessonId.Value) : int.MaxValue)
			.ThenBy(checkpoint => checkpoint.OrderIndex)
			.ThenBy(checkpoint => checkpoint.Title, StringComparer.OrdinalIgnoreCase)
			.ToList();
	}

	// Flattens a module's lessons and checkpoints into the single sequence learners actually encounter
	// (start-of-module checkpoints, lesson, its anchored checkpoints, next lesson, ..., end-of-module
	// checkpoints last), so numbering is one continuous count rather than separate counts.
	private List<Guid> GetOrderedModuleItemIds(Module module)
	{
		var orderedCheckpoints = GetOrderedModuleCheckpoints(module);
		var itemIds = new List<Guid>();

		itemIds.AddRange(orderedCheckpoints.Where(checkpoint => checkpoint.LessonId == CourseCheckpointDefinition.StartOfModuleAnchor).Select(checkpoint => checkpoint.Id));

		foreach (var lesson in module.Lessons.OrderBy(lesson => lesson.OrderIndex))
		{
			itemIds.Add(lesson.Id);
			itemIds.AddRange(orderedCheckpoints.Where(checkpoint => checkpoint.LessonId == lesson.Id).Select(checkpoint => checkpoint.Id));
		}

		itemIds.AddRange(orderedCheckpoints.Where(checkpoint => checkpoint.LessonId is null).Select(checkpoint => checkpoint.Id));

		return itemIds;
	}

	private int GetModuleItemNumber(Module module, Guid itemId)
	{
		var index = GetOrderedModuleItemIds(module).IndexOf(itemId);
		return index >= 0 ? index + 1 : 1;
	}

	private string BuildDefaultCheckpointTitle(Guid? moduleId)
	{
		var moduleTitle = GetModuleTitle(moduleId);
		var existingCount = moduleId.HasValue
			? _checkpoints.Count(checkpoint => checkpoint.ModuleId == moduleId.Value)
			: 0;

		return existingCount == 0 ? $"{moduleTitle} Checkpoint" : $"{moduleTitle} Checkpoint {existingCount + 1}";
	}

	private void BeginEditingCheckpoint(Guid? moduleId, Guid? checkpointId = null)
	{
		if (_editingCourse is null)
		{
			return;
		}

		_checkpointError = null;
		_checkpointMessage = null;

		var existing = checkpointId.HasValue
			? _checkpoints.FirstOrDefault(checkpoint => checkpoint.Id == checkpointId.Value)
			: null;

		if (existing is not null)
		{
			_editingCheckpoint = new CheckpointDefinitionEditorModel
			{
				Id = existing.Id,
				CourseId = existing.CourseId,
				ModuleId = existing.ModuleId,
				LessonId = existing.LessonId,
				GatesProgression = existing.GatesProgression,
				Title = existing.Title,
				Prompt = existing.Prompt,
				Description = existing.Description,
				Options = existing.Options
					.OrderBy(option => option.OrderIndex)
					.Select(option => new CheckpointOptionEditorItem
					{
						Id = option.Id,
						Label = option.Label,
						IsCorrect = option.IsCorrect
					})
					.ToList()
			};
		}
		else
		{
			_editingCheckpoint = new CheckpointDefinitionEditorModel
			{
				CourseId = _editingCourse.Id,
				ModuleId = moduleId,
				GatesProgression = true,
				Title = BuildDefaultCheckpointTitle(moduleId),
				Prompt = string.Empty,
				Description = string.Empty,
				Options = new List<CheckpointOptionEditorItem>
				{
					new() { Label = string.Empty, IsCorrect = true },
					new() { Label = string.Empty, IsCorrect = false },
					new() { Label = string.Empty, IsCorrect = false },
					new() { Label = string.Empty, IsCorrect = false },
					new() { Label = string.Empty, IsCorrect = false }
				}
			};
		}
	}

	private void AddCheckpointOption()
	{
		_editingCheckpoint?.Options.Add(new CheckpointOptionEditorItem { Label = string.Empty, IsCorrect = false });
	}

	private void RemoveCheckpointOption(int index)
	{
		if (_editingCheckpoint is null || index < 0 || index >= _editingCheckpoint.Options.Count)
		{
			return;
		}

		_editingCheckpoint.Options.RemoveAt(index);
	}

	private async Task SaveCheckpointAsync()
	{
		_checkpointError = null;
		_checkpointMessage = null;

		if (_editingCheckpoint is null)
		{
			return;
		}

		if (string.IsNullOrWhiteSpace(_editingCheckpoint.Title) || string.IsNullOrWhiteSpace(_editingCheckpoint.Prompt) || string.IsNullOrWhiteSpace(_editingCheckpoint.Description))
		{
			_checkpointError = "Title, prompt, and description are required.";
			return;
		}

		if (_editingCheckpoint.Options.Count < 2)
		{
			_checkpointError = "Add at least two options.";
			return;
		}

		if (_editingCheckpoint.Options.Any(option => string.IsNullOrWhiteSpace(option.Label)))
		{
			_checkpointError = "Every option needs a description.";
			return;
		}

		if (_editingCheckpoint.Options.All(option => !option.IsCorrect))
		{
			_checkpointError = "Check at least one option as correct.";
			return;
		}

		await CourseService.SaveCheckpointDefinitionAsync(_editingCheckpoint);

		// SPA-style navigate (no forceLoad): forceLoad triggers a full page reload that
		// was crashing the live circuit ("No interop methods are registered for renderer").
		if (_editingCourse is not null)
		{
			// A module checkpoint's home is that module's page (where lessons + the checkpoint are managed together);
			// the final checkpoint isn't tied to a module, so it falls back to the Lessons step instead.
			var moduleId = _editingCheckpoint.ModuleId;
			var targetUri = moduleId.HasValue
				? BuildEditorUri(_editingCourse.Id, CourseEditorStep.Modules, moduleId.Value)
				: BuildEditorUri(_editingCourse.Id, CourseEditorStep.Lessons);
			NavigationManager.NavigateTo(targetUri);
			await ReloadCheckpointsAsync();
			return;
		}

