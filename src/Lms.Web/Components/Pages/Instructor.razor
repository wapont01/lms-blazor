	private async Task RestoreEditingDraftAsync(Course course)
	{
		try
		{
			var savedDraft = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", $"{EditingCourseDraftPrefix}{course.Id}");
			if (string.IsNullOrWhiteSpace(savedDraft))
			{
				_editingCourse = CloneCourse(course);
				return;
			}

			var restoredDraft = JsonSerializer.Deserialize<Course>(savedDraft);

			// If the server record has moved on since this draft was captured (e.g. an admin
			// approved/rejected the course, or it was saved from another tab), the draft is
			// stale — discard it rather than silently overwriting live review-workflow state.
			// UpdatedAt can be null (never modified since creation), so fall back to CreatedAt
			// as a timestamp source rather than letting a null comparison silently pass.
			var draftTimestamp = restoredDraft?.UpdatedAt ?? restoredDraft?.CreatedAt ?? DateTime.MinValue;
			var serverTimestamp = course.UpdatedAt ?? course.CreatedAt;
			if (restoredDraft is null || draftTimestamp < serverTimestamp)
			{
				await JSRuntime.InvokeVoidAsync("localStorage.removeItem", $"{EditingCourseDraftPrefix}{course.Id}");
				_editingCourse = CloneCourse(course);
				return;
			}

			_editingCourse = CloneCourse(restoredDraft);
		}
		catch (InvalidOperationException)
		{
			_editingCourse = CloneCourse(course);
		}
	}

	private async Task SubmitCourseForReviewAsync()
	{
		if (_editingCourse is null || !_actorUserId.HasValue)
		{
