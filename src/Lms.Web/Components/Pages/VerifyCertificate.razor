@page "/verify-certificate"
@using Lms.Application.Services
@inject IEnrollmentService EnrollmentService

<PageTitle>Verify Certificate</PageTitle>

<div class="verification-page">
    <div class="verification-intro">
        <p class="eyebrow">Public record check</p>
        <h1>Certificate Verification</h1>
        <p class="muted-text">Confirm an issued certificate using the details printed on the certificate PDF.</p>
    </div>

    <div class="card verification-card">
        <EditForm Model="_form" OnValidSubmit="VerifyAsync" class="verification-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="auth-error" />

        <div class="form-field">
            <label for="certificate-number">Certificate Number</label>
            <InputText id="certificate-number" @bind-Value="_form.CertificateNumber" placeholder="e.g. WLR-2026-000123" autocomplete="off" />
            <ValidationMessage For="@(() => _form.CertificateNumber)" />
        </div>

        <div class="form-field">
            <label for="verification-code">Verification Code</label>
            <InputText id="verification-code" @bind-Value="_form.VerificationCode" placeholder="Enter the code from the PDF" autocomplete="off" />
            <ValidationMessage For="@(() => _form.VerificationCode)" />
        </div>

        <button type="submit" disabled="@_isVerifying">@(_isVerifying ? "Checking..." : "Verify Certificate")</button>
        </EditForm>
    </div>

    @if (!string.IsNullOrWhiteSpace(_resultMessage))
    {
        <div class="verification-message @(_isValid ? "verification-success" : "verification-failure")" role="@( _isValid ? "status" : "alert")">
            <strong>@(_isValid ? "Certificate verified" : "Verification unsuccessful")</strong>
            <span>@_resultMessage</span>
        </div>
    }

    @if (_result is not null)
    {
        <section class="card verification-result" aria-labelledby="verification-result-heading">
            <div class="verification-result-heading">
                <div>
                    <p class="eyebrow">Verified record</p>
                    <h2 id="verification-result-heading">Certificate Details</h2>
                </div>
                <span class="verification-status">@_result.Status</span>
            </div>
            <table class="simple-table">
                <tbody>
                    <tr><th>Certificate Number</th><td>@_result.CertificateNumber</td></tr>
                    <tr><th>Verification Code</th><td><code>@_result.VerificationCode</code></td></tr>
                    <tr><th>Learner</th><td>@_result.LearnerName</td></tr>
                    <tr><th>Course</th><td>@_result.CourseTitle</td></tr>
                    <tr><th>Issued (UTC)</th><td>@_result.IssuedAt.ToString("u")</td></tr>
                    <tr><th>Expires (UTC)</th><td>@_result.ExpiresAt.ToString("u")</td></tr>
                    <tr><th>Revoked</th><td>@(_result.IsRevoked ? "Yes" : "No")</td></tr>
                    @if (!string.IsNullOrWhiteSpace(_result.RevocationReason))
                    {
                        <tr><th>Revocation Reason</th><td>@_result.RevocationReason</td></tr>
                    }
                </tbody>
            </table>
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery] private string? CertificateNumber { get; set; }
    [SupplyParameterFromQuery] private string? VerificationCode { get; set; }

    private VerifyForm _form = new();
    private CertificateDownloadPayload? _result;
    private string? _resultMessage;
    private bool _isValid;
    private bool _isVerifying;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(CertificateNumber) && !string.IsNullOrWhiteSpace(VerificationCode))
        {
            _form.CertificateNumber = CertificateNumber;
            _form.VerificationCode = VerificationCode;
            await VerifyAsync();
        }
    }

    private async Task VerifyAsync()
    {
        _result = null;
        _isValid = false;
        _resultMessage = null;
        _isVerifying = true;

        try
        {
            var payload = await EnrollmentService.VerifyCertificateAsync(_form.CertificateNumber, _form.VerificationCode);

            if (payload is null)
            {
                _resultMessage = "Certificate could not be verified. Check the number and verification code.";
                return;
            }

            _result = payload;
            _isValid = true;
            _resultMessage = "The certificate details match our records.";
        }
        finally
        {
            _isVerifying = false;
        }
    }

    private sealed class VerifyForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string CertificateNumber { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string VerificationCode { get; set; } = string.Empty;
    }
}
