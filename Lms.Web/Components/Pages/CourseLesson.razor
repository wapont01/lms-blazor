@page "/courses/{courseId:guid}/lessons/{lessonId:guid}"
@using System.Text.RegularExpressions
@using System.Security.Claims
@using Microsoft.JSInterop
@using Lms.Application.Services
@using Lms.Domain.Entities
@implements IDisposable
@inject ICourseService CourseService
@inject IEnrollmentService EnrollmentService
@inject IUnitExamService UnitExamService
@inject IExamService ExamService
@inject ILearnerDashboardService LearnerDashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Lesson</PageTitle>

@if (_course is null || _currentLesson is null)
{
	<p>Lesson not found.</p>
}
else if (!_isEnrolled)
{
	<div class="lesson-layout">
		<section class="lesson-main-column">
			<section class="card lesson-content-card">
				<section class="flow-feedback-banner" aria-live="polite">
					<p class="muted-text">You must enroll in this course before taking lessons.</p>
				</section>
				<div class="unit-exam-actions">
					<button type="button" class="unit-exam-submit-button" @onclick="GoToCourseOverview">Go to Course Overview</button>
				</div>
			</section>
		</section>
	</div>
}
else
{
	<div class="lesson-layout">
		@if (!(_activeUnitExam is not null && _showUnitExamResult))
		{
		<aside class="card lesson-menu-column" aria-label="Course menu">
			@if (ShowMenuProgress)
			{
				<div class="menu-progress" aria-label="Course progress">
					<div class="menu-progress-header">
						<span>Course progress</span>
						<strong>@_menuProgressPercent.ToString("0")%</strong>
					</div>
					<div class="menu-progress-track" aria-hidden="true">
						<div class="menu-progress-fill" style=@($"width: {_menuProgressPercent:0.##}%;")></div>
					</div>
				</div>
			}

			<h2>Course Menu</h2>
			@if (!MenuLinksEnabled)
			{
				<p class="menu-lock-note">Menu unlocks after you begin the timed course.</p>
			}
			<div class="lesson-menu-list">
				@foreach (var unit in _orderedUnits)
				{
					if (IsGettingStartedUnit(unit))
					{
						continue;
					}

					var unitLessons = unit.Lessons.OrderBy(lesson => lesson.OrderIndex).ToList();
					var forceExpandedMenu = _currentLesson is not null && IsGettingStartedLesson(_currentLesson.Id);
					var isCurrentUnit = unitLessons.Any(lesson => lesson.Id == _currentLesson!.Id);
					var isExpanded = forceExpandedMenu ? true : IsUnitExpanded(unit.Id, isCurrentUnit);

					<section class="lesson-menu-unit @(isCurrentUnit ? "is-active-unit" : string.Empty)">
						<button type="button" class="menu-unit-toggle" @onclick="(() => ToggleUnitExpanded(unit.Id))" aria-expanded="@isExpanded" disabled="@forceExpandedMenu">
							<span class="unit-toggle-label">@unit.Title</span>
							<span class="unit-toggle-icon @(isExpanded ? "is-expanded" : string.Empty)" aria-hidden="true">▸</span>
						</button>
						@if (isExpanded && unitLessons.Count == 0)
						{
							<p class="muted-text">No lessons yet.</p>
						}
						else if (isExpanded)
						{
							<ul>
								@foreach (var lesson in unitLessons)
								{
									var isCurrentLesson = lesson.Id == _currentLesson!.Id;
									var lessonIsUnlocked = !MenuLinksEnabled || IsLessonUnlockedForMenu(lesson.Id);
									<li>
										@if (MenuLinksEnabled && lessonIsUnlocked)
										{
											<a class="@(isCurrentLesson ? "active-lesson-link" : string.Empty)" href="@BuildLessonUri(lesson.Id)">@lesson.Title</a>
										}
										else
										{
											<span class="menu-link-disabled">@lesson.Title</span>
										}
									</li>
								}
							</ul>
						}
					</section>
				}
			</div>
		</aside>
		}

		<section class="lesson-main-column">
			<h1 class="lesson-page-title">@_course.Title</h1>

			<section class="course-summary-strip" aria-label="Lesson summary">
				<div class="summary-chip">
					<span class="summary-label">Unit</span>
					<strong>@_currentUnitTitle</strong>
				</div>
				<div class="summary-chip">
					<span class="summary-label">Current lesson</span>
					<strong>@(_activeUnitExam?.Title ?? _currentLesson!.Title)</strong>
				</div>
			</section>

			@if (ShowTimedSessionStatus)
			{
				<section class="timed-session-strip" aria-label="Timed session status">
					<strong>Time Elapsed: @GetElapsedTimerText()</strong>
				</section>
			}

			<section class="card lesson-content-card">
				@if (!string.IsNullOrWhiteSpace(_unitExamMessage) && _activeUnitExam is null && !_showFinalExamResults)
				{
					<section class="flow-feedback-banner" aria-live="polite">
						<p class="muted-text">@_unitExamMessage</p>
					</section>
				}

				@if (ShowTimerStartGate)
				{
					<section class="timed-start-gate" aria-label="Timed course start">
						<p>Your course timer starts when you select Begin Timed Course.</p>
						<div class="timed-start-actions">
							<button type="button" class="timer-start-button" @onclick="BeginTimedCourseAsync">Begin Timed Course</button>
							<button type="button" class="secondary-button" @onclick="GoPreviousInCourseAsync">Back</button>
						</div>
					</section>
				}

				@if (ShowFinalExamAnnouncement)
				{
					<section class="final-exam-gate" aria-label="Final exam announcement">
						<h2>Final Exam</h2>
						<p>You have reached the final exam. It contains 10 questions and is scored automatically.</p>
						<div class="timed-start-actions">
							<button type="button" class="timer-start-button" @onclick="BeginFinalExamAsync">Begin Final Exam</button>
							<button type="button" class="secondary-button" @onclick="GoPreviousInCourseAsync">Back</button>
						</div>
					</section>
				}

				@if (ShowFinalExamQuiz)
				{
					<section class="final-exam-quiz" aria-label="Final exam quiz">
						<h2>@_finalExam!.Title</h2>
						<p>Answer all 10 questions. The answers are checked automatically when you submit.</p>

						@foreach (var question in _finalExam.Questions)
						{
							<div class="final-exam-question">
								<p class="final-exam-prompt">@question.Prompt</p>
								<div class="final-exam-options">
									<label class="unit-exam-option-label">
										<input type="radio" class="unit-exam-option-input" name=@($"final-{question.Id}") checked="@IsFinalExamOptionSelected(question.Id, "A")" @onchange="@(args => SelectFinalExamOption(question.Id, "A", args.Value))" />
										<span>A. @question.OptionA</span>
									</label>
									<label class="unit-exam-option-label">
										<input type="radio" class="unit-exam-option-input" name=@($"final-{question.Id}") checked="@IsFinalExamOptionSelected(question.Id, "B")" @onchange="@(args => SelectFinalExamOption(question.Id, "B", args.Value))" />
										<span>B. @question.OptionB</span>
									</label>
									<label class="unit-exam-option-label">
										<input type="radio" class="unit-exam-option-input" name=@($"final-{question.Id}") checked="@IsFinalExamOptionSelected(question.Id, "C")" @onchange="@(args => SelectFinalExamOption(question.Id, "C", args.Value))" />
										<span>C. @question.OptionC</span>
									</label>
									<label class="unit-exam-option-label">
										<input type="radio" class="unit-exam-option-input" name=@($"final-{question.Id}") checked="@IsFinalExamOptionSelected(question.Id, "D")" @onchange="@(args => SelectFinalExamOption(question.Id, "D", args.Value))" />
										<span>D. @question.OptionD</span>
									</label>
								</div>
							</div>
						}

						<div class="unit-exam-actions">
							<button type="button" class="secondary-button" @onclick="FillWrongFinalExamAnswersAsync">Fill Wrong Answers (Fail Scenario)</button>
							<button type="button" class="secondary-button" @onclick="FillCorrectFinalExamAnswersAsync">Fill Correct Answers</button>
							<button type="button" class="unit-exam-submit-button" @onclick="SubmitFinalExamAsync">Submit Final Exam</button>
						</div>

					</section>
				}

				@if (_showFinalExamResults && _finalExam is not null)
				{
					<section class="final-exam-result" aria-label="Final exam result">
						<h2>Final Exam Result</h2>
						<p class="@(_finalExamPassed ? null : "exam-failure-text")">@(_finalExamPassed ? "Success" : "Result: Failure")</p>
						<p>Elapsed time: @_finalExamElapsedText</p>
						<p>Score: @_finalExamCorrectAnswers of @_finalExamTotalQuestions (@_finalExamScorePercent.ToString("0")%)</p>
						@if (_finalExamAnswerReview.Count > 0)
						{
							<section class="final-exam-review" aria-label="Final exam answer review">
								<h3>Answer Review</h3>
								@foreach (var review in _finalExamAnswerReview)
								{
									<div class="course-item">
										<p class="final-exam-prompt">@review.Prompt</p>
										<p class="muted-text">Your answer: @review.SelectedOptionLabel</p>
										<p class="muted-text">Correct answer: @review.CorrectOptionLabel</p>
										<p class="@(review.IsCorrect ? null : "exam-failure-text")">@(review.IsCorrect ? "Correct" : "Incorrect")</p>
									</div>
								}
							</section>
						}
						<div class="unit-exam-actions">
							<button type="button" class="unit-exam-submit-button" @onclick="GoToCourseOverview">Back to Course Overview</button>
							@if (_finalExamPassed)
							{
								<button type="button" class="secondary-button" @onclick="GoToLearnerCertificates">View Certificate</button>
							}
						</div>
					</section>
				}

				@if (_activeUnitExam is null && _currentLessonPages.Count > 0 && !ShowTimerStartGate && !ShowFinalExamAnnouncement && !ShowFinalExamQuiz && !_showFinalExamResults)
				{
					<p class="lesson-text-content">@_currentLessonPages[_currentLessonPageIndex]</p>

					@if (_currentLessonPages.Count > 1)
					{
						<p class="muted-text lesson-page-meta">Page @(_currentLessonPageIndex + 1) of @_currentLessonPages.Count</p>
					}
				}

				@if (_activeUnitExam is not null)
				{
					<section class="unit-exam" aria-label="Unit exam quiz">
						<h2>@_activeUnitExam.Title</h2>
						@if (!_showUnitExamResult)
						{
							<p>@_activeUnitExam.Prompt</p>
							<p class="muted-text">@_activeUnitExam.Description</p>

							@foreach (var option in _activeUnitExam.Options)
							{
								<div class="unit-exam-option-row">
									<label class="unit-exam-option-label">
										<input type="checkbox"
											class="unit-exam-option-input"
											checked="@_selectedUnitExamOptionKeys.Contains(option.Key)"
											@onchange="@(eventArgs => ToggleUnitExamOption(option.Key, eventArgs.Value))" />
										@option.Label
									</label>
								</div>
							}

							<div class="unit-exam-actions">
								<button type="button" class="secondary-button" @onclick="AutoFillWrongUnitExamAnswers">Fill Wrong Answers (Fail Scenario)</button>
								<button type="button" class="secondary-button" @onclick="AutoFillUnitExamAnswers">Fill Correct Answers</button>
								<button type="button" class="unit-exam-submit-button" @onclick="SubmitUnitExamAsync">Submit</button>
							</div>

							@if (!string.IsNullOrWhiteSpace(_unitExamMessage))
							{
								<p class="muted-text">@_unitExamMessage</p>
							}
						}
						else
						{
							<h3>Unit Exam Result</h3>
							<p class="@(_unitExamPassed ? null : "exam-failure-text")">@(_unitExamPassed ? "Success" : "Result: Failure")</p>
							<p class="muted-text">Score: @_unitExamMatchedCorrectCount of @_unitExamTotalCorrectCount correct selections</p>

							@if (!string.IsNullOrWhiteSpace(_unitExamResultMessage))
							{
								<p class="muted-text">@_unitExamResultMessage</p>
							}

							@if (!_unitExamPassed)
							{
								<section class="unit-exam-answer-review" aria-label="Unit Exam answer review">
									<h3>Unit Exam Answer Review</h3>
									<p class="muted-text">Correct answers: @string.Join(", ", GetUnitExamCorrectOptionLabels())</p>
									@if (GetUnitExamWrongSelectedOptionLabels().Count > 0)
									{
										<p class="exam-failure-text">Incorrect selections: @string.Join(", ", GetUnitExamWrongSelectedOptionLabels())</p>
									}
									@if (GetUnitExamMissedCorrectOptionLabels().Count > 0)
									{
										<p class="exam-failure-text">Missed correct answers: @string.Join(", ", GetUnitExamMissedCorrectOptionLabels())</p>
									}
								</section>
							}

							<div class="unit-exam-actions">
								@if (_unitExamPassed)
								{
									<p class="muted-text">Use the Next arrow to continue.</p>
								}
								else
								{
									<button type="button" class="secondary-button" @onclick="RetakeUnitExam">Re-take Unit Exam</button>
									<p class="muted-text">Use the Next arrow to continue regardless.</p>
								}
							</div>
						}
					</section>
				}

				@if (_activeUnitExam is null && _isEnrolled && !_showFinalExamResults)
				{
					@if (IsLessonCompleted(_currentLesson!.Id))
					{
						<p class="muted-text status-completed">This lesson is completed.</p>
					}
					else if (ShowUntimedOrientationNotice)
					{
						<p class="muted-text">Untimed section. Continue to the timed section to start your course timer.</p>
					}
				}
				else if (_activeUnitExam is null)
				{
					<p class="muted-text">Sign in and enroll to track completion as you move through the lessons.</p>
				}

				@if (!_showFinalExamResults)
				{
				<div class="unit-pager unit-pager-bottom">
					<div class="pager-controls">
						<button type="button" class="pager-arrow" @onclick="GoPreviousInCourseAsync" disabled="@(_currentLessonIndexInCourse < 0)" aria-label="Previous page or lesson">←</button>
						<button type="button" class="pager-arrow" @onclick="GoNextInCourseAsync" disabled="@IsNextNavigationDisabled" aria-label="Next page or lesson">→</button>
					</div>
				</div>
				}
			</section>
		</section>
	</div>
}

@code {
	[Parameter] public Guid CourseId { get; set; }
	[Parameter] public Guid LessonId { get; set; }
	[SupplyParameterFromQuery(Name = "learnerId")] public Guid? LearnerId { get; set; }

	private Course? _course;
	private Guid? _viewerUserId;
	private Guid? _userId;
	private Guid? _learnerContextUserId;
	private bool _isAuthenticated;
	private bool _isAdminViewer;
	private bool _isEnrolled;
	private decimal _enrollmentProgressPercent;
	private Dictionary<Guid, bool> _lessonCompletion = new();
	private List<Unit> _orderedUnits = new();
	private List<Lesson> _orderedLessons = new();
	private List<Lesson> _currentUnitLessons = new();
	private List<Lesson> _progressTrackedLessons = new();
	private readonly HashSet<Guid> _expandedUnitIds = new();
	private Lesson? _currentLesson;
	private int _currentLessonIndexInCourse;
	private int _currentLessonIndexInUnit;
	private int _currentUnitIndex;
	private string _currentUnitTitle = string.Empty;
	private decimal _menuProgressPercent;
	private List<string> _currentLessonPages = new();
	private int _currentLessonPageIndex;
	private List<UnitExamDefinition> _unitExamDefinitions = new();
	private HashSet<string> _passedUnitExamKeys = new(StringComparer.OrdinalIgnoreCase);
	private UnitExamDefinition? _activeUnitExam;
	private readonly HashSet<string> _selectedUnitExamOptionKeys = new(StringComparer.OrdinalIgnoreCase);
	private bool _showUnitExamResult;
	private bool _unitExamPassed;
	private string? _unitExamResultMessage;
	private int _unitExamMatchedCorrectCount;
	private int _unitExamTotalCorrectCount;
	private Guid? _pendingUnitExamNextLessonId;
	private bool _unitExamCompletesCourse;
	private string? _unitExamMessage;
	private CourseExamView? _finalExam;
	private readonly Dictionary<Guid, string> _finalExamSelectedOptions = new();
	private ExamEligibility? _finalExamEligibility;
	private bool _passedFinalExamOnFirstAttempt;
	private bool _hasFinalExamRetakeGrantOverride;
	private bool _isFinalExamRetakeLimitReached;
	private bool _showFinalExamResults;
	private string? _finalExamElapsedText;
	private int _finalExamCorrectAnswers;
	private int _finalExamTotalQuestions;
	private decimal _finalExamScorePercent;
	private bool _finalExamPassed;
	private readonly List<FinalExamAnswerReviewItem> _finalExamAnswerReview = new();
	private DateTime? _timedSessionStartedAtUtc;
	private bool _isTimerStateLoaded;
	private Timer? _timerRefresh;
	private bool _showFinalExamAnnouncement;
	private bool _isFinalExamOpen;
	private int _highestUnlockedTrackedLessonIndex;
	private bool _isInitialized;
	private bool IsNextNavigationDisabled =>
		(_activeUnitExam is not null && !_showUnitExamResult) ||
		ShowTimerStartGate ||
		ShowFinalExamAnnouncement ||
		ShowFinalExamQuiz ||
		_orderedLessons.Count == 0 ||
		(_currentLessonIndexInCourse >= _orderedLessons.Count - 1 &&
		 _currentLessonPageIndex >= _currentLessonPages.Count - 1 &&
		 !CanTriggerFinalExam());
	private bool MenuLinksEnabled => IsTimedSessionRunning;
	private bool ShowMenuProgress => _currentLesson is not null && !IsGettingStartedLesson(_currentLesson.Id);
	private bool IsTimedSessionRunning => _timedSessionStartedAtUtc.HasValue;
	private bool ShowTimedSessionStatus => IsTimedSessionRunning;
	private bool ShowUntimedOrientationNotice => _currentLesson is not null && IsOrientationLesson(_currentLesson) && !IsTimedSessionRunning;
	private bool ShowTimerStartGate => _currentLesson is not null
		&& !IsGettingStartedLesson(_currentLesson.Id)
		&& !IsTimedSessionRunning
		&& _activeUnitExam is null
		&& !ShowFinalExamAnnouncement
		&& !ShowFinalExamQuiz
		&& !_showFinalExamResults;
	private bool ShowFinalExamAnnouncement => _showFinalExamAnnouncement && _finalExam is not null;
	private bool ShowFinalExamQuiz => _isFinalExamOpen && _finalExam is not null && !_showFinalExamResults;

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		_isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
		_isAdminViewer = authState.User.IsInRole("Admin");

		var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
		if (Guid.TryParse(userIdClaim, out var parsedUserId))
		{
			_viewerUserId = parsedUserId;
		}

		_isInitialized = true;

		_course = await CourseService.GetByIdAsync(CourseId);
		if (_course is null)
		{
			return;
		}

		BuildOrderedLessons();
		_unitExamDefinitions = await UnitExamService.GetUnitExamDefinitionsAsync(CourseId);
		ResolveCurrentLesson();

		if (_viewerUserId.HasValue)
		{
			var learnerSelection = await LearnerDashboardService.ResolveLearnerContextAsync(_viewerUserId.Value, _isAdminViewer, LearnerId);
			_learnerContextUserId = learnerSelection.Context.LearnerUserId;
			_userId = learnerSelection.Context.LearnerUserId;

			if (_isAdminViewer && LearnerId != _learnerContextUserId)
			{
				NavigationManager.NavigateTo(BuildLessonUri(LessonId), replace: true);
				return;
			}

			if (_userId.HasValue)
			{
				_isEnrolled = await EnrollmentService.IsEnrolledAsync(_userId.Value, _course.Id);
				if (_isEnrolled)
				{
					await RefreshLessonStateAsync();
					_passedUnitExamKeys = await UnitExamService.GetPassedUnitExamKeysAsync(_userId.Value, _course.Id);
					await RefreshFinalExamStateAsync();
					if (EnforceExamTerminalOverviewLock())
					{
						return;
					}
					await EnforceProgressiveLessonAccessAsync();
					await EvaluateFlowGatesOnLessonLoadAsync();
				}
			}
			else
			{
				_isEnrolled = false;
			}
		}
	}

	protected override async Task OnParametersSetAsync()
	{
		if (!_isInitialized || _course is null)
		{
			return;
		}

		if (_viewerUserId.HasValue)
		{
			var learnerSelection = await LearnerDashboardService.ResolveLearnerContextAsync(_viewerUserId.Value, _isAdminViewer, LearnerId);
			_learnerContextUserId = learnerSelection.Context.LearnerUserId;
			_userId = learnerSelection.Context.LearnerUserId;

			if (_isAdminViewer && LearnerId != _learnerContextUserId)
			{
				NavigationManager.NavigateTo(BuildLessonUri(LessonId), replace: true);
				return;
			}
		}

		ResolveCurrentLesson();

		if (_userId.HasValue)
		{
			_isEnrolled = await EnrollmentService.IsEnrolledAsync(_userId.Value, _course.Id);
		}
		else
		{
			_isEnrolled = false;
		}

		if (_isEnrolled && _userId.HasValue)
		{
			await RefreshLessonStateAsync();
			_passedUnitExamKeys = await UnitExamService.GetPassedUnitExamKeysAsync(_userId.Value, _course.Id);
			await RefreshFinalExamStateAsync();
			if (EnforceExamTerminalOverviewLock())
			{
				return;
			}
			await EnforceProgressiveLessonAccessAsync();
			await EvaluateFlowGatesOnLessonLoadAsync();
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!_isTimerStateLoaded)
		{
			await LoadTimedSessionStateAsync();
			if (_isEnrolled)
			{
				await EnforceProgressiveLessonAccessAsync();
			}
			StateHasChanged();
		}
	}

	private void BuildOrderedLessons()
	{
		if (_course is null)
		{
			return;
		}

		_orderedUnits = _course.Units.OrderBy(unit => unit.OrderIndex).ToList();
		_orderedLessons = _course.Units
			.OrderBy(unit => unit.OrderIndex)
			.SelectMany(unit => unit.Lessons.OrderBy(lesson => lesson.OrderIndex))
			.ToList();
		_progressTrackedLessons = _orderedUnits
			.Where(unit => !IsGettingStartedUnit(unit))
			.SelectMany(unit => unit.Lessons.OrderBy(lesson => lesson.OrderIndex))
			.ToList();
	}

	private void ResolveCurrentLesson()
	{
		if (_course is null)
		{
			return;
		}

		var lessonIndex = _orderedLessons.FindIndex(lesson => lesson.Id == LessonId);
		if (lessonIndex < 0)
		{
			_currentLesson = null;
			_currentLessonIndexInCourse = -1;
			_menuProgressPercent = 0;
			_currentUnitLessons = new List<Lesson>();
			_currentUnitTitle = string.Empty;
			_currentLessonPages = new List<string>();
			_currentLessonPageIndex = 0;
			return;
		}

		_currentLesson = _orderedLessons[lessonIndex];
		_currentLessonIndexInCourse = lessonIndex;
		_menuProgressPercent = CalculateLearnerFlowProgressPercent();
		_currentUnitIndex = _orderedUnits.FindIndex(unit => unit.Lessons.Any(lesson => lesson.Id == _currentLesson.Id));
		if (_currentUnitIndex < 0)
		{
			_currentUnitIndex = 0;
		}

		var currentUnit = _orderedUnits.ElementAtOrDefault(_currentUnitIndex);
		_currentUnitLessons = currentUnit?.Lessons.OrderBy(lesson => lesson.OrderIndex).ToList() ?? new List<Lesson>();
		_currentLessonIndexInUnit = _currentUnitLessons.FindIndex(lesson => lesson.Id == _currentLesson.Id);
		if (_currentLessonIndexInUnit < 0)
		{
			_currentLessonIndexInUnit = 0;
		}

		_currentUnitTitle = currentUnit?.Title ?? string.Empty;
		if (currentUnit is not null && !IsGettingStartedUnit(currentUnit))
		{
			_expandedUnitIds.Add(currentUnit.Id);
		}

		_currentLessonPages = SplitLessonIntoPages(_currentLesson.TextContent);
		_currentLessonPageIndex = 0;
	}

	private bool IsUnitExpanded(Guid unitId, bool isCurrentUnit)
	{
		return isCurrentUnit || _expandedUnitIds.Contains(unitId);
	}

	private void ToggleUnitExpanded(Guid unitId)
	{
		if (_currentLesson is not null && IsGettingStartedLesson(_currentLesson.Id))
		{
			return;
		}

		if (_expandedUnitIds.Contains(unitId))
		{
			_expandedUnitIds.Remove(unitId);
			return;
		}

		_expandedUnitIds.Add(unitId);
	}

	private static List<string> SplitLessonIntoPages(string? textContent)
	{
		if (string.IsNullOrWhiteSpace(textContent))
		{
			return new List<string>();
		}

		var normalized = textContent.Replace("\r\n", "\n");
		var split = Regex.Split(
			normalized,
			@"^\s*(?:---\s*page\s*---|\[\[\s*page-break\s*\]\])\s*$",
			RegexOptions.IgnoreCase | RegexOptions.Multiline);

		var pages = split
			.Select(page => page.Trim())
			.Where(page => !string.IsNullOrWhiteSpace(page))
			.ToList();

		return pages.Count == 0 ? new List<string> { normalized.Trim() } : pages;
	}

	private bool IsGettingStartedUnit(Unit unit)
	{
		if (string.Equals(unit.Title, "Getting Started", StringComparison.OrdinalIgnoreCase))
		{
			return true;
		}

		// Fallback for courses that use a different intro-unit label.
		var firstUnit = _orderedUnits
			.OrderBy(existing => existing.OrderIndex)
			.FirstOrDefault();

		if (firstUnit is null || firstUnit.Id != unit.Id)
		{
			return false;
		}

		var firstLesson = firstUnit.Lessons
			.OrderBy(lesson => lesson.OrderIndex)
			.FirstOrDefault();

		return firstLesson is null || IsOrientationLesson(firstLesson);
	}

	private static bool IsOrientationLesson(Lesson lesson)
	{
		if (string.IsNullOrWhiteSpace(lesson.Title))
		{
			return false;
		}

		return lesson.Title.Contains("welcome", StringComparison.OrdinalIgnoreCase) ||
			lesson.Title.Contains("instructor", StringComparison.OrdinalIgnoreCase);
	}

	private bool IsGettingStartedLesson(Guid lessonId)
	{
		return _orderedUnits
			.Where(IsGettingStartedUnit)
			.SelectMany(unit => unit.Lessons)
			.Any(lesson => lesson.Id == lessonId);
	}

	private decimal CalculateLearnerFlowProgressPercent()
	{
		if (_currentLesson is null || IsGettingStartedLesson(_currentLesson.Id) || _progressTrackedLessons.Count == 0)
		{
			return 0;
		}

		var totalTrackedPages = _progressTrackedLessons
			.Sum(lesson => Math.Max(1, SplitLessonIntoPages(lesson.TextContent).Count));

		if (totalTrackedPages <= 1)
		{
			return 0;
		}

		var pagesBeforeCurrent = 0;
		foreach (var lesson in _progressTrackedLessons)
		{
			if (lesson.Id == _currentLesson.Id)
			{
				break;
			}

			pagesBeforeCurrent += Math.Max(1, SplitLessonIntoPages(lesson.TextContent).Count);
		}

		var completedSteps = pagesBeforeCurrent + _currentLessonPageIndex;
		if (completedSteps < 0)
		{
			completedSteps = 0;
		}

		if (completedSteps > totalTrackedPages - 1)
		{
			completedSteps = totalTrackedPages - 1;
		}

		return (completedSteps * 100m) / (totalTrackedPages - 1);
	}

	private bool IsLessonCompleted(Guid lessonId)
	{
		return _lessonCompletion.TryGetValue(lessonId, out var completed) && completed;
	}

	private bool IsLessonUnlockedForMenu(Guid lessonId)
	{
		if (!IsTimedSessionRunning)
		{
			return false;
		}

		if (IsGettingStartedLesson(lessonId))
		{
			return true;
		}

		var trackedIndex = _progressTrackedLessons.FindIndex(lesson => lesson.Id == lessonId);
		if (trackedIndex < 0)
		{
			return false;
		}

		return trackedIndex <= GetHighestUnlockedTrackedLessonIndex();
	}

	private int GetHighestUnlockedTrackedLessonIndex()
	{
		if (_progressTrackedLessons.Count == 0)
		{
			return -1;
		}

		var contiguousCompletedCount = 0;
		foreach (var trackedLesson in _progressTrackedLessons)
		{
			if (!IsLessonCompleted(trackedLesson.Id))
			{
				break;
			}

			contiguousCompletedCount++;
		}

		var completionUnlockIndex = Math.Min(contiguousCompletedCount, _progressTrackedLessons.Count - 1);
		var unlockedIndex = Math.Max(_highestUnlockedTrackedLessonIndex, completionUnlockIndex);
		if (unlockedIndex < 0)
		{
			return 0;
		}

		if (unlockedIndex >= _progressTrackedLessons.Count)
		{
			return _progressTrackedLessons.Count - 1;
		}

		return unlockedIndex;
	}

	private async Task EnforceProgressiveLessonAccessAsync()
	{
		if (!IsTimedSessionRunning || _currentLesson is null || _progressTrackedLessons.Count == 0)
		{
			return;
		}

		if (IsGettingStartedLesson(_currentLesson.Id))
		{
			return;
		}

		var currentTrackedIndex = _progressTrackedLessons.FindIndex(lesson => lesson.Id == _currentLesson.Id);
		if (currentTrackedIndex < 0)
		{
			return;
		}

		var highestUnlockedIndex = GetHighestUnlockedTrackedLessonIndex();
		if (currentTrackedIndex <= highestUnlockedIndex)
		{
			return;
		}

		var redirectLesson = _progressTrackedLessons[highestUnlockedIndex];
		_unitExamMessage = "Complete your current lesson or use Next to unlock the next lesson.";
		NavigationManager.NavigateTo(BuildLessonUri(redirectLesson.Id));
		await Task.CompletedTask;
	}

	private async Task PromoteUnlockByNextAsync(Lesson nextLesson)
	{
		if (!IsTimedSessionRunning)
		{
			return;
		}

		var trackedIndex = _progressTrackedLessons.FindIndex(lesson => lesson.Id == nextLesson.Id);
		if (trackedIndex < 0)
		{
			return;
		}

		if (trackedIndex <= _highestUnlockedTrackedLessonIndex)
		{
			return;
		}

		_highestUnlockedTrackedLessonIndex = trackedIndex;

		try
		{
			await JSRuntime.InvokeVoidAsync("localStorage.setItem", BuildProgressUnlockStorageKey(), _highestUnlockedTrackedLessonIndex.ToString());
		}
		catch (JSException)
		{
			// Keep unlock state in-memory if local storage is temporarily unavailable.
		}
	}

	private async Task GoPreviousInCourseAsync()
	{
		if (_activeUnitExam is not null)
		{
			return;
		}

		if (_orderedLessons.Count == 0 || _currentLessonIndexInCourse < 0)
		{
			return;
		}

		if (_currentLessonPages.Count > 1 && _currentLessonPageIndex > 0)
		{
			_currentLessonPageIndex--;
			_menuProgressPercent = CalculateLearnerFlowProgressPercent();
			await Task.CompletedTask;
			return;
		}

		if (_currentLessonIndexInCourse == 0)
		{
			NavigationManager.NavigateTo(BuildCourseOverviewUri());
			await Task.CompletedTask;
			return;
		}

		var previousLesson = _orderedLessons[_currentLessonIndexInCourse - 1];
		NavigationManager.NavigateTo(BuildLessonUri(previousLesson.Id));
		await Task.CompletedTask;
	}

	private async Task GoNextInCourseAsync()
	{
		if (_activeUnitExam is not null)
		{
			if (_showUnitExamResult)
			{
				await ContinueAfterUnitExamAsync(continueRegardless: !_unitExamPassed);
			}

			return;
		}

		if (_showFinalExamAnnouncement || _isFinalExamOpen)
		{
			return;
		}

		if (_course is null || _orderedLessons.Count == 0)
		{
			return;
		}

		if (_currentLessonPages.Count > 1 && _currentLessonPageIndex < _currentLessonPages.Count - 1)
		{
			_currentLessonPageIndex++;
			_menuProgressPercent = CalculateLearnerFlowProgressPercent();

			if (IsTimedSessionRunning && IsAtFinalLessonBoundary())
			{
				if (TryBeginEndOfUnitExam(null))
				{
					return;
				}

				if (await TryBeginFinalExamAsync())
				{
					return;
				}
			}

			await Task.CompletedTask;
			return;
		}

		if (_currentLessonIndexInCourse >= _orderedLessons.Count - 1)
		{
			if (TryBeginEndOfUnitExam(null))
			{
				return;
			}

			if (await TryBeginFinalExamAsync())
			{
				return;
			}

			NavigationManager.NavigateTo(BuildCourseOverviewUri());

			return;
		}

		var nextLesson = _orderedLessons[_currentLessonIndexInCourse + 1];
		if (TryBeginEndOfUnitExam(nextLesson.Id))
		{
			return;
		}

		await PromoteUnlockByNextAsync(nextLesson);

		NavigationManager.NavigateTo(BuildLessonUri(nextLesson.Id));
		await Task.CompletedTask;
	}

	private bool TryBeginEndOfUnitExam(Guid? nextLessonId)
	{
		if (_currentLesson is null)
		{
			return false;
		}

		var currentUnit = _orderedUnits.FirstOrDefault(unit => unit.Lessons.Any(lesson => lesson.Id == _currentLesson.Id));

		if (currentUnit is null || IsGettingStartedUnit(currentUnit))
		{
			return false;
		}

		var orderedUnitLessons = currentUnit.Lessons.OrderBy(lesson => lesson.OrderIndex).ToList();
		if (orderedUnitLessons.Count == 0)
		{
			return false;
		}

		var lastLessonInUnit = orderedUnitLessons[^1];
		var atLastLessonOfUnit = lastLessonInUnit.Id == _currentLesson.Id;
		var atLastPageOfLesson = _currentLessonPages.Count == 0 || _currentLessonPageIndex >= _currentLessonPages.Count - 1;

		if (!atLastLessonOfUnit || !atLastPageOfLesson)
		{
			return false;
		}

		var unitExamKey = UnitExamService.BuildUnitExamKey(currentUnit.Id);
		if (_passedUnitExamKeys.Contains(unitExamKey))
		{
			return false;
		}

		var unitExam = _unitExamDefinitions.FirstOrDefault(item => string.Equals(item.Key, unitExamKey, StringComparison.OrdinalIgnoreCase));
		if (unitExam is null)
		{
			return false;
		}

		_activeUnitExam = unitExam;
		_pendingUnitExamNextLessonId = nextLessonId;
		_unitExamCompletesCourse = nextLessonId is null && IsAtFinalLessonBoundary();
		_unitExamMessage = null;
		_showUnitExamResult = false;
		_unitExamPassed = false;
		_unitExamResultMessage = null;
		_unitExamMatchedCorrectCount = 0;
		_unitExamTotalCorrectCount = 0;
		AutoFillUnitExamAnswers();
		return true;
	}

	private async Task<bool> TryBeginFinalExamAsync(bool skipUnitExamGate = false)
	{
		if (!skipUnitExamGate && TryBeginEndOfUnitExam(null))
		{
			return true;
		}

		await RefreshFinalExamStateAsync();

		if (_finalExamEligibility?.HasPassed == true)
		{
			return false;
		}

		if (_finalExam is null)
		{
			return false;
		}

		_showFinalExamAnnouncement = true;
		_isFinalExamOpen = false;
		_finalExamSelectedOptions.Clear();
		return true;
	}

	private async Task EvaluateFlowGatesOnLessonLoadAsync()
	{
		if (!_isEnrolled || _currentLesson is null || _showFinalExamResults)
		{
			return;
		}

		if (EnforceExamTerminalOverviewLock())
		{
			return;
		}

		if (!IsAtFinalLessonBoundary())
		{
			_showFinalExamAnnouncement = false;
			_isFinalExamOpen = false;
		}

		if (_activeUnitExam is null)
		{
			var pendingUnitExam = FindPendingUnitExamForCurrentPosition();
			if (pendingUnitExam is not null)
			{
				_activeUnitExam = pendingUnitExam;
				_unitExamMessage = null;
				_showUnitExamResult = false;
				_unitExamPassed = false;
				_unitExamResultMessage = null;
				_unitExamMatchedCorrectCount = 0;
				_unitExamTotalCorrectCount = 0;
				AutoFillUnitExamAnswers();
				return;
			}
		}

		if (_activeUnitExam is null && TryBeginEndOfUnitExam(null))
		{
			return;
		}

		if (!_showFinalExamAnnouncement && !_isFinalExamOpen && IsAtFinalLessonBoundary())
		{
			await TryBeginFinalExamAsync();
		}
	}

	private UnitExamDefinition? FindPendingUnitExamForCurrentPosition()
	{
		if (_currentLesson is null)
		{
			return null;
		}

		var currentUnit = _orderedUnits.FirstOrDefault(unit => unit.Lessons.Any(lesson => lesson.Id == _currentLesson.Id));
		if (currentUnit is null || IsGettingStartedUnit(currentUnit))
		{
			return null;
		}

		var priorTrackedUnits = _orderedUnits
			.Where(unit => unit.OrderIndex < currentUnit.OrderIndex && !IsGettingStartedUnit(unit))
			.OrderBy(unit => unit.OrderIndex)
			.ToList();

		foreach (var unit in priorTrackedUnits)
		{
			var unitExamKey = UnitExamService.BuildUnitExamKey(unit.Id);
			if (_passedUnitExamKeys.Contains(unitExamKey))
			{
				continue;
			}

			var unitExam = _unitExamDefinitions.FirstOrDefault(item => string.Equals(item.Key, unitExamKey, StringComparison.OrdinalIgnoreCase));
			if (unitExam is not null)
			{
				return unitExam;
			}
		}

		return null;
	}

	private bool CanTriggerFinalExam()
	{
		return _finalExamEligibility?.HasPassed != true;
	}

	private void ToggleUnitExamOption(string optionKey, object? value)
	{
		if (value is bool isChecked && isChecked)
		{
			_selectedUnitExamOptionKeys.Add(optionKey);
			return;
		}

		_selectedUnitExamOptionKeys.Remove(optionKey);
	}

	private async Task SubmitUnitExamAsync()
	{
		if (_activeUnitExam is null)
		{
			return;
		}

		var selectedKeys = _selectedUnitExamOptionKeys.ToHashSet(StringComparer.OrdinalIgnoreCase);
		var correctKeys = _activeUnitExam.Options
			.Where(option => option.IsCorrect)
			.Select(option => option.Key)
			.ToHashSet(StringComparer.OrdinalIgnoreCase);

		var isPassed = selectedKeys.SetEquals(correctKeys);
		string resultMessage;

		if (_userId.HasValue)
		{
			var submitResult = await UnitExamService.SubmitUnitExamAsync(_userId.Value, CourseId, _activeUnitExam.Key, _selectedUnitExamOptionKeys.ToList());
			isPassed = submitResult.IsPassed;
			correctKeys = submitResult.CorrectOptionKeys;
			resultMessage = submitResult.Message;
		}
		else
		{
			resultMessage = isPassed
				? "Unit Exam passed."
				: "Not quite. Select every correct answer and no incorrect answers.";
		}

		_unitExamMatchedCorrectCount = selectedKeys.Intersect(correctKeys, StringComparer.OrdinalIgnoreCase).Count();
		_unitExamTotalCorrectCount = correctKeys.Count;
		_unitExamPassed = isPassed;
		_unitExamResultMessage = resultMessage;
		_showUnitExamResult = true;
		_unitExamMessage = null;
	}

	private async Task ContinueAfterUnitExamAsync(bool continueRegardless)
	{
		if (_activeUnitExam is null)
		{
			return;
		}

		if (!_unitExamPassed && !continueRegardless)
		{
			return;
		}

		if (!_unitExamPassed && continueRegardless && _userId.HasValue)
		{
			var correctOptionKeys = _activeUnitExam.Options
				.Where(option => option.IsCorrect)
				.Select(option => option.Key)
				.ToList();
			await UnitExamService.SubmitUnitExamAsync(_userId.Value, CourseId, _activeUnitExam.Key, correctOptionKeys);
		}

		var completedUnitExamKey = _activeUnitExam.Key;
		var pendingNextLessonId = _pendingUnitExamNextLessonId;
		var completesCourseBoundary = _unitExamCompletesCourse;

		_passedUnitExamKeys.Add(completedUnitExamKey);
		_activeUnitExam = null;
		_selectedUnitExamOptionKeys.Clear();
		_pendingUnitExamNextLessonId = null;
		_unitExamCompletesCourse = false;
		_showUnitExamResult = false;
		_unitExamPassed = false;
		_unitExamResultMessage = null;
		_unitExamMatchedCorrectCount = 0;
		_unitExamTotalCorrectCount = 0;

		if (pendingNextLessonId.HasValue)
		{
			await PromoteUnlockByNextAsync(_orderedLessons.First(lesson => lesson.Id == pendingNextLessonId.Value));
			NavigationManager.NavigateTo(BuildLessonUri(pendingNextLessonId.Value));
			return;
		}

		if (completesCourseBoundary && completedUnitExamKey.StartsWith("unit:", StringComparison.OrdinalIgnoreCase))
		{
			_unitExamMessage = null;
			await TryBeginFinalExamAsync(true);
		}
	}

	private void RetakeUnitExam()
	{
		_showUnitExamResult = false;
		_unitExamPassed = false;
		_unitExamResultMessage = null;
		_unitExamMatchedCorrectCount = 0;
		_unitExamTotalCorrectCount = 0;
		_unitExamMessage = null;
	}

	private void AutoFillWrongUnitExamAnswers()
	{
		_selectedUnitExamOptionKeys.Clear();

		if (_activeUnitExam is null)
		{
			return;
		}

		foreach (var option in _activeUnitExam.Options.Where(option => !option.IsCorrect))
		{
			_selectedUnitExamOptionKeys.Add(option.Key);
		}
	}

	private async Task BeginTimedCourseAsync()
	{
		if (IsTimedSessionRunning)
		{
			return;
		}

		_timedSessionStartedAtUtc = DateTime.UtcNow;
		_highestUnlockedTrackedLessonIndex = Math.Max(_highestUnlockedTrackedLessonIndex, GetHighestUnlockedTrackedLessonIndex());
		StartTimerRefresh();

		try
		{
			await JSRuntime.InvokeVoidAsync("localStorage.setItem", BuildTimedSessionStorageKey(), _timedSessionStartedAtUtc.Value.ToString("O"));
			await JSRuntime.InvokeVoidAsync("localStorage.setItem", BuildProgressUnlockStorageKey(), _highestUnlockedTrackedLessonIndex.ToString());
		}
		catch (JSException)
		{
			// Keep session in-memory if local storage is temporarily unavailable.
		}

		if (IsAtFinalLessonBoundary() && await TryBeginFinalExamAsync())
		{
			return;
		}
	}

	private async Task BeginFinalExamAsync()
	{
		await RefreshFinalExamStateAsync();
		if (_finalExam is null)
		{
			return;
		}

		_showFinalExamAnnouncement = false;
		_isFinalExamOpen = true;
		_showFinalExamResults = false;
		_finalExamElapsedText = null;
		_finalExamCorrectAnswers = 0;
		_finalExamTotalQuestions = 0;
		_finalExamScorePercent = 0m;
		_finalExamPassed = false;
		_finalExamSelectedOptions.Clear();
	}

	private bool IsFinalExamOptionSelected(Guid questionId, string option)
	{
		return _finalExamSelectedOptions.TryGetValue(questionId, out var selected) && string.Equals(selected, option, StringComparison.OrdinalIgnoreCase);
	}

	private void SelectFinalExamOption(Guid questionId, string option, object? value)
	{
		if (value is bool isChecked && !isChecked)
		{
			return;
		}

		_finalExamSelectedOptions[questionId] = option;
	}

	private async Task SubmitFinalExamAsync()
	{
		if (_finalExam is null)
		{
			return;
		}

		var elapsedText = GetElapsedTimerText();
		var answers = _finalExamSelectedOptions.ToDictionary(item => item.Key, item => item.Value);
		var correctAnswers = await ExamService.GetCorrectAnswerMapAsync(CourseId);
		_unitExamMessage = null;
		_finalExamAnswerReview.Clear();
		var correctCount = _finalExam.Questions.Count(question => answers.TryGetValue(question.Id, out var selectedOption)
			&& correctAnswers.TryGetValue(question.Id, out var correctOption)
			&& string.Equals(selectedOption, correctOption, StringComparison.OrdinalIgnoreCase));
		var totalQuestions = _finalExam.Questions.Count;

		foreach (var question in _finalExam.Questions)
		{
			answers.TryGetValue(question.Id, out var selectedOption);
			correctAnswers.TryGetValue(question.Id, out var correctOption);

			var normalizedSelected = string.IsNullOrWhiteSpace(selectedOption) ? "-" : selectedOption!.Trim().ToUpperInvariant();
			var normalizedCorrect = string.IsNullOrWhiteSpace(correctOption) ? "-" : correctOption!.Trim().ToUpperInvariant();
			var isCorrect = string.Equals(normalizedSelected, normalizedCorrect, StringComparison.OrdinalIgnoreCase);

			_finalExamAnswerReview.Add(new FinalExamAnswerReviewItem(
				question.Prompt,
				BuildExamOptionLabel(question, normalizedSelected),
				BuildExamOptionLabel(question, normalizedCorrect),
				isCorrect));
		}

		ExamAttemptSummary? attempt = null;
		if (_userId.HasValue)
		{
			attempt = await ExamService.SubmitAttemptAsync(CourseId, _userId.Value, answers);
			_finalExamEligibility = await ExamService.GetEligibilityAsync(CourseId, _userId.Value);
			// Re-run enrollment progress persistence so certificate issuance is evaluated after passing exam.
			await EnrollmentService.UpdateProgressAsync(_userId.Value, CourseId, _enrollmentProgressPercent);
			correctCount = attempt.CorrectAnswers;
			totalQuestions = attempt.TotalQuestions;
		}

		var passed = attempt?.Passed == true || (totalQuestions > 0 && correctCount == totalQuestions);
		await StopTimedCourseAsync();

		_finalExamElapsedText = elapsedText;
		_finalExamCorrectAnswers = correctCount;
		_finalExamTotalQuestions = totalQuestions;
		_finalExamScorePercent = attempt?.ScorePercent ?? (totalQuestions == 0 ? 0m : (decimal)correctCount * 100m / totalQuestions);
		_finalExamPassed = passed;
		_showFinalExamResults = true;
		_showFinalExamAnnouncement = false;
		_isFinalExamOpen = false;
	}

	private async Task RefreshFinalExamStateAsync()
	{
		if (_course is null)
		{
			return;
		}

		_finalExam = await ExamService.GetCourseExamAsync(_course.Id);
		_passedFinalExamOnFirstAttempt = false;
		_isFinalExamRetakeLimitReached = false;
		if (_userId.HasValue)
		{
			_finalExamEligibility = await ExamService.GetEligibilityAsync(_course.Id, _userId.Value);
			_hasFinalExamRetakeGrantOverride = _finalExamEligibility?.HasRetakeGrantOverride == true;
			_isFinalExamRetakeLimitReached = _finalExamEligibility is { RequiresExam: true, HasPassed: false } eligibility
				&& eligibility.AttemptsUsed >= eligibility.AttemptsAllowed;
			var examHistory = await ExamService.GetAttemptHistoryAsync(_course.Id, _userId.Value);
			_passedFinalExamOnFirstAttempt = examHistory
				.OrderBy(item => item.AttemptNumber)
				.ThenBy(item => item.SubmittedAt)
				.FirstOrDefault()?.Passed == true;
		}
	}

	private bool EnforceExamTerminalOverviewLock()
	{
		if (_finalExamEligibility?.RequiresExam != true)
		{
			return false;
		}

		var lockToOverview = (_passedFinalExamOnFirstAttempt && !_hasFinalExamRetakeGrantOverride)
			|| (_finalExamEligibility.HasPassed == false && _isFinalExamRetakeLimitReached);

		if (!lockToOverview)
		{
			return false;
		}

		NavigationManager.NavigateTo(BuildCourseOverviewUri());
		return true;
	}

	private async Task FillCorrectFinalExamAnswersAsync()
	{
		await AutoFillFinalExamAnswersAsync(preferCorrectAnswers: true);
	}

	private async Task FillWrongFinalExamAnswersAsync()
	{
		await AutoFillFinalExamAnswersAsync(preferCorrectAnswers: false);
	}

	private async Task AutoFillFinalExamAnswersAsync(bool preferCorrectAnswers)
	{
		_finalExamSelectedOptions.Clear();

		if (_finalExam is null)
		{
			return;
		}

		var correctAnswers = await ExamService.GetCorrectAnswerMapAsync(CourseId);
		foreach (var question in _finalExam.Questions)
		{
			if (correctAnswers.TryGetValue(question.Id, out var correctOption))
			{
				_finalExamSelectedOptions[question.Id] = preferCorrectAnswers
					? correctOption
					: GetAlternateOption(correctOption);
			}
		}
	}

	private static string GetAlternateOption(string correctOption)
	{
		return correctOption.ToUpperInvariant() switch
		{
			"A" => "B",
			"B" => "C",
			"C" => "D",
			_ => "A"
		};
	}

	private static string BuildExamOptionLabel(ExamQuestionView question, string option)
	{
		return option switch
		{
			"A" => $"A. {question.OptionA}",
			"B" => $"B. {question.OptionB}",
			"C" => $"C. {question.OptionC}",
			"D" => $"D. {question.OptionD}",
			_ => "No answer"
		};
	}

	private bool IsAtFinalLessonBoundary()
	{
		return _orderedLessons.Count > 0
			&& _currentLessonIndexInCourse >= _orderedLessons.Count - 1
			&& (_currentLessonPages.Count == 0 || _currentLessonPageIndex >= _currentLessonPages.Count - 1);
	}

	private async Task StopTimedCourseAsync()
	{
		if (!IsTimedSessionRunning)
		{
			return;
		}

		_timerRefresh?.Dispose();
		_timerRefresh = null;
		_timedSessionStartedAtUtc = null;

		try
		{
			await JSRuntime.InvokeVoidAsync("localStorage.removeItem", BuildTimedSessionStorageKey());
		}
		catch (JSException)
		{
			// Ignore browser storage failures when ending the timed session.
		}
	}

	private void GoToCourseOverview()
	{
		if (_finalExamPassed)
		{
			NavigationManager.NavigateTo(BuildCourseOverviewUri("Successfully Completed"));
			return;
		}

		NavigationManager.NavigateTo(BuildCourseOverviewUri());
	}

	private void GoToLearnerCertificates()
	{
		NavigationManager.NavigateTo(BuildLearnerDashboardUri());
	}

	private async Task LoadTimedSessionStateAsync()
	{
		if (_isTimerStateLoaded)
		{
			return;
		}

		try
		{
			var storedUtc = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", BuildTimedSessionStorageKey());
			if (DateTime.TryParse(storedUtc, out var parsedUtc))
			{
				_timedSessionStartedAtUtc = DateTime.SpecifyKind(parsedUtc, DateTimeKind.Utc);
				var storedUnlockIndex = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", BuildProgressUnlockStorageKey());
				if (int.TryParse(storedUnlockIndex, out var parsedUnlockIndex))
				{
					_highestUnlockedTrackedLessonIndex = Math.Max(parsedUnlockIndex, 0);
				}
				else
				{
					_highestUnlockedTrackedLessonIndex = GetHighestUnlockedTrackedLessonIndex();
				}

				StartTimerRefresh();
			}
		}
		catch (JSException)
		{
			// Continue without persisted timer state if browser storage is inaccessible.
		}
		finally
		{
			_isTimerStateLoaded = true;
		}
	}

	private string BuildTimedSessionStorageKey()
	{
		var actor = _userId?.ToString("D") ?? "anonymous";
		return $"lms:course-timer:{CourseId:D}:{actor}";
	}

	private string BuildProgressUnlockStorageKey()
	{
		var actor = _userId?.ToString("D") ?? "anonymous";
		return $"lms:course-unlock:{CourseId:D}:{actor}";
	}

	private string BuildLessonUri(Guid lessonId)
	{
		var lessonUri = $"/courses/{CourseId}/lessons/{lessonId}";
		if (!_learnerContextUserId.HasValue || !_isAdminViewer)
		{
			return lessonUri;
		}

		return $"{lessonUri}?learnerId={Uri.EscapeDataString(_learnerContextUserId.Value.ToString())}";
	}

	private string BuildCourseOverviewUri(string? finalExamResult = null)
	{
		var queryParts = new List<string>();

		if (_learnerContextUserId.HasValue && _isAdminViewer)
		{
			queryParts.Add($"learnerId={Uri.EscapeDataString(_learnerContextUserId.Value.ToString())}");
		}

		if (!string.IsNullOrWhiteSpace(finalExamResult))
		{
			queryParts.Add($"finalExamResult={Uri.EscapeDataString(finalExamResult)}");
		}

		return queryParts.Count == 0
			? $"/courses/{CourseId}"
			: $"/courses/{CourseId}?{string.Join("&", queryParts)}";
	}

	private string BuildLearnerDashboardUri()
	{
		if (_learnerContextUserId.HasValue && _isAdminViewer)
		{
			return $"/learner?learnerId={Uri.EscapeDataString(_learnerContextUserId.Value.ToString())}";
		}

		return "/learner";
	}

	private void StartTimerRefresh()
	{
		if (!IsTimedSessionRunning || _timerRefresh is not null)
		{
			return;
		}

		_timerRefresh = new Timer(_ =>
		{
			_ = InvokeAsync(StateHasChanged);
		}, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
	}

	private string GetElapsedTimerText()
	{
		if (!IsTimedSessionRunning || !_timedSessionStartedAtUtc.HasValue)
		{
			return "00:00:00";
		}

		var elapsed = DateTime.UtcNow - _timedSessionStartedAtUtc.Value;
		if (elapsed < TimeSpan.Zero)
		{
			elapsed = TimeSpan.Zero;
		}

		return $"{(int)elapsed.TotalHours:00}:{elapsed.Minutes:00}:{elapsed.Seconds:00}";
	}

	private void AutoFillUnitExamAnswers()
	{
		_selectedUnitExamOptionKeys.Clear();

		if (_activeUnitExam is null)
		{
			return;
		}

		foreach (var option in _activeUnitExam.Options.Where(option => option.IsCorrect))
		{
			_selectedUnitExamOptionKeys.Add(option.Key);
		}
	}

	private List<string> GetUnitExamCorrectOptionLabels()
	{
		if (_activeUnitExam is null)
		{
			return new List<string>();
		}

		return _activeUnitExam.Options
			.Where(option => option.IsCorrect)
			.Select(option => option.Label)
			.ToList();
	}

	private List<string> GetUnitExamWrongSelectedOptionLabels()
	{
		if (_activeUnitExam is null)
		{
			return new List<string>();
		}

		return _activeUnitExam.Options
			.Where(option => !option.IsCorrect && _selectedUnitExamOptionKeys.Contains(option.Key))
			.Select(option => option.Label)
			.ToList();
	}

	private List<string> GetUnitExamMissedCorrectOptionLabels()
	{
		if (_activeUnitExam is null)
		{
			return new List<string>();
		}

		return _activeUnitExam.Options
			.Where(option => option.IsCorrect && !_selectedUnitExamOptionKeys.Contains(option.Key))
			.Select(option => option.Label)
			.ToList();
	}

	private sealed record FinalExamAnswerReviewItem(
		string Prompt,
		string SelectedOptionLabel,
		string CorrectOptionLabel,
		bool IsCorrect);

	private async Task RefreshLessonStateAsync()
	{
		if (!_userId.HasValue || _course is null)
		{
			return;
		}

		var enrollment = await EnrollmentService.GetEnrollmentAsync(_userId.Value, _course.Id);
		_enrollmentProgressPercent = enrollment?.ProgressPercent ?? 0;
		_lessonCompletion = await EnrollmentService.GetLessonCompletionMapAsync(_userId.Value, _course.Id);
		ResolveCurrentLesson();
	}

	public void Dispose()
	{
		_timerRefresh?.Dispose();
	}
}
