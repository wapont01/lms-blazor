@page "/instructor"
@attribute [Authorize(Roles = "Admin,Instructor")]
@using Lms.Application.Services
@using Lms.Domain.Entities
@inject ICourseService CourseService

<PageTitle>Instructor</PageTitle>

<h1>Instructor Dashboard</h1>

<div class="dashboard-grid">
	<section class="card">
		<h2>Editable courses</h2>

		@if (_courses.Count == 0)
		{
			<p>No courses are available to edit.</p>
		}
		else
		{
			<div class="course-list">
				@foreach (var course in _courses)
				{
					<article class="course-item">
						<div>
							<h3>@course.Title</h3>
							<p>@course.Level | @(course.IsPublished ? "Published" : "Draft")</p>
							<p>@course.Description</p>
						</div>
						<button type="button" @onclick="() => BeginEditing(course)">Edit</button>
					</article>
				}
			</div>
		}
	</section>

	<section class="card">
		<h2>Edit course</h2>

		@if (_editingCourse is null)
		{
			<p>Select a course to edit its content and status.</p>
		}
		else
		{
			<EditForm Model="_editingCourse" OnValidSubmit="SaveCourseAsync">
				<DataAnnotationsValidator />
				<ValidationSummary />

				<div class="form-field">
					<label>Title</label>
					<InputText @bind-Value="_editingCourse.Title" />
					<ValidationMessage For="() => _editingCourse.Title" />
				</div>
				<div class="form-field">
					<label>Description</label>
					<InputTextArea @bind-Value="_editingCourse.Description" />
				</div>
				<div class="form-field">
					<label>Level</label>
					<InputText @bind-Value="_editingCourse.Level" />
					<ValidationMessage For="() => _editingCourse.Level" />
				</div>
				<div class="form-row">
					<div class="form-field">
						<label>Duration Hours</label>
						<InputNumber @bind-Value="_editingCourse.DurationHours" />
						<ValidationMessage For="() => _editingCourse.DurationHours" />
					</div>
					<div class="form-field">
						<label>Credit Hours</label>
						<InputNumber @bind-Value="_editingCourse.CreditHours" />
						<ValidationMessage For="() => _editingCourse.CreditHours" />
					</div>
				</div>
				<div class="form-field">
					<label>Jurisdiction</label>
					<InputText @bind-Value="_editingCourse.Jurisdiction" />
				</div>
				<div class="form-row">
					<div class="form-field">
						<label>Price</label>
						<InputNumber @bind-Value="_editingCourse.Price" />
						<ValidationMessage For="() => _editingCourse.Price" />
					</div>
					<div class="form-field checkbox-field">
						<label>
							<InputCheckbox @bind-Value="_editingCourse.IsPublished" />
							Published
						</label>
					</div>
				</div>
				<div class="form-row">
					<div class="form-field checkbox-field">
						<label>
							<InputCheckbox @bind-Value="_editingCourse.IsArchived" />
							Archived
						</label>
					</div>
				</div>
				<div class="course-actions">
					<button type="submit">Save changes</button>
					<button type="button" @onclick="ClearSelection">Cancel</button>
				</div>
			</EditForm>
		}
	</section>

	<section class="card">
		<h2>Units</h2>

		@if (_editingCourse is null)
		{
			<p>Select a course to manage its units.</p>
		}
		else
		{
			<div class="form-field">
				<label>New unit title</label>
				<InputText @bind-Value="_newUnitTitle" />
			</div>
			<button type="button" @onclick="AddUnitAsync">Add unit</button>

			@if (_editingCourse.Units.Count == 0)
			{
				<p class="muted-text">No units yet.</p>
			}
			else
			{
				<div class="course-list">
					@foreach (var unit in _editingCourse.Units.OrderBy(unit => unit.OrderIndex))
					{
						<article class="course-item">
							<div>
								<h3>@unit.OrderIndex. @unit.Title</h3>
								<p>@unit.Lessons.Count lessons</p>
							</div>
							<button type="button" @onclick="() => BeginEditingUnit(unit)">Edit unit</button>
						</article>
					}
				</div>
			}

			@if (_editingUnit is not null)
			{
				<hr />
				<h3>Edit unit</h3>
				<EditForm Model="_editingUnit" OnValidSubmit="SaveUnitAsync">
					<DataAnnotationsValidator />
					<ValidationSummary />
					<div class="form-field">
						<label>Title</label>
						<InputText @bind-Value="_editingUnit.Title" />
					</div>
					<div class="course-actions">
						<button type="submit">Save unit</button>
						<button type="button" @onclick="ClearUnitSelection">Cancel</button>
					</div>
				</EditForm>
			}
		}
	</section>

	<section class="card">
		<h2>Lessons</h2>

		@if (_editingUnit is null)
		{
			<p>Select a unit to manage its lessons.</p>
		}
		else
		{
			<div class="form-field">
				<label>New lesson title</label>
				<InputText @bind-Value="_newLessonTitle" />
			</div>
			<div class="form-field">
				<label>Lesson content</label>
				<InputTextArea @bind-Value="_newLessonText" />
			</div>
			<div class="form-row">
				<div class="form-field">
					<label>Duration Minutes</label>
					<InputNumber @bind-Value="_newLessonDurationMinutes" />
				</div>
				<div class="form-field checkbox-field">
					<label>
						<InputCheckbox @bind-Value="_newLessonRequired" />
						Required
					</label>
				</div>
			</div>
			<button type="button" @onclick="AddLessonAsync">Add lesson</button>

			@if (_editingUnit.Lessons.Count == 0)
			{
				<p class="muted-text">No lessons yet.</p>
			}
			else
			{
				<div class="course-list">
					@foreach (var lesson in _editingUnit.Lessons.OrderBy(lesson => lesson.OrderIndex))
					{
						<article class="course-item">
							<div>
								<h3>@lesson.OrderIndex. @lesson.Title</h3>
								<p>@lesson.DurationMinutes minutes | @(lesson.IsRequired ? "Required" : "Optional")</p>
								<p>@lesson.TextContent</p>
							</div>
							<button type="button" @onclick="() => BeginEditingLesson(lesson)">Edit lesson</button>
						</article>
					}
				</div>
			}

			@if (_editingLesson is not null)
			{
				<hr />
				<h3>Edit lesson</h3>
				<EditForm Model="_editingLesson" OnValidSubmit="SaveLessonAsync">
					<DataAnnotationsValidator />
					<ValidationSummary />
					<div class="form-field">
						<label>Title</label>
						<InputText @bind-Value="_editingLesson.Title" />
					</div>
					<div class="form-field">
						<label>Lesson content</label>
						<InputTextArea @bind-Value="_editingLesson.TextContent" />
					</div>
					<div class="form-field">
						<label>Duration Minutes</label>
						<InputNumber @bind-Value="_editingLesson.DurationMinutes" />
					</div>
					<div class="form-row">
						<div class="form-field checkbox-field">
							<label>
								<InputCheckbox @bind-Value="_editingLesson.IsRequired" />
								Required
							</label>
						</div>
					</div>
					<div class="course-actions">
						<button type="submit">Save lesson</button>
						<button type="button" @onclick="ClearLessonSelection">Cancel</button>
					</div>
				</EditForm>
			}
		}
	</section>
</div>

@code {
	private List<Course> _courses = new();
	private Course? _editingCourse;
	private Unit? _editingUnit;
	private Lesson? _editingLesson;
	private string _newUnitTitle = string.Empty;
	private string _newLessonTitle = string.Empty;
	private string? _newLessonText;
	private int _newLessonDurationMinutes;
	private bool _newLessonRequired = true;

	protected override async Task OnInitializedAsync()
	{
		await RefreshCoursesAsync();
	}

	private void BeginEditing(Course course)
	{
		_editingCourse = CloneCourse(course);
		ClearUnitSelection();
		ClearLessonSelection();
	}

	private async Task SaveCourseAsync()
	{
		if (_editingCourse is null)
		{
			return;
		}

		var editedCourseId = _editingCourse.Id;

		if (_editingCourse.IsArchived)
		{
			_editingCourse.IsPublished = false;
		}

		await CourseService.UpdateAsync(_editingCourse);
		await RefreshCoursesAsync();

		var refreshedCourse = _courses.FirstOrDefault(course => course.Id == editedCourseId);
		_editingCourse = refreshedCourse is null ? null : CloneCourse(refreshedCourse);
	}

	private void ClearSelection()
	{
		_editingCourse = null;
		ClearUnitSelection();
		ClearLessonSelection();
	}

	private async Task RefreshCoursesAsync()
	{
		_courses = await CourseService.GetAllAsync();

		if (_editingCourse is not null)
		{
			var refreshedCourse = _courses.FirstOrDefault(course => course.Id == _editingCourse.Id);
			_editingCourse = refreshedCourse is null ? null : CloneCourse(refreshedCourse);
		}
	}

	private async Task AddUnitAsync()
	{
		if (_editingCourse is null || string.IsNullOrWhiteSpace(_newUnitTitle))
		{
			return;
		}

		await CourseService.AddUnitAsync(_editingCourse.Id, new Unit
		{
			Title = _newUnitTitle.Trim()
		});

		_newUnitTitle = string.Empty;
		await ReloadSelectedCourseAsync();
	}

	private void BeginEditingUnit(Unit unit)
	{
		_editingUnit = CloneUnit(unit);
		ClearLessonSelection();
	}

	private async Task SaveUnitAsync()
	{
		if (_editingUnit is null)
		{
			return;
		}

		await CourseService.UpdateUnitAsync(_editingUnit);
		await ReloadSelectedCourseAsync();
		BeginEditingUnit(_editingCourse!.Units.First(unit => unit.Id == _editingUnit.Id));
	}

	private void ClearUnitSelection()
	{
		_editingUnit = null;
		_newUnitTitle = string.Empty;
	}

	private async Task AddLessonAsync()
	{
		if (_editingUnit is null || string.IsNullOrWhiteSpace(_newLessonTitle))
		{
			return;
		}

		await CourseService.AddLessonAsync(_editingUnit.Id, new Lesson
		{
			Title = _newLessonTitle.Trim(),
			TextContent = _newLessonText,
			DurationMinutes = _newLessonDurationMinutes,
			IsRequired = _newLessonRequired
		});

		_newLessonTitle = string.Empty;
		_newLessonText = string.Empty;
		_newLessonDurationMinutes = 0;
		_newLessonRequired = true;
		await ReloadSelectedCourseAsync();
		if (_editingCourse is not null)
		{
			var refreshedUnit = _editingCourse.Units.FirstOrDefault(unit => unit.Id == _editingUnit.Id);
			_editingUnit = refreshedUnit is null ? null : CloneUnit(refreshedUnit);
		}
	}

	private void BeginEditingLesson(Lesson lesson)
	{
		_editingLesson = CloneLesson(lesson);
	}

	private async Task SaveLessonAsync()
	{
		if (_editingLesson is null)
		{
			return;
		}

		await CourseService.UpdateLessonAsync(_editingLesson);
		await ReloadSelectedCourseAsync();
		if (_editingUnit is not null)
		{
			var refreshedUnit = _editingCourse?.Units.FirstOrDefault(unit => unit.Id == _editingUnit.Id);
			_editingUnit = refreshedUnit is null ? null : CloneUnit(refreshedUnit);
		}
		if (_editingUnit is not null)
		{
			var refreshedLesson = _editingUnit.Lessons.FirstOrDefault(lesson => lesson.Id == _editingLesson.Id);
			_editingLesson = refreshedLesson is null ? null : CloneLesson(refreshedLesson);
		}
	}

	private void ClearLessonSelection()
	{
		_editingLesson = null;
		_newLessonTitle = string.Empty;
		_newLessonText = string.Empty;
		_newLessonDurationMinutes = 0;
		_newLessonRequired = true;
	}

	private async Task ReloadSelectedCourseAsync()
	{
		if (_editingCourse is null)
		{
			return;
		}

		var refreshedCourse = await CourseService.GetByIdAsync(_editingCourse.Id);
		_editingCourse = refreshedCourse is null ? null : CloneCourse(refreshedCourse);
	}

	private static Course CloneCourse(Course course)
	{
		return new Course
		{
			Id = course.Id,
			Title = course.Title,
			Slug = course.Slug,
			Description = course.Description,
			Level = course.Level,
			DurationHours = course.DurationHours,
			CreditHours = course.CreditHours,
			Jurisdiction = course.Jurisdiction,
			Price = course.Price,
			IsPublished = course.IsPublished,
			IsArchived = course.IsArchived,
			CreatedAt = course.CreatedAt,
			UpdatedAt = course.UpdatedAt,
			Units = course.Units
				.OrderBy(unit => unit.OrderIndex)
				.Select(CloneUnit)
				.ToList()
		};
	}

	private static Unit CloneUnit(Unit unit)
	{
		return new Unit
		{
			Id = unit.Id,
			CourseId = unit.CourseId,
			Title = unit.Title,
			OrderIndex = unit.OrderIndex,
			Lessons = unit.Lessons
				.OrderBy(lesson => lesson.OrderIndex)
				.Select(CloneLesson)
				.ToList()
		};
	}

	private static Lesson CloneLesson(Lesson lesson)
	{
		return new Lesson
		{
			Id = lesson.Id,
			UnitId = lesson.UnitId,
			Title = lesson.Title,
			ContentType = lesson.ContentType,
			ContentUrl = lesson.ContentUrl,
			TextContent = lesson.TextContent,
			DurationMinutes = lesson.DurationMinutes,
			OrderIndex = lesson.OrderIndex,
			IsRequired = lesson.IsRequired
		};
	}
}
